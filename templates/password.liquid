<div class="yk-page-width yk-section yk-center">
  <h1>{{ shop.name }}</h1>
  <p>{{ 'general.password_page.opening_soon' | t: default: 'Opening soon.' }}</p>
  {%- form 'storefront_password' -%}
    <div class="yk-buy-row" style="justify-content:center;margin-top:24px">
      <input class="yk-field" type="password" name="password" style="max-width:280px"
             placeholder="{{ 'general.password_page.password_placeholder' | t: default: 'Password' }}">
      <button type="submit" class="yk-btn">{{ 'general.password_page.login_form_submit' | t: default: 'Enter' }}</button>
    </div>
    {{ form.errors | default_errors }}
  {%- endform -%}
</div>
