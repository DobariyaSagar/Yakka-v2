{%- comment -%}
  Crawl directives. Shopify's defaults are kept, with the theme's own thin and
  duplicate paths added, plus the sitemap Shopify generates.
{%- endcomment -%}
{% for group in robots.default_groups %}
{{- group.user_agent }}

{% for rule in group.rules %}{{ rule }}
{% endfor -%}

{%- comment -%} theme additions {%- endcomment -%}
Disallow: /*?q=*
Disallow: /*?filter*
Disallow: /*?sort_by*
Disallow: /*&sort_by*
Disallow: /*?variant=*

{%- if group.sitemap != blank %}
{{ group.sitemap }}
{% endif -%}
{% endfor %}
