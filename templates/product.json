{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "thumbnails_per_row": 5,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "custom_testimonials": {
      "type": "custom-testimonials",
      "blocks": {
        "testimonial_1": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "My partner used to wake me up every morning without meaning to. Now I don't even hear him get up.",
            "author": "Isabella T.",
            "label": "Verified buyer"
          }
        },
        "testimonial_2": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "I track my steps all day and it still wakes me up better than my phone ever did.",
            "author": "Dave M.",
            "label": "Verified buyer"
          }
        },
        "testimonial_3": {
          "type": "testimonial",
          "settings": {
            "rating": 5,
            "text": "Simple to set up, no app, and the battery has lasted weeks so far.",
            "author": "Lily S.",
            "label": "Verified buyer"
          }
        }
      },
      "block_order": [
        "testimonial_1",
        "testimonial_2",
        "testimonial_3"
      ],
      "settings": {
        "eyebrow": "REAL MORNINGS, REAL FEEDBACK",
        "heading": "Trusted by early risers and light sleepers alike"
      }
    },
    "custom_guarantee": {
      "type": "custom-guarantee",
      "settings": {
        "heading": "60-Day Money-Back Guarantee",
        "text": "If the Tuckerbox doesn't change your lunch game within 60 days, send it back for a full refund — no questions asked. Every unit is pressure-tested and inspected before it ships."
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products",
    "custom_testimonials",
    "custom_guarantee"
  ]
}
