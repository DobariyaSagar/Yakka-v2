<div class="yk-page-width yk-section yk-center">
  <span class="yk-eyebrow">{{ 'general.404.title' | t: default: 'Error 404' }}</span>
  <h1 style="margin:16px auto 18px">{{ 'general.404.heading' | t: default: 'Page not found' }}</h1>
  <p>{{ 'general.404.subtext' | t: default: 'The page you were after has moved or never existed.' }}</p>
  <p style="margin-top:28px">
    <a class="yk-btn" href="{{ routes.root_url }}">{{ 'general.404.link' | t: default: 'Back to home' }}</a>
  </p>
</div>
