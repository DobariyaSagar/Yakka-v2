<article class="yk-page-width yk-section" style="max-width:820px">
  <span class="yk-eyebrow">{{ article.published_at | date: '%d %B %Y' }}</span>
  <h1 style="margin-top:14px">{{ article.title }}</h1>
  {%- if article.image -%}
    {{ article.image | image_url: width: 1200 | image_tag:
         widths: '600,900,1200', sizes: '(max-width: 920px) 92vw, 820px',
         alt: article.title, loading: 'lazy',
              decoding: 'async',
         style: 'width:100%;border-radius:18px;margin:28px 0' }}
  {%- endif -%}
  <div class="yk-rte">{{ article.content }}</div>
</article>
