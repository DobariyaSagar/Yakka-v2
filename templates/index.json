    "feature": {
      "type": "feature-banner",
      "settings": {
        "eyebrow": "The Tuckerbox™",
        "heading": "Say goodbye to cold sandwiches and site microwave queues.",
        "text": "<p>Pack it the night before. Press start an hour out from smoko. Sealed, leak-proof and rugged enough to live in the toolbox — it heats your own food properly, instead of keeping someone else's lukewarm.</p>",
        "padding_top": 150,
        "padding_bottom": 0
      }
    },
    "steps": {
      "type": "how-it-works",
      "blocks": {
        "st1": {
          "type": "step",
          "settings": {
            "tag": "Night before",
            "title": "Charge it",
            "text": "Plug it in on the bench with the USB-C cable. Full charge holds two to three heat cycles."
          }
        },
        "st2": {
          "type": "step",
          "settings": {
            "tag": "Morning",
            "title": "Pack your feed",
            "text": "Last night's dinner, a curry, a pasta — straight into the stainless container. 1.5L, a proper serve."
          }
        },
        "st3": {
          "type": "step",
          "settings": {
            "tag": "On site",
            "title": "Press start",
            "text": "Hit it 45 minutes out, or set the timer at seven and forget about it until the whistle."
          }
        },
        "st4": {
          "type": "step",
          "settings": {
            "tag": "Smoko",
            "title": "Eat properly",
            "text": "Open it up to a steaming, evenly heated meal. No queue, no servo pie, no cold roll."
          }
        }
      },
