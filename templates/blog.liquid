<div class="yk-page-width yk-section">
  <h1>{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
  <div class="yk-reviews" style="margin-top:40px">
    {%- for article in blog.articles -%}
      <article class="yk-review">
        {%- if article.image -%}
          <div class="yk-review__media">
            {{ article.image | image_url: width: 800 | image_tag:
                 class: 'yk-review__image', widths: '400,800',
                 sizes: '(max-width: 920px) 92vw, 33vw', alt: article.title, loading: 'lazy',
              decoding: 'async' }}
          </div>
        {%- endif -%}
        <div class="yk-review__body">
          <h3 style="margin-bottom:10px"><a href="{{ article.url }}">{{ article.title }}</a></h3>
          <p class="yk-kit__text">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
        </div>
      </article>
    {%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<div style="margin-top:32px">{{ paginate | default_pagination }}</div>{%- endif -%}
  {%- endpaginate -%}
</div>
