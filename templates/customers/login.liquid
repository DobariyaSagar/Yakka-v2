<div class="yk-page-width yk-section" style="max-width:520px">
  <h1>{{ 'customer.login_page.title' | t: default: 'Log in' }}</h1>
  {%- form 'customer_login' -%}
    {{ form.errors | default_errors }}
    <input class="yk-field" type="email" name="customer[email]" autocomplete="email"
           placeholder="{{ 'customer.login_page.email' | t: default: 'Email' }}" style="margin-top:18px">
    <input class="yk-field" type="password" name="customer[password]" autocomplete="current-password"
           placeholder="{{ 'customer.login_page.password' | t: default: 'Password' }}" style="margin-top:12px">
    <button type="submit" class="yk-btn yk-btn--full" style="margin-top:18px">
      {{ 'customer.login_page.sign_in' | t: default: 'Sign in' }}
    </button>
  {%- endform -%}
  <p style="margin-top:18px">
    <a href="{{ routes.account_register_url }}">{{ 'customer.login_page.create_account' | t: default: 'Create account' }}</a>
  </p>
</div>
