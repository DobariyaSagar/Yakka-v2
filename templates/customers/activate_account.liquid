<div class="yk-page-width yk-section" style="max-width:520px">
  <h1>{{ 'customer.activate_account.title' | t: default: 'Activate account' }}</h1>
  {%- form 'activate_customer_password' -%}
    {{ form.errors | default_errors }}
    <input class="yk-field" type="password" name="customer[password]" autocomplete="new-password"
           placeholder="{{ 'customer.activate_account.password' | t: default: 'Password' }}" style="margin-top:18px">
    <input class="yk-field" type="password" name="customer[password_confirmation]" autocomplete="new-password"
           placeholder="{{ 'customer.activate_account.password_confirm' | t: default: 'Confirm password' }}" style="margin-top:12px">
    <div class="yk-buy-row" style="margin-top:18px">
      <button type="submit" class="yk-btn">{{ 'customer.activate_account.submit' | t: default: 'Activate' }}</button>
      <button type="submit" name="decline" class="yk-btn yk-btn--ghost">{{ 'customer.activate_account.cancel' | t: default: 'Decline' }}</button>
    </div>
  {%- endform -%}
</div>
