<div class="yk-page-width yk-section" style="max-width:520px">
  <h1>{{ 'customer.register.title' | t: default: 'Create account' }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <input class="yk-field" type="text" name="customer[first_name]" placeholder="{{ 'customer.register.first_name' | t: default: 'First name' }}" style="margin-top:18px">
    <input class="yk-field" type="text" name="customer[last_name]" placeholder="{{ 'customer.register.last_name' | t: default: 'Last name' }}" style="margin-top:12px">
    <input class="yk-field" type="email" name="customer[email]" autocomplete="email" placeholder="{{ 'customer.register.email' | t: default: 'Email' }}" style="margin-top:12px">
    <input class="yk-field" type="password" name="customer[password]" autocomplete="new-password" placeholder="{{ 'customer.register.password' | t: default: 'Password' }}" style="margin-top:12px">
    <button type="submit" class="yk-btn yk-btn--full" style="margin-top:18px">
      {{ 'customer.register.submit' | t: default: 'Create' }}
    </button>
  {%- endform -%}
</div>
