<div class="yk-page-width yk-section">
  <h1>{{ 'customer.account.title' | t: default: 'Account' }}</h1>
  <p style="margin-top:8px">{{ customer.name }} · <a href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t: default: 'Log out' }}</a></p>

  <h2 style="margin-top:40px;font-size:28px">{{ 'customer.orders.title' | t: default: 'Order history' }}</h2>
  {%- paginate customer.orders by 20 -%}
    <ul class="yk-specs" style="margin-top:18px">
      {%- for order in customer.orders -%}
        <li class="yk-specs__row">
          <span class="yk-specs__label"><a href="{{ order.customer_url }}">{{ order.name }}</a> · {{ order.created_at | date: '%d %b %Y' }}</span>
          <span class="yk-specs__value">{% render 'yk-price', price: order.total_price %} · {{ order.fulfillment_status_label }}</span>
        </li>
      {%- else -%}
        <li class="yk-specs__row">{{ 'customer.orders.none' | t: default: 'No orders yet.' }}</li>
      {%- endfor -%}
    </ul>
    {%- if paginate.pages > 1 -%}{{ paginate | default_pagination }}{%- endif -%}
  {%- endpaginate -%}

  <p style="margin-top:28px">
    <a class="yk-btn yk-btn--ghost" href="{{ routes.account_addresses_url }}">
      {{ 'customer.addresses.title' | t: default: 'Addresses' }}
    </a>
  </p>
</div>
