<div class="yk-page-width yk-section" style="max-width:520px">
  <h1>{{ 'customer.reset_password.title' | t: default: 'Reset password' }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <input class="yk-field" type="password" name="customer[password]" autocomplete="new-password"
           placeholder="{{ 'customer.reset_password.password' | t: default: 'New password' }}" style="margin-top:18px">
    <input class="yk-field" type="password" name="customer[password_confirmation]" autocomplete="new-password"
           placeholder="{{ 'customer.reset_password.password_confirm' | t: default: 'Confirm password' }}" style="margin-top:12px">
    <button type="submit" class="yk-btn yk-btn--full" style="margin-top:18px">
      {{ 'customer.reset_password.submit' | t: default: 'Reset password' }}
    </button>
  {%- endform -%}
</div>
