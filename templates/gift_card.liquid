<div class="yk-page-width yk-section yk-center">
  <span class="yk-eyebrow">{{ shop.name }}</span>
  <h1 style="margin:16px auto 12px">{{ 'gift_cards.issued.title' | t: default: 'Your gift card' }}</h1>
  <div class="yk-price" style="justify-content:center">
    <span class="yk-price__current">{% render 'yk-price', price: gift_card.balance %}</span>
  </div>
  <p>{{ gift_card.code | format_code }}</p>
  {%- if gift_card.qr_identifier -%}
    <img src="{{ gift_card | img_url: 'medium' }}" alt="" style="margin:24px auto">
  {%- endif -%}
  <p style="margin-top:24px">
    <a class="yk-btn" href="{{ shop.url }}">{{ 'gift_cards.issued.shop_link' | t: default: 'Start shopping' }}</a>
  </p>
</div>
