<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  {%- comment -%} Browser UI colour = the default scheme's button colour {%- endcomment -%}
  {%- assign default_scheme = settings.color_schemes | first -%}
  <meta name="theme-color" content="{{ default_scheme.settings.button | default: '#E8500F' }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
  {%- endif -%}

  <title>
    {{ page_title }}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  {% render 'meta-tags' %}
  {% render 'structured-data' %}

  {%- comment -%} ── Fonts ────────────────────────────────────────────────
       The theme's own faces come from Google Fonts. Turning off
       "Use the theme serif/sans" in Typography swaps in a Shopify font.
  {%- endcomment -%}
  {%- if settings.type_header_use_theme_font or settings.type_body_use_theme_font -%}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap"
          media="print" onload="this.media='all'">
    <noscript>
      <link rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap">
    </noscript>
  {%- endif -%}

  {%- unless settings.type_header_use_theme_font -%}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {{ settings.type_header_font | font_modify: 'weight', 'bolder' | font_face: font_display: 'swap' }}
  {%- endunless -%}
  {%- unless settings.type_body_use_theme_font -%}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {{ settings.type_body_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {%- endunless -%}

  {%- comment -%} Only the shared base. Each section loads its own stylesheet. {%- endcomment -%}
  <link rel="preload" as="style" href="{{ 'base.css' | asset_url }}">
  <link rel="stylesheet" href="{{ 'base.css' | asset_url }}">

  {%- comment -%} ── Theme settings → CSS custom properties ───────────────
       Colour schemes first (Dawn-style: one class per scheme, the default
       scheme also applies to :root), then the global style tokens.
  {%- endcomment -%}
  {% style %}
    {%- for scheme in settings.color_schemes -%}
      {%- assign c = scheme.settings -%}
      {% if forloop.first %}:root,{% endif %}.yk-color-{{ scheme.id }}{
        --yk-canvas: {{ c.background }};
        --yk-surface: {{ c.card }};
        --yk-contrast: {{ c.heading }};
        --yk-text: {{ c.heading }};
        --yk-text-2: {{ c.text }};
        --yk-text-3: {{ c.text }};
        --yk-border: {{ c.border }};
        --yk-accent: {{ c.button }};
        --yk-shadow-color: {{ c.shadow }};

        --yk-scheme-bg: {% if c.background_gradient != blank %}{{ c.background_gradient }}{% else %}{{ c.background }}{% endif %};
        --yk-scheme-heading: {{ c.heading }};
        --yk-scheme-text: {{ c.text }};
        --yk-scheme-border: {{ c.border }};
        --yk-scheme-card: {{ c.card }};
        --yk-scheme-button: {{ c.button }};
        --yk-scheme-button-label: {{ c.button_label }};
        --yk-scheme-button-secondary: {{ c.secondary_button_label }};
      }
    {%- endfor -%}

    :root{
      /* typography */
      {%- unless settings.type_header_use_theme_font %}
        --yk-font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      {%- endunless %}
      {%- unless settings.type_body_use_theme_font %}
        --yk-font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      {%- endunless %}
      --yk-fs-body: {{ settings.body_font_size }}px;
      --yk-heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};

      /* layout */
      --yk-page-width: {{ settings.page_width }}px;
      --yk-gutter: {{ settings.page_gutter }}px;
      --yk-section-spacing: {{ settings.spacing_sections }}px;
      --yk-grid-gap-x: {{ settings.spacing_grid_horizontal }}px;
      --yk-grid-gap-y: {{ settings.spacing_grid_vertical }}px;

      /* buttons */
      --yk-btn-radius: {{ settings.buttons_radius }}px;
      --yk-btn-border: {{ settings.buttons_border_thickness }}px;
      --yk-btn-height: {{ settings.buttons_height }}px;
      --yk-btn-shadow-opacity: {{ settings.buttons_shadow_opacity | divided_by: 100.0 }};

      /* inputs */
      --yk-field-radius: {{ settings.inputs_radius }}px;
      --yk-field-border: {{ settings.inputs_border_thickness }}px;
      --yk-field-height: {{ settings.inputs_height }}px;

      /* cards, badges, media */
      --yk-card-radius: {{ settings.card_corner_radius }}px;
      --yk-card-border: {{ settings.card_border_thickness }}px;
      --yk-card-shadow-opacity: {{ settings.card_shadow_opacity | divided_by: 100.0 }};
      --yk-badge-radius: {{ settings.badge_corner_radius }}px;
      --yk-media-radius: {{ settings.media_radius }}px;
      --yk-media-shadow-opacity: {{ settings.media_shadow_opacity | divided_by: 100.0 }};
    }
  {% endstyle %}

  {%- if settings.animations_reveal_on_scroll -%}
    <script src="{{ 'yk-animations.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>

  {{ content_for_header }}
</head>

<body
  class="template-{{ request.page_type | handle }} yk-hover-{{ settings.animations_hover_elements }}{% if settings.animations_reveal_on_scroll %} yk-reveal-enabled{% endif %}"
>
  <a class="yk-skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <ul hidden>
    <li id="a11y-refresh-page-message">{{ 'accessibility.refresh_page' | t }}</li>
  </ul>
</body>
</html>
