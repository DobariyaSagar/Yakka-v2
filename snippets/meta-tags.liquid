{%- comment -%}
  SEO head tags: description, robots, canonical alternates, Open Graph, Twitter.
  Shopify already outputs the canonical link in layout/theme.liquid.
  Structured data lives in snippets/structured-data.liquid.
{%- endcomment -%}

{%- comment -%} ── description ─────────────────────────────────────────── {%- endcomment -%}
{%- liquid
  if page_description != blank
    assign meta_description = page_description
  elsif request.page_type == 'product' and product.description != blank
    assign meta_description = product.description | strip_html | truncate: 155
  elsif request.page_type == 'collection' and collection.description != blank
    assign meta_description = collection.description | strip_html | truncate: 155
  elsif request.page_type == 'article' and article.excerpt_or_content != blank
    assign meta_description = article.excerpt_or_content | strip_html | truncate: 155
  elsif shop.description != blank
    assign meta_description = shop.description
  endif
-%}
{%- if meta_description != blank -%}
  <meta name="description" content="{{ meta_description | escape }}">
{%- endif -%}

{%- comment -%} ── robots ──────────────────────────────────────────────────
     Keep thin, duplicate and filtered pages out of the index.
{%- endcomment -%}
{%- liquid
  assign no_index = false
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == '404'
    assign no_index = true
  endif
  if request.page_type == 'customers/login' or request.page_type == 'customers/register' or request.page_type == 'customers/account' or request.page_type == 'customers/order' or request.page_type == 'customers/addresses' or request.page_type == 'customers/reset_password' or request.page_type == 'customers/activate_account'
    assign no_index = true
  endif
-%}
{%- if no_index -%}
  <meta name="robots" content="noindex, follow">
{%- else -%}
  <meta name="robots" content="index, follow, max-image-preview:large">
{%- endif -%}

{%- comment -%} ── paginated series ───────────────────────────────────── {%- endcomment -%}
{%- if paginate.previous.is_link -%}
  <link rel="prev" href="{{ paginate.previous.url }}">
{%- endif -%}
{%- if paginate.next.is_link -%}
  <link rel="next" href="{{ paginate.next.url }}">
{%- endif -%}

{%- comment -%} ── hreflang for every published locale ────────────────── {%- endcomment -%}
{%- if localization.available_languages.size > 1 -%}
  {%- for language in localization.available_languages -%}
    <link
      rel="alternate"
      hreflang="{{ language.iso_code }}"
      href="{{ canonical_url | replace: request.origin, '' | prepend: request.origin | replace: request.locale.root_url, language.root_url }}"
    >
  {%- endfor -%}
{%- endif -%}

{%- comment -%} ── Open Graph ──────────────────────────────────────────── {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">
{%- if meta_description != blank -%}
  <meta property="og:description" content="{{ meta_description | escape }}">
{%- endif -%}

{%- liquid
  case request.page_type
    when 'product'
      assign og_type = 'product'
    when 'article'
      assign og_type = 'article'
    else
      assign og_type = 'website'
  endcase
-%}
<meta property="og:type" content="{{ og_type }}">

{%- liquid
  if request.page_type == 'product' and product.featured_media
    assign og_image = product.featured_media.preview_image
  elsif request.page_type == 'article' and article.image
    assign og_image = article.image
  elsif request.page_type == 'collection' and collection.image
    assign og_image = collection.image
  elsif settings.brand_image != blank
    assign og_image = settings.brand_image
  endif
-%}
{%- if og_image -%}
  <meta property="og:image" content="http:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  {%- if og_image.alt != blank -%}
    <meta property="og:image:alt" content="{{ og_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}

{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' }}">
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} ── Twitter ─────────────────────────────────────────────── {%- endcomment -%}
<meta name="twitter:card" content="{% if og_image %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ page_title | default: shop.name | escape }}">
{%- if meta_description != blank -%}
  <meta name="twitter:description" content="{{ meta_description | escape }}">
{%- endif -%}
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
