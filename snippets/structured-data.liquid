{%- comment -%}
  JSON-LD structured data, one graph per page type. Rendered once from
  layout/theme.liquid, so no section can duplicate or contradict it.

  Emitted:
    every page   Organization + WebSite (with SearchAction)
    product      Product + Offer (+ BreadcrumbList)
    collection   CollectionPage + BreadcrumbList
    article      BlogPosting + BreadcrumbList
    page         WebPage
{%- endcomment -%}

{%- liquid
  assign brand_name = settings.brand_headline | default: shop.name | strip_html
  if settings.brand_image != blank
    assign brand_logo = settings.brand_image | image_url: width: 500
  endif
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ brand_name | json }},
  "url": {{ shop.url | json }}
  {%- if brand_logo %},
  "logo": {{ brand_logo | prepend: 'https:' | json }}
  {%- endif -%}
  {%- if settings.brand_description != blank %},
  "description": {{ settings.brand_description | strip_html | json }}
  {%- endif -%}
  {%- comment -%} sameAs — built with a delimiter so no trailing comma can slip in {%- endcomment -%}
  {%- capture social_raw -%}
    {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link }}|{%- endif -%}
    {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link }}|{%- endif -%}
    {%- if settings.social_tiktok_link != blank -%}{{ settings.social_tiktok_link }}|{%- endif -%}
    {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link }}|{%- endif -%}
    {%- if settings.social_x_link != blank -%}{{ settings.social_x_link }}|{%- endif -%}
    {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link }}|{%- endif -%}
    {%- if settings.social_linkedin_link != blank -%}{{ settings.social_linkedin_link }}{%- endif -%}
  {%- endcapture -%}
  {%- assign social_profiles = social_raw | strip | split: '|' -%}
  {%- if social_profiles.size > 0 %},
  "sameAs": [
    {%- for profile in social_profiles -%}
      {{ profile | strip | json }}{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
  {%- endif %}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- case request.page_type -%}

  {%- when 'product' -%}
    {%- assign product_variant = product.selected_or_first_available_variant -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "url": {{ shop.url | append: product.url | json }},
      "description": {{ product.description | strip_html | truncate: 500 | json }},
      {% if product.featured_media -%}
      "image": [
        {%- for media in product.media limit: 5 -%}
          {{ media.preview_image | image_url: width: 1200 | prepend: 'https:' | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      {%- endif %}
      {% if product.vendor != blank -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      {%- endif %}
      {% if product_variant.sku != blank -%}
      "sku": {{ product_variant.sku | json }},
      {%- endif %}
      {% if product_variant.barcode != blank -%}
      "gtin": {{ product_variant.barcode | json }},
      {%- endif %}
      "offers": [
        {%- for variant in product.variants -%}
          {
            "@type": "Offer",
            "url": {{ shop.url | append: variant.url | json }},
            "price": {{ variant.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | json }},
            "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
            "itemCondition": "https://schema.org/NewCondition"
            {%- if variant.sku != blank %}, "sku": {{ variant.sku | json }}{% endif -%}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
    </script>

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | json }} },
        {%- if collection.title != blank -%}
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ shop.url | append: collection.url | json }} },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }} }
        {%- else -%}
        { "@type": "ListItem", "position": 2, "name": {{ product.title | json }} }
        {%- endif -%}
      ]
    }
    </script>

  {%- when 'collection' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "CollectionPage",
      "name": {{ collection.title | json }},
      "url": {{ shop.url | append: collection.url | json }},
      {% if collection.description != blank -%}
      "description": {{ collection.description | strip_html | truncate: 500 | json }},
      {%- endif %}
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": {{ 'general.breadcrumbs.home' | t | json }}, "item": {{ shop.url | json }} },
          { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }} }
        ]
      }
    }
    </script>

  {%- when 'article' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": {{ article.title | json }},
      "url": {{ shop.url | append: article.url | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%SZ' | json }},
      {% if article.image -%}
      "image": [{{ article.image | image_url: width: 1200 | prepend: 'https:' | json }}],
      {%- endif %}
      {% if article.author != blank -%}
      "author": { "@type": "Person", "name": {{ article.author | json }} },
      {%- endif %}
      "publisher": { "@type": "Organization", "name": {{ shop.name | json }} },
      "articleBody": {{ article.content | strip_html | truncate: 1000 | json }}
    }
    </script>

  {%- when 'page' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": {{ page.title | json }},
      "url": {{ shop.url | append: page.url | json }}
    }
    </script>
{%- endcase -%}
