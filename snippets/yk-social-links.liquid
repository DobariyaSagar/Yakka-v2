{%- comment -%}
  Renders the social accounts from theme settings › Social media as labelled
  links (no third-party logos shipped with the theme).
  Usage: {% render 'yk-social-links' %}
{%- endcomment -%}
{%- liquid
  assign networks = 'instagram,facebook,tiktok,youtube,x,pinterest,linkedin' | split: ','
  assign labels = 'Instagram,Facebook,TikTok,YouTube,X,Pinterest,LinkedIn' | split: ','
-%}
{%- capture social_html -%}
  {%- for network in networks -%}
    {%- assign key = 'social_' | append: network | append: '_link' -%}
    {%- assign url = settings[key] -%}
    {%- if url != blank -%}
      <li>
        <a class="yk-footer__link" href="{{ url }}" rel="me noopener" target="_blank">
          {{ labels[forloop.index0] }}
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign social_html = social_html | strip -%}
{%- if social_html != blank -%}
  <ul class="yk-footer__socials">{{ social_html }}</ul>
{%- endif -%}
