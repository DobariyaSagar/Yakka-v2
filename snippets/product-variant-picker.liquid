{%- comment -%}
  Variant picker — one control per option, so multi-option products
  (colour × size) work properly.

  Params
    product     product (required)
    picker_type 'swatch' | 'dropdown'   default 'swatch'
    section_id  string

  The variant JSON below is what yk-product.js reads to resolve the selected
  combination, so the markup and the data can never disagree.
{%- endcomment -%}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign picker = picker_type | default: 'swatch'
-%}

{%- unless product.has_only_default_variant -%}
  <div class="yk-variants" data-yk-variant-picker>
    {%- for option in product.options_with_values -%}
      {%- assign option_index = forloop.index0 -%}

      <fieldset class="yk-variants__group" data-yk-option-index="{{ option_index }}">
        <legend class="yk-eyebrow yk-variants__label">
          {{ option.name }}
          <span class="yk-variants__selected" data-yk-option-selected>{{ option.selected_value }}</span>
        </legend>

        {%- if picker == 'dropdown' -%}
          <select
            class="yk-variants__select"
            name="options[{{ option.name | escape }}]"
            data-yk-option-input
            aria-label="{{ option.name | escape }}"
          >
            {%- for value in option.values -%}
              <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>
                {{ value }}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <div class="yk-swatches">
            {%- for value in option.values -%}
              {%- assign input_id = 'YkOption-' | append: section_id | append: '-' | append: option_index | append: '-' | append: forloop.index -%}
              <input
                class="yk-visually-hidden yk-swatch__input"
                type="radio"
                id="{{ input_id }}"
                name="{{ option.name | escape }}-{{ section_id }}"
                value="{{ value | escape }}"
                {% if value == option.selected_value %}checked{% endif %}
                data-yk-option-input
              >
              <label class="yk-swatch" for="{{ input_id }}">
                {%- assign swatch_handle = value | handle -%}
                {%- if option.name == 'Color' or option.name == 'Colour' -%}
                  <span class="yk-swatch__dot" style="background:{{ value | split: ' ' | last | downcase }}"></span>
                {%- endif -%}
                {{ value }}
              </label>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </fieldset>
    {%- endfor -%}

    {%- comment -%} the data yk-product.js resolves selections against {%- endcomment -%}
    <script type="application/json" data-yk-variant-data>
      [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id }},
            "options": {{ variant.options | json }},
            "available": {{ variant.available }},
            "price": {{ variant.price }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 }},
            "url": {{ variant.url | json }},
            {% if variant.featured_media %}"media": {{ variant.featured_media.preview_image | image_url: width: 1200 | json }},{% endif %}
            "sku": {{ variant.sku | json }},
            "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
            "inventory_management": {{ variant.inventory_management | json }},
            "inventory_policy": {{ variant.inventory_policy | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    </script>
  </div>
{%- endunless -%}
