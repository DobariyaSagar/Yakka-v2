{%- comment -%}
  Filter + sort toolbar, driven by Shopify's storefront filters
  (Admin → Search & Discovery). Works without JS: it is one <form> that GETs the
  collection URL. yk-facets.js upgrades it to fetch-and-swap.

  Params: results (collection or search object), section_id, enable_filtering,
          enable_sorting, filter_layout ('horizontal' | 'vertical')

  Usage: {% render 'facets', results: collection, section_id: section.id %}
{%- endcomment -%}

{%- liquid
  assign sort_by = results.sort_by | default: results.default_sort_by
  assign total = results.products_count | default: results.results_count

  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = routes.search_url | append: '?q=' | append: terms | append: '&options%5Bprefix%5D=last&type=product'
  endif
-%}

<div class="yk-facets" data-yk-facets>
  <form
    class="yk-facets__form"
    id="YkFacetForm-{{ section_id }}"
    data-yk-facet-form
  >
    {%- if results.terms -%}
      <input type="hidden" name="q" value="{{ results.terms | escape }}">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="hidden" name="type" value="product">
    {%- endif -%}

    {%- if enable_filtering -%}
      <div class="yk-facets__filters yk-facets__filters--{{ filter_layout | default: 'horizontal' }}">
        {%- for filter in results.filters -%}
          {%- case filter.type -%}

            {%- when 'boolean' or 'list' -%}
              <details class="yk-facet" {% if filter.active_values.size > 0 %}open{% endif %}>
                <summary class="yk-facet__summary">
                  <span>{{ filter.label | escape }}</span>
                  {%- if filter.active_values.size > 0 -%}
                    <span class="yk-facet__count">{{ filter.active_values.size }}</span>
                  {%- endif -%}
                  <span class="yk-facet__chevron" aria-hidden="true"></span>
                </summary>

                <div class="yk-facet__panel">
                  <ul class="yk-facet__list">
                    {%- for value in filter.values -%}
                      <li class="yk-facet__item">
                        <label class="yk-facet__label{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span class="yk-facet__name">{{ value.label | escape }}</span>
                          <span class="yk-facet__value-count">({{ value.count }})</span>
                        </label>
                      </li>
                    {%- endfor -%}
                  </ul>

                  {%- if filter.active_values.size > 0 -%}
                    <a class="yk-facet__clear" href="{{ filter.url_to_remove }}" data-yk-facet-link>
                      {{ 'products.facets.clear' | t }}
                    </a>
                  {%- endif -%}
                </div>
              </details>

            {%- when 'price_range' -%}
              <details class="yk-facet" {% if filter.min_value.value or filter.max_value.value %}open{% endif %}>
                <summary class="yk-facet__summary">
                  <span>{{ filter.label | escape }}</span>
                  <span class="yk-facet__chevron" aria-hidden="true"></span>
                </summary>
                <div class="yk-facet__panel">
                  <div class="yk-facet__range">
                    <label class="yk-visually-hidden" for="YkFilterMin-{{ section_id }}">
                      {{ 'products.facets.from' | t }}
                    </label>
                    <input
                      class="yk-field"
                      id="YkFilterMin-{{ section_id }}"
                      name="{{ filter.min_value.param_name }}"
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      placeholder="{{ 'products.facets.from' | t }}"
                      {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                    >
                    <span aria-hidden="true">–</span>
                    <label class="yk-visually-hidden" for="YkFilterMax-{{ section_id }}">
                      {{ 'products.facets.to' | t }}
                    </label>
                    <input
                      class="yk-field"
                      id="YkFilterMax-{{ section_id }}"
                      name="{{ filter.max_value.param_name }}"
                      type="number"
                      inputmode="numeric"
                      min="0"
                      max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                      {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}
                    >
                  </div>
                </div>
              </details>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="yk-facets__bar">
      <span class="yk-facets__count" data-yk-facet-count>
        {{ 'products.facets.product_count' | t: count: total }}
      </span>

      {%- if enable_sorting -%}
        <div class="yk-facets__sort">
          <label class="yk-facets__sort-label" for="YkSortBy-{{ section_id }}">
            {{ 'products.facets.sort_by' | t }}
          </label>
          <select
            class="yk-facets__select"
            id="YkSortBy-{{ section_id }}"
            name="sort_by"
            data-yk-facet-sort
          >
            {%- for option in results.sort_options -%}
              {%- if option.value != blank -%}
                <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>
                  {{ option.name | escape }}
                </option>
              {%- endif -%}
            {%- endfor -%}
          </select>
        </div>
      {%- endif -%}

      {%- comment -%} no-JS fallback {%- endcomment -%}
      <noscript>
        <button type="submit" class="yk-btn yk-btn--sm">{{ 'products.facets.apply' | t }}</button>
      </noscript>
    </div>

    {%- comment -%} active filter chips {%- endcomment -%}
    {%- assign active_count = 0 -%}
    {%- for filter in results.filters -%}
      {%- assign active_count = active_count | plus: filter.active_values.size -%}
    {%- endfor -%}

    {%- if active_count > 0 -%}
      <div class="yk-facets__active">
        {%- for filter in results.filters -%}
          {%- for value in filter.active_values -%}
            <a class="yk-facets__chip" href="{{ value.url_to_remove }}" data-yk-facet-link>
              {{ filter.label | escape }}: {{ value.label | escape }}
              <span aria-hidden="true">×</span>
            </a>
          {%- endfor -%}
        {%- endfor -%}
        <a class="yk-facets__clear-all" href="{{ results_url }}" data-yk-facet-link>
          {{ 'products.facets.clear_all' | t }}
        </a>
      </div>
    {%- endif -%}
  </form>
</div>
