{%- comment -%}
  Product card — the single card used by the collection grid, search results and
  product recommendations, so they can never drift apart.

  Params
    card_product           product   (required)
    media_ratio            '1/1' | '3/4' | '4/3' | 'adapt'   default '1/1'
    show_secondary_image   boolean — swap to image 2 on hover
    show_vendor            boolean
    show_rating            boolean — uses the shop's review metafields when present
    quick_add              boolean — adds the default variant without leaving the page
    lazy_load              boolean — false for the first row
    section_id             string  — needed by quick add for section rendering

  Usage: {% render 'card-product', card_product: product, media_ratio: '1/1' %}
{%- endcomment -%}

{%- liquid
  assign ratio = media_ratio | default: '1/1'
  assign loading = 'lazy'
  if lazy_load == false
    assign loading = 'eager'
  endif

  assign on_sale = false
  if card_product.compare_at_price > card_product.price
    assign on_sale = true
  endif
-%}

{%- if card_product == blank -%}
  {%- comment -%} onboarding placeholder so the grid never collapses {%- endcomment -%}
  <div class="yk-card">
    <div class="yk-card__media yk-card__media--{{ ratio | replace: '/', '-' }}">
      {{ 'product-1' | placeholder_svg_tag: 'yk-card__image' }}
    </div>
    <div class="yk-card__body">
      <h3 class="yk-card__title">{{ 'onboarding.product_title' | t }}</h3>
      <span class="yk-card__price">{{ 1999 | money }}</span>
    </div>
  </div>
{%- else -%}
  <div class="yk-card{% unless card_product.available %} yk-card--sold-out{% endunless %}">
    <a class="yk-card__link" href="{{ card_product.url }}" aria-labelledby="CardTitle-{{ card_product.id }}">
      <div class="yk-card__media yk-card__media--{{ ratio | replace: '/', '-' }}">
        {%- if card_product.featured_media -%}
          {{
            card_product.featured_media
            | image_url: width: 800
            | image_tag:
              class: 'yk-card__image',
              widths: '200,300,400,600,800',
              sizes: '(max-width: 749px) 46vw, (max-width: 989px) 32vw, 25vw',
              alt: card_product.featured_media.alt | default: card_product.title,
              loading: loading,
              decoding: 'async'
          }}

          {%- if show_secondary_image and card_product.media[1] != blank -%}
            {{
              card_product.media[1]
              | image_url: width: 800
              | image_tag:
                class: 'yk-card__image yk-card__image--secondary',
                widths: '200,300,400,600,800',
                sizes: '(max-width: 749px) 46vw, (max-width: 989px) 32vw, 25vw',
                alt: card_product.media[1].alt | default: card_product.title,
                loading: 'lazy',
                decoding: 'async'
            }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'yk-card__image' }}
        {%- endif -%}

        {%- comment -%} badges {%- endcomment -%}
        {%- unless card_product.available -%}
          <span class="yk-card__badge yk-card__badge--muted">{{ 'products.product.sold_out' | t }}</span>
        {%- elsif on_sale -%}
          <span class="yk-card__badge">
            {{ 'products.product.on_sale' | t }}
            {%- assign saved = card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price -%}
            &nbsp;{{ saved }}%
          </span>
        {%- endunless -%}
      </div>
    </a>

    <div class="yk-card__body">
      {%- if show_vendor and card_product.vendor != blank -%}
        <span class="yk-card__vendor">{{ card_product.vendor }}</span>
      {%- endif -%}

      <h3 class="yk-card__title" id="CardTitle-{{ card_product.id }}">
        <a class="yk-card__title-link" href="{{ card_product.url }}">{{ card_product.title | escape }}</a>
      </h3>

      {%- if show_rating and card_product.metafields.reviews.rating.value != blank -%}
        {%- assign rating = card_product.metafields.reviews.rating.value.rating -%}
        <div class="yk-card__rating">
          {% render 'yk-stars', rating: rating %}
          <span class="yk-card__rating-count">
            ({{ card_product.metafields.reviews.rating_count.value }})
          </span>
        </div>
      {%- endif -%}

      <div class="yk-card__prices">
        {%- if card_product.price_varies -%}
          <span class="yk-card__price">
            {{ 'products.product.from_price' | t }}
            {% render 'yk-price', price: card_product.price_min %}
          </span>
        {%- else -%}
          <span class="yk-card__price{% if on_sale %} yk-card__price--sale{% endif %}">
            {% render 'yk-price', price: card_product.price %}
          </span>
        {%- endif -%}

        {%- if on_sale -%}
          <s class="yk-card__price-compare">
            {% render 'yk-price', price: card_product.compare_at_price %}
          </s>
        {%- endif -%}
      </div>

      {%- if quick_add and card_product.available -%}
        {%- if card_product.variants.size == 1 -%}
          <form action="{{ routes.cart_add_url }}" method="post" class="yk-card__quick-add" data-yk-quick-add>
            <input type="hidden" name="id" value="{{ card_product.selected_or_first_available_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="sections" value="{{ section_id }}">
            <button type="submit" class="yk-btn yk-btn--sm yk-btn--full">
              {{ 'products.product.add_to_cart' | t }}
            </button>
          </form>
        {%- else -%}
          <a class="yk-btn yk-btn--sm yk-btn--full yk-btn--ghost" href="{{ card_product.url }}">
            {{ 'products.product.choose_options' | t }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
{%- endif -%}
