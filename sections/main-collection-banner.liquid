{%- comment -%}
  Section: main-collection-banner — collection title, description and image.
  Styles: assets/section-collection.css
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.show_collection_image and collection.image -%}
      <div class="yk-collection-banner__media">
        {{
          collection.image
          | image_url: width: 1800
          | image_tag:
            class: 'yk-collection-banner__image',
            widths: '600,900,1200,1800',
            sizes: '100vw',
            alt: collection.title,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </div>
    {%- endif -%}

    <span class="yk-eyebrow">{{ 'collections.general.collection' | t }}</span>
    <h1 class="yk-section__heading">{{ collection.title | escape }}</h1>

    {%- if section.settings.show_collection_description and collection.description != blank -%}
      <div class="yk-section__text yk-rte">{{ collection.description }}</div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "yk-section-collection-banner",
  "settings": [
    { "type": "checkbox", "id": "show_collection_image", "label": "Show collection image", "default": true },
    { "type": "checkbox", "id": "show_collection_description", "label": "Show collection description", "default": true },
    { "type": "select", "id": "content_alignment", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },

    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 88, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 34 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 }
  ]
}
{% endschema %}
