{%- comment -%}
  Section: faq
  Native <details>/<summary> accordion — keyboard accessible, works without JS.
  yk-faq.js only enforces single-open when that setting is on.
  Styles: assets/section-faq.css
{%- endcomment -%}

{{ 'section-faq.css' | asset_url | stylesheet_tag }}
{%- if section.settings.single_open -%}
  <script src="{{ 'yk-faq.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-faq-width: {{ section.settings.max_width }}px;
    --yk-faq-top: {{ section.settings.list_offset }}px;
  }
{% endstyle %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="yk-section__heading yk-section__heading--tight yk-measure-md">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yk-faq" data-yk-faq data-yk-single="{{ section.settings.single_open }}">
        {%- for block in section.blocks -%}
          <details
            class="yk-faq__item"
            {% if block.settings.open %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="yk-faq__question">
              {{ block.settings.question }}
              <span class="yk-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="yk-faq__answer yk-rte">{{ block.settings.answer }}</div>
          </details>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{%- comment -%}
  FAQPage structured data — opt-in, because Google only wants it on pages whose
  visible content is the Q&A. Questions and answers are taken verbatim from the
  blocks, which is what the rich result requires.
{%- endcomment -%}
{%- if section.settings.enable_faq_schema and section.blocks.size > 0 -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- for block in section.blocks -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_html | json }}
          }
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "yk-section-faq",
  "max_blocks": 24,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you buy." },
    { "type": "checkbox", "id": "single_open", "label": "One answer open at a time", "default": true },
    { "type": "checkbox", "id": "enable_faq_schema", "label": "Add FAQ structured data (SEO)", "default": true,
      "info": "Outputs FAQPage JSON-LD so the questions can appear as a rich result. Use on one FAQ section per page." },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "range", "id": "max_width", "label": "List width", "min": 560, "max": 1180, "step": 20, "unit": "px", "default": 820 },
    { "type": "range", "id": "list_offset", "label": "Space above list", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 52 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_heading", "label": "Heading and questions" },
    { "type": "color", "id": "color_text", "label": "Answers" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Open / hover accent", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "question", "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does a cordless heated lunchbox work?" },
        { "type": "richtext", "id": "answer", "label": "Answer",
          "default": "<p>A built-in rechargeable battery warms your food gently and evenly. Press start, or set the timer and let it come up to temperature while you work.</p>" },
        { "type": "checkbox", "id": "open", "label": "Open by default", "default": false }
      ] }
  ],
  "presets": [
    { "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "How does a cordless heated lunchbox work?", "answer": "<p>A built-in rechargeable battery warms your food gently and evenly. Press start, or set the timer and let it come up to temperature while you work.</p>", "open": true } },
        { "type": "question", "settings": { "question": "How long does the battery last?", "answer": "<p>Two to three full heating cycles per charge — comfortably a full workday, and most blokes get two or three days out of one charge.</p>" } },
        { "type": "question", "settings": { "question": "Do I need power on site?", "answer": "<p>No. That's the whole point. Charge it at home overnight and it runs entirely off its own battery all day.</p>" } },
        { "type": "question", "settings": { "question": "Will it leak in my toolbox?", "answer": "<p>The stainless inner seals shut and the outer shell is impact-rated. It's built to be thrown in the tray, not carried carefully.</p>" } },
        { "type": "question", "settings": { "question": "Is it easy to clean?", "answer": "<p>The stainless container lifts out and goes straight in the dishwasher. Wipe the outer shell down and you're done.</p>" } },
        { "type": "question", "settings": { "question": "What if I don't like it?", "answer": "<p>Sixty days, full refund, and you keep the unit — you don't pay return freight.</p>" } }
      ] }
  ]
}
{% endschema %}
