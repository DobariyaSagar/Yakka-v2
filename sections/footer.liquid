{%- comment -%}
  Section: footer
  Block types: brand (logo + blurb), menu (link list column), newsletter, text.
  Styles: assets/section-footer.css
{%- endcomment -%}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-footer-gap: {{ section.settings.column_gap }}px;
    --yk-footer-heading: {{ section.settings.color_column_heading }};
  }
{% endstyle %}

<div class="yk-footer yk-section">
  <div class="yk-page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="yk-footer__grid">
        {%- for block in section.blocks -%}
          <div class="yk-footer__col" {{ block.shopify_attributes }}>
            {%- case block.type -%}

              {%- when 'brand' -%}
                {%- comment -%} Falls back to theme settings › Brand information. {%- endcomment -%}
                <a class="yk-footer__logo" href="{{ routes.root_url }}">
                  {%- if block.settings.use_brand_image and settings.brand_image != blank -%}
                    {{
                      settings.brand_image
                      | image_url: width: 480
                      | image_tag:
                        class: 'yk-footer__logo-image',
                        widths: '120,240,360,480',
                        alt: shop.name,
                        loading: 'lazy',
                        decoding: 'async'
                    }}
                  {%- else -%}
                    {{ block.settings.logo_text | default: settings.brand_headline | default: shop.name }}
                  {%- endif -%}
                </a>
                {%- if block.settings.text != blank -%}
                  <p>{{ block.settings.text }}</p>
                {%- elsif settings.brand_description != blank -%}
                  <div class="yk-rte">{{ settings.brand_description }}</div>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="yk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul>
                    {%- for link in block.settings.menu.links -%}
                      <li><a class="yk-footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}

              {%- when 'social' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="yk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {% render 'yk-social-links' %}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="yk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="yk-rte">{{ block.settings.text }}</div>

              {%- when 'newsletter' -%}
                {%- if block.settings.heading != blank -%}
                  <h2 class="yk-footer__heading">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p style="font-size:14px">{{ block.settings.text }}</p>
                {%- endif -%}

                {%- form 'customer', class: 'yk-newsletter' -%}
                  <input type="hidden" name="contact[tags]" value="newsletter">
                  <label class="yk-visually-hidden" for="YkNewsletter-{{ block.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                  <input
                    class="yk-newsletter__input"
                    id="YkNewsletter-{{ block.id }}"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    autocomplete="email"
                    required
                    placeholder="{{ block.settings.placeholder }}"
                  >
                  <button type="submit" class="yk-newsletter__button">{{ block.settings.button_label }}</button>

                  {%- if form.posted_successfully? -%}
                    <p class="yk-form-note yk-form-note--success" role="status">{{ 'newsletter.success' | t }}</p>
                  {%- elsif form.errors -%}
                    <p class="yk-form-note yk-form-note--error" role="alert">{{ form.errors | default_errors }}</p>
                  {%- endif -%}
                {%- endform -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="yk-footer__bottom">
      <span>
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}
        {%- if section.settings.show_policy_links -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank %} · <a class="yk-footer__link" href="{{ policy.url }}">{{ policy.title }}</a>{% endif -%}
          {%- endfor -%}
        {%- endif -%}
      </span>
      <span>{{ section.settings.tagline }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "yk-section-footer",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "tagline", "label": "Right-hand line", "default": "Australian owned & operated" },
    { "type": "checkbox", "id": "show_policy_links", "label": "Show store policy links", "default": false },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 16, "max": 80, "step": 2, "unit": "px", "default": 46 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#17150F" },
    { "type": "color", "id": "color_heading", "label": "Logo", "default": "#FFFFFF" },
    { "type": "color", "id": "color_text", "label": "Text and links", "default": "#B5AEA4" },
    { "type": "color", "id": "color_column_heading", "label": "Column headings", "default": "#8C857B" },
    { "type": "color", "id": "color_accent", "label": "Accent (newsletter button)", "default": "#E8500F" },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 92 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 38 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 30 }
  ],
  "blocks": [
    { "type": "brand", "name": "Brand", "limit": 1,
      "settings": [
        { "type": "checkbox", "id": "use_brand_image", "label": "Use the brand logo", "default": false,
          "info": "Set it in Theme settings › Brand information." },
        { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Yakka Essential" },
        { "type": "textarea", "id": "text", "label": "Blurb",
          "default": "Practical gear for hard-working Australians. Built for work, travel, home and everyday life." }
      ] },
    { "type": "menu", "name": "Menu column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ] },
    { "type": "text", "name": "Text column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Visit us" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Mon–Fri, 9:00am – 5:00pm AEST</p>" }
      ] },
    { "type": "social", "name": "Social links", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Follow" },
        { "type": "paragraph", "content": "Add the account URLs in Theme settings › Social media." }
      ] },
    { "type": "newsletter", "name": "Newsletter", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Product drops, field tips and the occasional deal." },
        { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Email address" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign up" }
      ] }
  ],
  "presets": [
    { "name": "Footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu", "settings": { "heading": "Shop" } },
        { "type": "menu", "settings": { "heading": "Support" } },
        { "type": "newsletter" }
      ] }
  ]
}
{% endschema %}
