{%- comment -%}
  Section: product-buy-box
  Gallery + price + variant swatches + quantity + add to cart, plus an optional
  sticky buy bar that appears once the buy box scrolls out of view.

  Works in two places:
    • product template — uses the current `product`
    • any other page   — uses the product chosen in the "Product" setting
  With no product it renders demo content so the layout is still previewable.

  Styles: assets/section-product.css   Behaviour: assets/yk-product.js
{%- endcomment -%}

{{ 'section-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yk-product.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'yk-cart.js' | asset_url }}" defer="defer"></script>
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-product-gap: {{ section.settings.column_gap }}px;
    --yk-gallery-ratio: {{ section.settings.image_ratio }};
    --yk-thumb-cols: {{ section.settings.thumbnail_columns }};
    --yk-product-title: {{ section.settings.heading_size }}px;
  }
{% endstyle %}

{%- liquid
  assign yk_product = section.settings.product | default: product
  assign has_product = false

  if yk_product != blank and yk_product.id
    assign has_product = true
    assign current_variant = yk_product.selected_or_first_available_variant
    assign price = current_variant.price
    assign compare_price = current_variant.compare_at_price
    assign product_title = yk_product.title
  else
    assign price = section.settings.fallback_price
    assign compare_price = section.settings.fallback_compare_price
    assign product_title = section.settings.fallback_title
  endif

  assign on_sale = false
  if compare_price > price
    assign on_sale = true
  endif

  assign spec_blocks = section.blocks | where: 'type', 'spec'
  assign assurance_blocks = section.blocks | where: 'type', 'assurance'
  assign form_id = 'YkProductForm-' | append: section.id
-%}

<div class="yk-section">
  <div class="yk-page-width">
    <div class="yk-product" data-yk-buy-box>

      {%- comment -%} ─────────────────────────────── gallery {%- endcomment -%}
      <div class="yk-product__media" data-yk-gallery>
        <div class="yk-gallery">
          {%- if section.settings.badge_text != blank -%}
            <span class="yk-flag">{{ section.settings.badge_text }}</span>
          {%- endif -%}

          {%- if has_product and yk_product.featured_image -%}
            {%- assign featured = yk_product.featured_image -%}
            <img
              class="yk-gallery__image"
              src="{{ featured | image_url: width: 1200 }}"
              srcset="{{ featured | image_url: width: 600 }} 600w,
                      {{ featured | image_url: width: 900 }} 900w,
                      {{ featured | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 989px) 92vw, 46vw"
              alt="{{ featured.alt | default: product_title | escape }}"
              width="{{ featured.width }}"
              height="{{ featured.height }}"
              loading="lazy" decoding="async"
              data-yk-gallery-main
            >
          {%- else -%}
            <img
              class="yk-gallery__image"
              src="{{ 'yakka-product.jpg' | asset_url }}"
              alt="{{ product_title | escape }}"
              width="1000"
              height="1000"
              loading="lazy" decoding="async"
              data-yk-gallery-main
            >
          {%- endif -%}
        </div>

        {%- if section.settings.show_thumbnails -%}
          <div class="yk-gallery__thumbs" role="tablist" aria-label="{{ 'products.product.media.gallery_viewer' | t }}">
            {%- if has_product and yk_product.images.size > 1 -%}
              {%- for image in yk_product.images limit: section.settings.thumbnail_limit -%}
                <div
                  class="yk-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  tabindex="0"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-yk-gallery-thumb
                  data-image="{{ image | image_url: width: 1200 }}"
                >
                  {{
                    image
                    | image_url: width: 240
                    | image_tag:
                      class: 'yk-gallery__thumb-image',
                      widths: '120,240',
                      alt: image.alt | default: product_title,
                      loading: 'lazy',
                      decoding: 'async'
                  }}
                </div>
              {%- endfor -%}
            {%- else -%}
              {%- assign placeholders = 'yakka-product.jpg,yakka-hero.jpg,yakka-lifestyle.jpg,yakka-review-1.jpg' | split: ',' -%}
              {%- for file in placeholders -%}
                <div
                  class="yk-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  tabindex="0"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-yk-gallery-thumb
                  data-image="{{ file | asset_url }}"
                >
                  <img class="yk-gallery__thumb-image" src="{{ file | asset_url }}"
                       alt="" width="240" height="240" loading="lazy" decoding="async">
                </div>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ─────────────────────────────── details {%- endcomment -%}
      <div class="yk-product__details">
        {%- if section.settings.eyebrow != blank -%}
          <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        <h2 class="yk-product__title">{{ product_title }}</h2>

        <div class="yk-price">
          <span class="yk-price__current" data-yk-price-current>{% render 'yk-price', price: price %}</span>
          <span
            class="yk-price__compare"
            data-yk-price-compare
            {% unless on_sale %}hidden{% endunless %}
          >{% if on_sale %}{% render 'yk-price', price: compare_price %}{% endif %}</span>

          {%- if on_sale and section.settings.show_saving -%}
            <span class="yk-price__save">
              {{ 'products.product.save' | t }}
              {%- assign saving = compare_price | minus: price -%}
              {% render 'yk-price', price: saving, trim: true %}
            </span>
          {%- endif -%}
        </div>

        {%- if section.settings.finance_text != blank -%}
          {%- assign instalment_cents = price | divided_by: 4.0 -%}
          {%- capture instalment %}{% render 'yk-price', price: instalment_cents %}{% endcapture -%}
          <div class="yk-product__finance">
            {{ section.settings.finance_text | replace: '[price]', instalment }}
          </div>
        {%- endif -%}

        {%- if spec_blocks.size > 0 -%}
          <ul class="yk-specs">
            {%- for block in spec_blocks -%}
              <li class="yk-specs__row" {{ block.shopify_attributes }}>
                <span class="yk-specs__label">{{ block.settings.label }}</span>
                <span class="yk-specs__value">{{ block.settings.value }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%} add to cart {%- endcomment -%}
        {%- if has_product -%}
          {%- form 'product', yk_product, id: form_id, novalidate: 'novalidate', data-yk-variants: '', data-yk-section: section.id -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}" data-yk-variant-id>

            {%- comment -%} one control per option — see snippets/product-variant-picker {%- endcomment -%}
            {% render 'product-variant-picker',
              product: yk_product,
              picker_type: section.settings.variant_picker_type,
              section_id: section.id
            %}

            {%- if section.settings.show_inventory_status -%}
              <p
                class="yk-product__inventory"
                data-yk-inventory
                data-threshold="{{ section.settings.inventory_threshold }}"
                data-label-in-stock="{{ 'products.product.inventory.in_stock' | t | escape }}"
                data-label-low-stock="{{ 'products.product.inventory.low_stock' | t: count: '__count__' | escape }}"
                data-label-out-of-stock="{{ 'products.product.inventory.out_of_stock' | t | escape }}"
              >
                {%- if current_variant.available -%}
                  {%- if current_variant.inventory_management == null or current_variant.inventory_quantity > section.settings.inventory_threshold -%}
                    <span class="yk-product__inventory-dot"></span>{{ 'products.product.inventory.in_stock' | t }}
                  {%- else -%}
                    <span class="yk-product__inventory-dot yk-product__inventory-dot--low"></span>
                    {{ 'products.product.inventory.low_stock' | t: count: current_variant.inventory_quantity }}
                  {%- endif -%}
                {%- else -%}
                  <span class="yk-product__inventory-dot yk-product__inventory-dot--out"></span>
                  {{ 'products.product.inventory.out_of_stock' | t }}
                {%- endif -%}
              </p>
            {%- endif -%}

            <div class="yk-buy-row">
              {%- if section.settings.show_quantity -%}
                <div class="yk-qty" data-yk-qty>
                  <button type="button" class="yk-qty__btn" data-yk-qty-down
                          aria-label="{{ 'products.product.quantity.decrease' | t }}">&minus;</button>
                  <label class="yk-visually-hidden" for="{{ form_id }}-qty">
                    {{ 'products.product.quantity.label' | t }}
                  </label>
                  <input
                    class="yk-qty__input"
                    id="{{ form_id }}-qty"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if current_variant.inventory_management and current_variant.inventory_policy == 'deny' %}
                      max="{{ current_variant.inventory_quantity }}"
                    {% endif %}
                    inputmode="numeric"
                    data-yk-qty-input
                  >
                  <button type="button" class="yk-qty__btn" data-yk-qty-up
                          aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
                </div>
              {%- endif -%}

              <button
                type="submit"
                class="yk-btn yk-btn--grow"
                data-yk-submit
                data-label-default="{{ section.settings.add_to_cart_label | escape }}"
                data-label-sold-out="{{ 'products.product.sold_out' | t | escape }}"
                {% unless current_variant.available %}disabled{% endunless %}
              >
                {%- if current_variant.available -%}
                  {{ section.settings.add_to_cart_label }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            </div>

            {%- if section.settings.show_dynamic_checkout -%}
              <div style="margin-top:12px">{{ form | payment_button }}</div>
            {%- endif -%}
          {%- endform -%}
        {%- else -%}
          <div class="yk-buy-row">
            {%- if section.settings.show_quantity -%}
              <div class="yk-qty" data-yk-qty>
                <button type="button" class="yk-qty__btn" data-yk-qty-down
                        aria-label="{{ 'products.product.quantity.decrease' | t }}">&minus;</button>
                <input class="yk-qty__input" type="number" value="1" min="1" inputmode="numeric"
                       aria-label="{{ 'products.product.quantity.label' | t }}">
                <button type="button" class="yk-qty__btn" data-yk-qty-up
                        aria-label="{{ 'products.product.quantity.increase' | t }}">+</button>
              </div>
            {%- endif -%}
            <a class="yk-btn yk-btn--grow" href="{{ routes.all_products_collection_url }}">
              {{ section.settings.add_to_cart_label }}
            </a>
          </div>
        {%- endif -%}

        {%- if section.settings.show_description and has_product and yk_product.description != blank -%}
          <div class="yk-product__description yk-rte">{{ yk_product.description }}</div>
        {%- endif -%}

        {%- if assurance_blocks.size > 0 -%}
          <div class="yk-product__assurances">
            {%- for block in assurance_blocks -%}
              <span {{ block.shopify_attributes }}>◦ {{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- comment -%} ─────────────────────────────── sticky buy bar {%- endcomment -%}
{%- if section.settings.show_sticky_bar -%}
  <div class="yk-sticky-bar" data-yk-sticky-bar data-yk-watch="[data-yk-buy-box]">
    <div class="yk-sticky-bar__inner">
      {%- if has_product and yk_product.featured_image -%}
        {{
          yk_product.featured_image
          | image_url: width: 120
          | image_tag:
            class: 'yk-sticky-bar__image',
            widths: '60,120',
            alt: product_title,
            loading: 'lazy',
            decoding: 'async'
        }}
      {%- else -%}
        <img class="yk-sticky-bar__image" src="{{ 'yakka-product.jpg' | asset_url }}"
             alt="" width="112" height="112" loading="lazy" decoding="async">
      {%- endif -%}

      <div class="yk-sticky-bar__text">
        <b class="yk-sticky-bar__title">{{ product_title }}</b>
        <span class="yk-sticky-bar__meta">{{ section.settings.sticky_meta }}</span>
      </div>

      <div class="yk-sticky-bar__price">
        <b class="yk-sticky-bar__price-current" data-yk-sticky-price>{% render 'yk-price', price: price %}</b>
        {%- if on_sale -%}
          <span class="yk-sticky-bar__price-compare">{% render 'yk-price', price: compare_price %}</span>
        {%- endif -%}
      </div>

      {%- if has_product -%}
        <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" data-yk-quick-add>
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-yk-sticky-variant-id>
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="yk-btn yk-btn--sm"
                  {% unless current_variant.available %}disabled{% endunless %}>
            {{ section.settings.sticky_button_label }}
          </button>
        </form>
      {%- else -%}
        <a class="yk-btn yk-btn--sm" href="{{ routes.all_products_collection_url }}">
          {{ section.settings.sticky_button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product buy box",
  "tag": "section",
  "class": "yk-section-product",
  "settings": [
    { "type": "header", "content": "Product" },
    { "type": "product", "id": "product", "label": "Product",
      "info": "Leave empty on a product template — the current product is used." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Self-Heating Lunchbox" },
    { "type": "text", "id": "badge_text", "label": "Image badge", "default": "Save 50% today" },

    { "type": "header", "content": "Purchase" },
    { "type": "text", "id": "add_to_cart_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "checkbox", "id": "show_quantity", "label": "Show quantity selector", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show dynamic checkout buttons", "default": true },
    { "type": "checkbox", "id": "show_saving", "label": "Show saving badge", "default": true },
    { "type": "checkbox", "id": "show_description", "label": "Show product description", "default": false },
    { "type": "text", "id": "finance_text", "label": "Finance line",
      "default": "or 4 interest-free payments of [price]",
      "info": "[price] becomes a quarter of the price." },

    { "type": "select", "id": "variant_picker_type", "label": "Variant picker", "default": "swatch",
      "options": [
        { "value": "swatch", "label": "Buttons" },
        { "value": "dropdown", "label": "Dropdowns" }
      ] },
    { "type": "checkbox", "id": "show_inventory_status", "label": "Show inventory status", "default": true },
    { "type": "range", "id": "inventory_threshold", "label": "Low stock threshold", "min": 0, "max": 50, "step": 1, "default": 10,
      "info": "Below this, the exact count is shown." },

    { "type": "header", "content": "Gallery" },
    { "type": "checkbox", "id": "show_thumbnails", "label": "Show thumbnails", "default": true },
    { "type": "range", "id": "thumbnail_columns", "label": "Thumbnail columns", "min": 3, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "thumbnail_limit", "label": "Maximum thumbnails", "min": 3, "max": 12, "step": 1, "default": 8 },
    { "type": "select", "id": "image_ratio", "label": "Main image ratio", "default": "1/1",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/5", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ] },

    { "type": "header", "content": "Sticky buy bar" },
    { "type": "checkbox", "id": "show_sticky_bar", "label": "Show on scroll", "default": true },
    { "type": "text", "id": "sticky_meta", "label": "Caption", "default": "In stock · Free express shipping" },
    { "type": "text", "id": "sticky_button_label", "label": "Button label", "default": "Add to cart" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 68 },

    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "color", "id": "color_background", "label": "Section background",
      "info": "Overrides the colour scheme." },
    { "type": "color", "id": "color_heading", "label": "Product title" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Product title size", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },

    { "type": "header", "content": "Fallback content (no product assigned)" },
    { "type": "text", "id": "fallback_title", "label": "Title", "default": "Yakka Essential Portable Food Warmer" },
    { "type": "number", "id": "fallback_price", "label": "Price in cents", "default": 13999 },
    { "type": "number", "id": "fallback_compare_price", "label": "Compare-at price in cents", "default": 27999 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "spec", "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Power" },
        { "type": "text", "id": "value", "label": "Value", "default": "100% cordless · USB-C rechargeable" }
      ] },
    { "type": "assurance", "name": "Assurance",
      "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "In stock, ships today" } ] }
  ],
  "presets": [
    { "name": "Product buy box",
      "blocks": [
        { "type": "spec", "settings": { "label": "Power", "value": "100% cordless · USB-C rechargeable" } },
        { "type": "spec", "settings": { "label": "Heat time", "value": "Steaming in ~45 min" } },
        { "type": "spec", "settings": { "label": "Battery", "value": "2–3 full heat cycles per charge" } },
        { "type": "spec", "settings": { "label": "Capacity", "value": "1.5L stainless — a full tradie's feed" } },
        { "type": "spec", "settings": { "label": "Build", "value": "Leak-proof, impact-rated shell" } },
        { "type": "spec", "settings": { "label": "Included", "value": "Free insulated carry bag" } },
        { "type": "assurance", "settings": { "text": "In stock, ships today" } },
        { "type": "assurance", "settings": { "text": "Free express shipping" } },
        { "type": "assurance", "settings": { "text": "60-day money back" } }
      ] }
  ]
}
{% endschema %}
