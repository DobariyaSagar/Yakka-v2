{%- comment -%}
  Section: reviews — image + quote cards.
  Styles: assets/section-reviews.css   Stars: snippets/yk-stars.liquid
{%- endcomment -%}

{{ 'section-reviews.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-reviews-gap: {{ section.settings.grid_gap }}px;
    --yk-reviews-top: {{ section.settings.grid_offset }}px;
    --yk-review-quote: {{ section.settings.quote_size }}px;
    --yk-review-ratio: {{ section.settings.image_ratio }};
    --yk-card-bg: {{ section.settings.color_card }};
  }
{% endstyle %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="yk-section__heading yk-section__heading--tight yk-measure-sm">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yk-reviews">
        {%- for block in section.blocks -%}
          <article class="yk-review" {{ block.shopify_attributes }}>
            {%- if section.settings.show_images -%}
              {%- if block.settings.image != blank -%}
                <div class="yk-review__media">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'yk-review__image',
                      widths: '300,500,800',
                      sizes: '(max-width: 989px) 92vw, 33vw',
                      alt: block.settings.author,
                      loading: 'lazy',
                      decoding: 'async'
                  }}
                </div>
              {%- elsif block.settings.placeholder_image != 'none' -%}
                <div class="yk-review__media">
                  <img class="yk-review__image" src="{{ block.settings.placeholder_image | asset_url }}"
                       alt="" width="800" height="600" loading="lazy" decoding="async">
                </div>
              {%- endif -%}
            {%- endif -%}

            <div class="yk-review__body">
              {% render 'yk-stars', rating: block.settings.rating %}
              <blockquote class="yk-review__quote">{{ block.settings.quote }}</blockquote>
              <cite class="yk-review__cite">
                <b class="yk-review__author">{{ block.settings.author }}</b>
                {{ block.settings.meta }}
                {%- if block.settings.verified -%}
                  <span class="yk-review__verified">✓ {{ 'sections.reviews.verified' | t }}</span>
                {%- endif -%}
              </cite>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "yk-section-reviews",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "From the site" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What the crews are saying." },
    { "type": "checkbox", "id": "show_images", "label": "Show review images", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4/3",
      "options": [
        { "value": "4/3", "label": "Landscape" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait" }
      ] },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "grid_offset", "label": "Space above grid", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 54 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_heading", "label": "Heading and quotes" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Stars", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "quote_size", "label": "Quote size", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 22 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "blocks": [
    { "type": "review", "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "placeholder_image", "label": "Placeholder image", "default": "yakka-review-1.jpg",
          "info": "Used until you pick an image.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "yakka-review-1.jpg", "label": "Placeholder 1" },
            { "value": "yakka-review-2.jpg", "label": "Placeholder 2" },
            { "value": "yakka-review-3.jpg", "label": "Placeholder 3" }
          ] },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Honestly one of the best things I've bought for work." },
        { "type": "text", "id": "author", "label": "Author", "default": "John M." },
        { "type": "text", "id": "meta", "label": "Author detail", "default": "Carpenter · Brisbane, QLD" },
        { "type": "checkbox", "id": "verified", "label": "Show verified badge", "default": true }
      ] }
  ],
  "presets": [
    { "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "placeholder_image": "yakka-review-1.jpg", "quote": "Honestly one of the best things I've bought for work. Hot lunch, no queue for the microwave, no cold servo roll.", "author": "John M.", "meta": "Carpenter · Brisbane, QLD" } },
        { "type": "review", "settings": { "placeholder_image": "yakka-review-2.jpg", "quote": "Charge it Sunday night, get three days out of it. Steaming by smoko every single time.", "author": "William S.", "meta": "Concreter · Sydney, NSW" } },
        { "type": "review", "settings": { "placeholder_image": "yakka-review-3.jpg", "quote": "Lives in the toolbox and hasn't leaked once. Bought a second one for my apprentice after a fortnight.", "author": "Martin R.", "meta": "Electrician · Perth, WA" } }
      ] }
  ]
}
{% endschema %}
