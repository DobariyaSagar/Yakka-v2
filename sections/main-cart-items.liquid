{%- comment -%}
  Section: main-cart-items
  Line items with working quantity steppers and remove links. Both work without
  JS (they post to /cart/change); yk-cart.js upgrades them to AJAX and re-renders
  this section plus the footer and the header count.
  Styles: assets/section-cart.css
{%- endcomment -%}

{{ 'section-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yk-cart.js' | asset_url }}" defer="defer"></script>
{% render 'yk-section-style', section: section %}

<div
  class="yk-section"
  id="YkCartItems-{{ section.id }}"
  data-yk-cart-section
  data-yk-section-id="{{ section.id }}"
>
  <div class="yk-page-width">
    <h1 class="yk-section__heading">{{ 'cart.general.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="yk-cart__empty">
        <p>{{ 'cart.general.empty' | t }}</p>
        <a class="yk-btn" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate class="yk-cart" data-yk-cart-form>
        <table class="yk-cart__table">
          <caption class="yk-visually-hidden">{{ 'cart.general.title' | t }}</caption>
          <thead>
            <tr>
              <th scope="col">{{ 'cart.label.product' | t }}</th>
              <th scope="col">{{ 'cart.label.quantity' | t }}</th>
              <th scope="col" class="yk-cart__cell--right">{{ 'cart.label.total' | t }}</th>
            </tr>
          </thead>

          <tbody>
            {%- for line_item in cart.items -%}
              <tr class="yk-cart__row" data-yk-cart-line="{{ forloop.index }}" data-yk-key="{{ line_item.key }}">
                <td class="yk-cart__cell yk-cart__cell--product">
                  <a class="yk-cart__media" href="{{ line_item.url }}" aria-hidden="true" tabindex="-1">
                    {%- if line_item.image -%}
                      {{
                        line_item.image
                        | image_url: width: 200
                        | image_tag:
                          class: 'yk-cart__image',
                          widths: '100,200',
                          alt: line_item.title,
                          loading: 'lazy',
                          decoding: 'async'
                      }}
                    {%- endif -%}
                  </a>

                  <div class="yk-cart__details">
                    <a class="yk-cart__title" href="{{ line_item.url }}">{{ line_item.product.title | escape }}</a>

                    {%- unless line_item.variant.title contains 'Default' -%}
                      <span class="yk-cart__variant">{{ line_item.variant.title | escape }}</span>
                    {%- endunless -%}

                    {%- if line_item.selling_plan_allocation -%}
                      <span class="yk-cart__variant">{{ line_item.selling_plan_allocation.selling_plan.name }}</span>
                    {%- endif -%}

                    {%- if line_item.properties -%}
                      {%- for property in line_item.properties -%}
                        {%- unless property.last == blank or property.first[0] == '_' -%}
                          <span class="yk-cart__variant">{{ property.first }}: {{ property.last }}</span>
                        {%- endunless -%}
                      {%- endfor -%}
                    {%- endif -%}

                    <span class="yk-cart__unit-price">
                      {%- if line_item.original_price != line_item.final_price -%}
                        <s>{% render 'yk-price', price: line_item.original_price %}</s>
                        {% render 'yk-price', price: line_item.final_price %}
                      {%- else -%}
                        {% render 'yk-price', price: line_item.final_price %}
                      {%- endif -%}
                    </span>

                    {%- if line_item.line_level_discount_allocations.size > 0 -%}
                      <ul class="yk-cart__discounts">
                        {%- for allocation in line_item.line_level_discount_allocations -%}
                          <li>
                            {{ allocation.discount_application.title }}
                            (−{% render 'yk-price', price: allocation.amount %})
                          </li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    {%- if line_item.error_message -%}
                      <p class="yk-form-note yk-form-note--error" role="alert">{{ line_item.error_message }}</p>
                    {%- endif -%}
                  </div>
                </td>

                <td class="yk-cart__cell yk-cart__cell--quantity">
                  <div class="yk-qty" data-yk-cart-qty>
                    <button
                      type="button"
                      class="yk-qty__btn"
                      aria-label="{{ 'products.product.quantity.decrease' | t }}"
                      data-yk-cart-minus
                    >&minus;</button>

                    <label class="yk-visually-hidden" for="YkCartQty-{{ forloop.index }}">
                      {{ 'products.product.quantity.label' | t }}
                    </label>
                    <input
                      class="yk-qty__input"
                      id="YkCartQty-{{ forloop.index }}"
                      type="number"
                      name="updates[]"
                      value="{{ line_item.quantity }}"
                      min="0"
                      {% if line_item.variant.inventory_management and line_item.variant.inventory_policy == 'deny' %}
                        max="{{ line_item.variant.inventory_quantity }}"
                      {% endif %}
                      inputmode="numeric"
                      data-yk-cart-input
                      data-index="{{ forloop.index }}"
                    >

                    <button
                      type="button"
                      class="yk-qty__btn"
                      aria-label="{{ 'products.product.quantity.increase' | t }}"
                      data-yk-cart-plus
                    >+</button>
                  </div>

                  <a
                    class="yk-cart__remove"
                    href="{{ line_item.url_to_remove }}"
                    aria-label="{{ 'cart.label.remove' | t }}: {{ line_item.title | escape }}"
                    data-yk-cart-remove
                    data-index="{{ forloop.index }}"
                  >{{ 'cart.label.remove' | t }}</a>
                </td>

                <td class="yk-cart__cell yk-cart__cell--right">
                  <span class="yk-cart__line-total">
                    {% render 'yk-price', price: line_item.final_line_price %}
                  </span>
                </td>
              </tr>
            {%- endfor -%}
          </tbody>
        </table>

        {%- comment -%} no-JS fallback for quantity edits {%- endcomment -%}
        <noscript>
          <button type="submit" name="update" class="yk-btn yk-btn--sm">{{ 'cart.general.update' | t }}</button>
        </noscript>
      </form>

      <p class="yk-visually-hidden" role="status" aria-live="polite" data-yk-cart-status></p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Cart items",
  "tag": "section",
  "class": "yk-section-cart-items",
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 }
  ]
}
{% endschema %}
