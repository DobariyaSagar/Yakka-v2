{{ 'section-homepage-hero.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="yakka-hero-section">

{%- comment -%} ======== ANNOUNCEMENT BAR ======== {%- endcomment -%}
<div class="ann">
  <span><span class="dot"></span> {{ section.settings.ann_1 }}</span>
  <span class="live">● {{ section.settings.ann_2 }}</span>
  <span><span class="dot"></span> {{ section.settings.ann_3 }}</span>
</div>

{%- comment -%} ======== HERO ======== {%- endcomment -%}
<div class="wrap">
  <section class="hero">
    <div>
      <span class="instock"><i></i> {{ section.settings.hero_badge }}</span>
      <h1>{{ section.settings.hero_heading }}</h1>
      <p class="lede">{{ section.settings.hero_subtext }}</p>
      <div class="rate"><span class="s">★★★★★</span> <b style="color:var(--text);font-weight:600">{{ section.settings.hero_rating }}</b> {{ section.settings.hero_rating_text }}</div>
      <div class="hero-cta">
        <a class="btn" href="{{ section.settings.hero_btn_url }}">{{ section.settings.hero_btn_text }}</a>
        <a class="btn btn-ghost" href="{{ section.settings.hero_btn2_url }}">{{ section.settings.hero_btn2_text }}</a>
      </div>
      <div class="microc"><span>◦ Free express shipping</span><span>◦ 60-day money back</span><span>◦ AU &amp; NZ support</span></div>
    </div>
    <div class="hero-media">
      <div class="chip a"><b>45 min</b><span>Pack to piping hot</span></div>
      <div class="chip b"><b>100%</b><span>Cordless — no outlet</span></div>
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 800 }}" alt="{{ section.settings.hero_heading | escape }}" loading="lazy">
      {%- else -%}
        <img src="{{ 'yakka-hero-1.jpg' | asset_url }}" alt="Yakka Essential Hero" loading="lazy">
      {%- endif -%}
    </div>
  </section>
</div>

{%- comment -%} ======== MARQUEE ======== {%- endcomment -%}
<div class="marq">
  <ul>
    <li>Completely cordless</li><li>Rugged, leak-proof shell</li><li>Free insulated carry bag</li>
    <li>Stainless inner, dishwasher safe</li><li>Australian owned &amp; supported</li>
  </ul>
</div>


{%- comment -%} ======== STATS ======== {%- endcomment -%}
<div class="wrap">
  <div class="stats">
    <ul>
      <li><b>1,200+</b>Verified 5-star reviews</li>
      <li><b>45 min</b>Cold to piping hot</li>
      <li><b>1.5 L</b>Generous capacity</li>
      <li><b>100%</b>Cordless — no power needed</li>
    </ul>
  </div>
</div>

{%- comment -%} ======== FEATURE ======== {%- endcomment -%}
<div class="wrap sec">
  <div class="feature">
    {%- if section.settings.feature_image != blank -%}
      <img src="{{ section.settings.feature_image | image_url: width: 700 }}" alt="{{ section.settings.feature_heading | escape }}" loading="lazy">
    {%- else -%}
      <img src="{{ 'yakka-hero-2.jpg' | asset_url }}" alt="Feature" loading="lazy">
    {%- endif -%}
    <div>
      <span class="eyebrow">{{ section.settings.feature_eyebrow }}</span>
      <h2>{{ section.settings.feature_heading }}</h2>
      <p>{{ section.settings.feature_text }}</p>
      <div style="margin-top:28px">
        <a class="btn" href="{{ section.settings.feature_btn_url }}">{{ section.settings.feature_btn_text }}</a>
      </div>
    </div>
  </div>
</div>

{%- comment -%} ======== HOW IT WORKS ======== {%- endcomment -%}
<div class="wrap sec center">
  <span class="eyebrow">How it works</span>
  <h2 style="margin:16px auto 0">Four steps. Hot food.</h2>
  <div class="steps">
    <div class="step">
      <span class="n">1</span>
      <span class="tag">Evening</span>
      <h3>Charge it</h3>
      <p>Plug in the battery pack before bed. A full charge takes ~3 hrs and lasts 2 heating cycles.</p>
    </div>
    <div class="step">
      <span class="n">2</span>
      <span class="tag">Morning</span>
      <h3>Pack it</h3>
      <p>Load yesterday's leftovers, curries, pasta, stew — anything you'd microwave. Seal it up.</p>
    </div>
    <div class="step">
      <span class="n">3</span>
      <span class="tag">Smoko</span>
      <h3>Press start</h3>
      <p>Hit the single button 10–15 min before break. The even-heat base warms everything uniformly.</p>
    </div>
    <div class="step">
      <span class="n">4</span>
      <span class="tag">Lunchtime</span>
      <h3>Eat properly</h3>
      <p>Open the lid to steam and a piping-hot, home-cooked meal. No queue. No microwave.</p>
    </div>
  </div>
</div>

{%- comment -%} ======== BUY SECTION ======== {%- endcomment -%}
<div class="wrap sec">
  <div class="buy">
    <div>
      <div class="gallery">
        <span class="flag">Best seller</span>
        {%- if section.settings.product_image != blank -%}
          <img src="{{ section.settings.product_image | image_url: width: 700 }}" alt="Product" loading="lazy">
        {%- else -%}
          <img src="{{ 'yakka-hero-3.jpg' | asset_url }}" alt="Product" loading="lazy">
        {%- endif -%}
      </div>
      <div class="thumbs">
        <div><img src="{{ 'yakka-hero-4.jpg' | asset_url }}" alt="thumb1" loading="lazy"></div>
        <div><img src="{{ 'yakka-hero-5.jpg' | asset_url }}" alt="thumb2" loading="lazy"></div>
        <div><img src="{{ 'yakka-hero-6.jpg' | asset_url }}" alt="thumb3" loading="lazy"></div>
        <div><img src="{{ 'yakka-hero-7.jpg' | asset_url }}" alt="thumb4" loading="lazy"></div>
      </div>
    </div>
    <div>
      <span class="eyebrow">Yakka Essential</span>
      <div class="price">
        <span class="now">{{ section.settings.product_price }}</span>
        <span class="was">{{ section.settings.product_compare_price }}</span>
        <span class="save">{{ section.settings.product_save_text }}</span>
      </div>
      <p class="afterpay">or 4 interest-free payments with Afterpay</p>
      <p style="font-size:15px;line-height:1.6;margin-bottom:6px">Colour</p>
      <div class="swatches">
        <div class="sw on"><span class="dot" style="background:#9A8A74"></span> Warm Steel</div>
        <div class="sw"><span class="dot" style="background:#2C2C2C"></span> Carbon Black</div>
      </div>
      <ul class="specs">
        <li><span>Capacity</span><span>1.5 L</span></li>
        <li><span>Heat time</span><span>≈ 45 min</span></li>
        <li><span>Power</span><span>Cordless / USB-C</span></li>
        <li><span>Inner pot</span><span>304 stainless steel</span></li>
        <li><span>Weight</span><span>1.2 kg</span></li>
      </ul>
      <div class="buy-row">
        <div class="qty"><span>−</span><b>1</b><span>+</span></div>
        <a class="btn" href="{{ section.settings.hero_btn_url }}" style="flex:1">Add to cart — {{ section.settings.product_price }}</a>
      </div>
      <div class="assure">
        <span>🚚 Free express shipping</span>
        <span>↩ 60-day returns</span>
        <span>🔒 Secure checkout</span>
      </div>
    </div>
  </div>
</div>

{%- comment -%} ======== STICKY BAR ======== {%- endcomment -%}
<div class="stickybar">
  <img src="{{ 'yakka-hero-8.jpg' | asset_url }}" alt="Yakka Essential">
  <div class="t">
    <b>Yakka Essential — Warm Steel</b>
    <span>{{ section.settings.product_price }} <s style="color:var(--text-2)">{{ section.settings.product_compare_price }}</s></span>
  </div>
  <a class="btn" href="{{ section.settings.hero_btn_url }}">Add to cart</a>
</div>
<div class="sb-label">Scroll to discover more ↓</div>

{%- comment -%} ======== WHAT'S IN THE BOX ======== {%- endcomment -%}
<div class="wrap sec center">
  <span class="eyebrow">What's in the box</span>
  <h2 style="margin:16px auto 0">Everything you need. Nothing you don't.</h2>
  <div class="kit">
    <div><b>1</b><div><h3>Heated lunchbox</h3><p>1.5 L 304 stainless-steel inner pot with sealed lid</p></div></div>
    <div><b>2</b><div><h3>Battery pack</h3><p>Rechargeable Li-ion pack — 2 full heating cycles per charge</p></div></div>
    <div><b>3</b><div><h3>USB-C cable</h3><p>Standard USB-C charging cable for the battery pack</p></div></div>
    <div><b>4</b><div><h3>Carry bag</h3><p>Insulated zip bag that keeps your lunchbox hot &amp; upright</p></div></div>
    <div><b>5</b><div><h3>Cutlery set</h3><p>Stainless-steel fork, spoon &amp; chopsticks in a travel sleeve</p></div></div>
    <div><b>6</b><div><h3>User guide</h3><p>Quick-start card with charging, heating &amp; care instructions</p></div></div>
  </div>
</div>

{%- comment -%} ======== COMPARISON TABLE ======== {%- endcomment -%}
