        <tr><td class="lab">Under $150</td><td class="win tick">✓</td><td>✓</td><td>✓</td></tr>
      </tbody>
    </table>
  </div>
</div>

{%- comment -%} ======== GUARANTEE ======== {%- endcomment -%}
