{%- comment -%}
  Section: stats-bar — proof numbers in a bordered row.
  Styles: assets/section-stats.css
{%- endcomment -%}

{{ 'section-stats.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-stats-size: {{ section.settings.value_size }}px;
    --yk-stats-pad: {{ section.settings.row_padding }}px;
  }
{% endstyle %}

{%- if section.blocks.size > 0 -%}
  <div class="yk-page-width">
    <div class="yk-stats">
      <ul class="yk-stats__list">
        {%- for block in section.blocks -%}
          <li class="yk-stats__item" {{ block.shopify_attributes }}>
            <b class="yk-stats__value">{{ block.settings.value }}</b>
            {{ block.settings.label }}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Stats bar",
  "tag": "section",
  "class": "yk-section-stats",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "row_padding", "label": "Row padding", "min": 12, "max": 96, "step": 4, "unit": "px", "default": 44 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Background" },
    { "type": "color", "id": "color_heading", "label": "Values", "default": "#1A1815" },
    { "type": "color", "id": "color_text", "label": "Labels", "default": "#6B6660" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "value_size", "label": "Value size", "min": 20, "max": 60, "step": 1, "unit": "px", "default": 34 }
  ],
  "blocks": [
    { "type": "stat", "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "10,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Workers eating hot on site" }
      ] }
  ],
  "presets": [
    { "name": "Stats bar",
      "blocks": [
        { "type": "stat", "settings": { "value": "10,000+", "label": "Workers eating hot on site" } },
        { "type": "stat", "settings": { "value": "4.8 / 5", "label": "From 1,200+ reviews" } },
        { "type": "stat", "settings": { "value": "60 days", "label": "Money back, keep the unit" } },
        { "type": "stat", "settings": { "value": "AU & NZ", "label": "Owned, stocked, supported" } }
      ] }
  ]
}
{% endschema %}
