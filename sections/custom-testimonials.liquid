<style>
  .custom-testimonials-{{ section.id }} {
    --t-text: {{ section.settings.heading_color }};
    --t-text-2: {{ section.settings.subtitle_color }};
    --t-accent: {{ section.settings.eyebrow_color }};
    --t-star: {{ section.settings.star_color }};
    --t-surface: {{ section.settings.card_bg }};
    --t-border: #E8E4DF;
    --t-verified: #7B7672;
    --t-max: 1180px;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    -webkit-font-smoothing: antialiased;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.bg_color }};
  }
  .custom-testimonials-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
  .custom-testimonials-{{ section.id }} .t-wrap { max-width: var(--t-max); margin: 0 auto; padding: 0 24px; }

  /* ── Header ── */
  .custom-testimonials-{{ section.id }} .t-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 48px;
  }
  .custom-testimonials-{{ section.id }} .t-eyebrow {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: .18em;
    text-transform: uppercase;
    color: var(--t-accent);
    margin-bottom: 14px;
  }
  .custom-testimonials-{{ section.id }} .t-heading {
    font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
    font-weight: 400;
    font-size: 42px;
    color: var(--t-text);
    letter-spacing: -.02em;
    line-height: 1.15;
    max-width: 640px;
  }

  /* ── Grid ── */
  .custom-testimonials-{{ section.id }} .t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* ── Card ── */
  .custom-testimonials-{{ section.id }} .t-card {
    background: var(--t-surface);
    border-radius: 14px;
    border: 1px solid var(--t-border);
    padding: 28px 26px 26px;
    display: flex;
    flex-direction: column;
    transition: box-shadow .3s ease, transform .3s ease;
  }
  .custom-testimonials-{{ section.id }} .t-card:hover {
    box-shadow: 0 8px 30px rgba(0,0,0,.06);
    transform: translateY(-3px);
  }

  /* ── Stars ── */
  .custom-testimonials-{{ section.id }} .t-stars {
    display: flex;
    gap: 3px;
    margin-bottom: 18px;
  }
  .custom-testimonials-{{ section.id }} .t-stars svg {
    width: 15px;
    height: 15px;
    fill: var(--t-accent);
  }

  /* ── Quote ── */
  .custom-testimonials-{{ section.id }} .t-quote {
    font-size: 15px;
    line-height: 1.6;
    color: var(--t-text);
    flex-grow: 1;
    margin-bottom: 24px;
  }

  /* ── Author row ── */
  .custom-testimonials-{{ section.id }} .t-author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
  }
  .custom-testimonials-{{ section.id }} .t-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    background: #E8E4DF;
  }
  .custom-testimonials-{{ section.id }} .t-avatar-placeholder {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    flex-shrink: 0;
    background: linear-gradient(135deg, #E8E4DF, #D4CFC8);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .custom-testimonials-{{ section.id }} .t-avatar-placeholder svg {
    width: 18px;
    height: 18px;
    fill: #9B9590;
  }
  .custom-testimonials-{{ section.id }} .t-author-info {
    display: flex;
    flex-direction: column;
  }
  .custom-testimonials-{{ section.id }} .t-author-name {
    font-size: 14px;
    font-weight: 700;
    color: var(--t-text);
    line-height: 1.3;
  }
  .custom-testimonials-{{ section.id }} .t-author-label {
    font-size: 13px;
    color: var(--t-verified);
    line-height: 1.3;
  }

  /* ── Responsive ── */
  @media (max-width: 960px) {
    .custom-testimonials-{{ section.id }} .t-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
    .custom-testimonials-{{ section.id }} .t-heading {
      font-size: 34px;
    }
  }
  @media (max-width: 640px) {
    .custom-testimonials-{{ section.id }} .t-grid {
      grid-template-columns: 1fr;
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: 16px;
      padding-bottom: 8px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .custom-testimonials-{{ section.id }} .t-grid::-webkit-scrollbar {
      display: none;
    }
    .custom-testimonials-{{ section.id }} .t-card {
      max-width: 90%;
      flex-shrink: 0;
      scroll-snap-align: start;
    }
    .custom-testimonials-{{ section.id }} .t-heading {
      font-size: 28px;
    }
    .custom-testimonials-{{ section.id }} .t-header {
      margin-bottom: 32px;
    }
    .custom-testimonials-{{ section.id }} {
      padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px;
    }
  }
</style>

<div class="custom-testimonials-{{ section.id }}">
  <div class="t-wrap">

    <div class="t-header">
      {% if section.settings.eyebrow != blank %}
        <span class="t-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="t-heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="t-grid">
        {% for block in section.blocks %}
          <div class="t-card" {{ block.shopify_attributes }}>

            {%- comment -%} Stars {%- endcomment -%}
            <div class="t-stars">
              {% for i in (1..block.settings.rating) %}
                <svg viewBox="0 0 24 24"><path d="M12 .587l3.668 7.568 8.332 1.151-6.064 5.828 1.48 8.279-7.416-3.967-7.417 3.967 1.481-8.279-6.064-5.828 8.332-1.151z"/></svg>
              {% endfor %}
            </div>

            {%- comment -%} Quote text {%- endcomment -%}
            {% if block.settings.text != blank %}
              <div class="t-quote">"{{ block.settings.text }}"</div>
            {% endif %}

            {%- comment -%} Author {%- endcomment -%}
            <div class="t-author-row">
              {% if block.settings.avatar != blank %}
                <img class="t-avatar" src="{{ block.settings.avatar | image_url: width: 100 }}" alt="{{ block.settings.author | escape }}" loading="lazy" width="40" height="40">
              {% else %}
                <div class="t-avatar-placeholder">
                  <svg viewBox="0 0 24 24"><path d="M12 12c2.761 0 5-2.239 5-5s-2.239-5-5-5-5 2.239-5 5 2.239 5 5 5zm0 2c-3.866 0-7 1.79-7 4v2h14v-2c0-2.21-3.134-4-7-4z"/></svg>
                </div>
              {% endif %}

              <div class="t-author-info">
                {% if block.settings.author != blank %}
                  <span class="t-author-name">{{ block.settings.author }}</span>
                {% endif %}
                {% if block.settings.label != blank %}
                  <span class="t-author-label">{{ block.settings.label }}</span>
                {% endif %}
              </div>
            </div>

          </div>
        {% endfor %}
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
{
  "name": "Custom Testimonials",
  "settings": [
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F4F0"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#1A1815"
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Subtitle Color",
      "default": "#6B6660"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow Color",
      "default": "#E8500F"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Color",
      "default": "#1A1815"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card Background",
      "default": "#FFFFFF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 80
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "REAL MORNINGS, REAL FEEDBACK"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by early risers and light sleepers alike"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Author Avatar"
        },
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Testimonial Text",
          "default": "My partner used to wake me up every morning without meaning to. Now I don't even hear him get up."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Isabella T."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Author Label",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "text": "My partner used to wake me up every morning without meaning to. Now I don't even hear him get up.",
            "author": "Isabella T.",
            "label": "Verified buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "I track my steps all day and it still wakes me up better than my phone ever did.",
            "author": "Dave M.",
            "label": "Verified buyer"
          }
        },
        {
          "type": "testimonial",
          "settings": {
            "text": "Simple to set up, no app, and the battery has lasted weeks so far.",
            "author": "Lily S.",
            "label": "Verified buyer"
          }
        }
      ]
    }
  ]
}
{% endschema %}
