{%- style -%}
.custom-faq-{{ section.id }} {
  --canvas: #F7F4EF;
  --text: #1A1815;
  --text-2: #6B6660;
  --border: #E3DDD4;
  --max: 820px;

  background: var(--canvas);
  color: var(--text);
  font-family: {{ settings.type_body_font.family }}, system-ui, sans-serif;
  font-style: {{ settings.type_body_font.style }};
  font-weight: {{ settings.type_body_font.weight }};
  font-size: 18px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  padding: 150px 0;
}

.custom-faq-{{ section.id }} * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.custom-faq-{{ section.id }} .wrap {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 24px;
}

.custom-faq-{{ section.id }} .center {
  text-align: center;
}

.custom-faq-{{ section.id }} h2 {
  font-family: {{ settings.type_header_font.family }}, Georgia, serif;
  font-style: {{ settings.type_header_font.style }};
  font-weight: {{ settings.type_header_font.weight }};
  font-size: 50px;
  line-height: 1.04;
  letter-spacing: -.025em;
  margin-bottom: 52px;
}

.custom-faq-{{ section.id }} .eyebrow {
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-2);
  display: block;
  margin-bottom: 16px;
}

.custom-faq-{{ section.id }} .faq-container {
  display: flex;
  flex-direction: column;
}

.custom-faq-{{ section.id }} details {
  border-bottom: 1px solid var(--border);
  padding: 26px 0;
  width: 100%;
}

.custom-faq-{{ section.id }} summary {
  font-family: {{ settings.type_body_font.family }}, system-ui, sans-serif;
  font-style: {{ settings.type_body_font.style }};
  font-weight: 600;
  font-size: 18px;
  letter-spacing: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  cursor: pointer;
  list-style: none;
  color: var(--text);
}

.custom-faq-{{ section.id }} summary::-webkit-details-marker {
  display: none;
}

.custom-faq-{{ section.id }} summary::after {
  content: "+";
  font-weight: normal;
  color: var(--text-2);
  font-size: 20px;
  transition: transform 0.2s ease;
}

.custom-faq-{{ section.id }} details[open] summary::after {
  content: "-";
}

.custom-faq-{{ section.id }} p {
  font-size: 16px;
  color: var(--text-2);
  text-align: left;
  margin-top: 12px;
  line-height: 1.6;
}

@media(max-width:1024px){
  .custom-faq-{{ section.id }} h2 {
    font-size: 36px;
  }
}

@media(max-width:600px){
  .custom-faq-{{ section.id }} h2 {
    font-size: 28px;
  }
}
{%- endstyle -%}

<div class="custom-faq-{{ section.id }}">
  <div class="wrap center">
    <span class="eyebrow">{{ section.settings.eyebrow }}</span>
    <h2>{{ section.settings.heading }}</h2>
    <div class="faq-container">
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          <details {% if forloop.first and section.settings.open_first %}open{% endif %}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom FAQ Accordion",
  "tag": "section",
  "class": "section-custom-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Common questions."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open First Question by Default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Question text goes here?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "Answer text goes here."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ Accordion",
      "blocks": [
        {
          "type": "faq_item",
          "settings": {
            "question": "How long does it take to heat my food?",
            "answer": "Approximately 45 minutes from cold to piping hot (75 °C+), depending on the type and volume of food. Denser meals like rice and stew may take slightly longer."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "Do I need to plug it in to heat?",
            "answer": "No. The Yakka Essential is 100 % cordless. The detachable battery pack powers the heating element — no outlet, no inverter, no generator required."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What foods can I heat?",
            "answer": "Anything you'd normally microwave — rice, pasta, curries, stews, soup, casseroles, stir-fry. Avoid raw meats; this is a reheater, not a cooker."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "How do I clean it?",
            "answer": "The 304 stainless-steel inner pot lifts out and is hand-washable. Wipe the base unit with a damp cloth. Do not submerge the base or battery."
          }
        },
        {
          "type": "faq_item",
          "settings": {
            "question": "What's the return policy?",
            "answer": "60-day money-back guarantee. If you're not satisfied, send it back for a full refund — we even cover return postage within Australia."
          }
        }
      ]
    }
  ]
}
{% endschema %}
