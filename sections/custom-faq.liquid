<style>
.custom-faq-{{ section.id }} {
  --text:#1A1815;
  --text-2:#6B6660;
  --border:#E3DDD4;
  --max:1180px;
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  -webkit-font-smoothing: antialiased;
  padding: 64px 0;
}
.custom-faq-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
.custom-faq-{{ section.id }} .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; text-align: center; }

.custom-faq-{{ section.id }} .eyebrow {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-2);
}
.custom-faq-{{ section.id }} h2 {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-weight: 400;
  font-size: 48px;
  color: var(--text);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin-top: 12px;
  max-width: 18ch;
  margin-left: auto;
  margin-right: auto;
}

.custom-faq-{{ section.id }} .faq {
  max-width: 820px;
  margin: 52px auto 0;
  text-align: left;
}
.custom-faq-{{ section.id }} .faq details {
  border-bottom: 1px solid var(--border);
  padding: 26px 0;
}
.custom-faq-{{ section.id }} .faq summary {
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  font-size: 18px;
  font-weight: 600;
  letter-spacing: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  cursor: pointer;
  list-style: none;
  color: var(--text);
}
.custom-faq-{{ section.id }} .faq summary::-webkit-details-marker {
  display: none;
}
.custom-faq-{{ section.id }} .faq summary span {
  color: var(--text-2);
  font-weight: 400;
  font-size: 28px;
  line-height: 1;
  transition: transform 0.2s ease;
  display: inline-block;
}
.custom-faq-{{ section.id }} .faq details[open] summary span {
  transform: rotate(45deg);
}
.custom-faq-{{ section.id }} .faq p {
  font-size: 16px;
  color: var(--text-2);
  max-width: none;
  text-align: left;
  margin: 0;
  margin-top: 16px;
  line-height: 1.6;
}
</style>

<div class="custom-faq-{{ section.id }}">
  <div class="wrap">
    {% if section.settings.subheading != blank %}
      <span class="eyebrow">{{ section.settings.subheading }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    <div class="faq">
      {% for block in section.blocks %}
        <details {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }} <span>+</span></summary>
          <p>{{ block.settings.answer }}</p>
        </details>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom FAQ",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Got questions?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Everything you need to know."
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does a cordless heated lunchbox work?"
        },
        {
          "type": "textarea",
          "id": "answer",
          "label": "Answer",
          "default": "A built-in rechargeable battery warms your food gently and evenly. Press start, or set the timer and let it come up to temperature while you work."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom FAQ",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "How does a cordless heated lunchbox work?", "answer": "A built-in rechargeable battery warms your food gently and evenly. Press start, or set the timer and let it come up to temperature while you work." } },
        { "type": "faq_item", "settings": { "question": "How long does the battery last?", "answer": "Two to three full heating cycles per charge — comfortably a full workday, and most blokes get two or three days out of one charge." } },
        { "type": "faq_item", "settings": { "question": "Do I need power on site?", "answer": "No. That's the whole point. Charge it at home overnight and it runs entirely off its own battery all day." } },
        { "type": "faq_item", "settings": { "question": "Will it leak in my toolbox?", "answer": "The stainless inner seals shut and the outer shell is impact-rated. It's built to be thrown in the tray, not carried carefully." } },
        { "type": "faq_item", "settings": { "question": "Is it easy to clean?", "answer": "The stainless container lifts out and goes straight in the dishwasher. Wipe the outer shell down and you're done." } },
        { "type": "faq_item", "settings": { "question": "What if I don't like it?", "answer": "Sixty days, full refund, and you keep the unit — you don't pay return freight." } }
      ]
    }
  ]
}
{% endschema %}
