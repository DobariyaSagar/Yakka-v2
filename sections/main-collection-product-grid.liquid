{%- comment -%}
  Section: main-collection-product-grid
  Facets (filter + sort) above a product grid, paginated.
  Filtering and sorting work without JS — the form GETs the collection URL.
  yk-facets.js upgrades that to fetch + swap this section via the Section
  Rendering API, so results update without a reload.
  Styles: assets/section-collection.css + assets/component-card-product.css
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card-product.css' | asset_url | stylesheet_tag }}
{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  <script src="{{ 'yk-facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{%- if section.settings.enable_quick_add -%}
  <script src="{{ 'yk-cart.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-grid-gap-x: {{ section.settings.grid_gap_horizontal | default: settings.spacing_grid_horizontal }}px;
    --yk-grid-gap-y: {{ section.settings.grid_gap_vertical | default: settings.spacing_grid_vertical }}px;
  }
{% endstyle %}

<div class="yk-section" id="YkCollection-{{ section.id }}" data-yk-section-id="{{ section.id }}">
  <div class="yk-page-width">

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      {% render 'facets',
        results: collection,
        section_id: section.id,
        enable_filtering: section.settings.enable_filtering,
        enable_sorting: section.settings.enable_sorting,
        filter_layout: section.settings.filter_layout
      %}
    {%- endif -%}

    <div class="yk-collection__results" data-yk-facet-results>
      {%- paginate collection.products by section.settings.products_per_page -%}
        {%- if collection.products.size == 0 -%}
          <div class="yk-collection__empty">
            <p>{{ 'collections.general.no_matches' | t }}</p>
            <a class="yk-btn yk-btn--ghost" href="{{ collection.url }}">
              {{ 'products.facets.clear_all' | t }}
            </a>
          </div>
        {%- else -%}
          <ul class="yk-product-grid" role="list">
            {%- for product in collection.products -%}
              <li class="yk-product-grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  quick_add: section.settings.enable_quick_add,
                  lazy_load: forloop.index0 >= section.settings.columns_desktop,
                  section_id: section.id
                %}
              </li>
            {%- endfor -%}
          </ul>

          {%- if paginate.pages > 1 -%}
            <nav class="yk-pagination" role="navigation" aria-label="{{ 'general.pagination.label' | t }}">
              {%- if paginate.previous -%}
                <a class="yk-pagination__link" href="{{ paginate.previous.url }}" rel="prev">
                  {{ 'general.pagination.previous' | t }}
                </a>
              {%- endif -%}

              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="yk-pagination__link" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="yk-pagination__link is-current" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="yk-pagination__link is-gap">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}

              {%- if paginate.next -%}
                <a class="yk-pagination__link" href="{{ paginate.next.url }}" rel="next">
                  {{ 'general.pagination.next' | t }}
                </a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product grid",
  "tag": "section",
  "class": "yk-section-collection",
  "settings": [
    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "grid_gap_horizontal", "label": "Horizontal gap", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "grid_gap_vertical", "label": "Vertical gap", "min": 4, "max": 60, "step": 2, "unit": "px", "default": 40 },

    { "type": "header", "content": "Product card" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1/1",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ] },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_rating", "label": "Show product rating", "default": false,
      "info": "Needs a review app that writes the standard rating metafields." },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add to cart", "default": true },

    { "type": "header", "content": "Filtering and sorting" },
    { "type": "checkbox", "id": "enable_filtering", "label": "Enable filtering", "default": true,
      "info": "Filters come from Search & Discovery in the admin." },
    { "type": "select", "id": "filter_layout", "label": "Filter layout", "default": "horizontal",
      "options": [
        { "value": "horizontal", "label": "Horizontal" },
        { "value": "vertical", "label": "Sidebar" }
      ] },
    { "type": "checkbox", "id": "enable_sorting", "label": "Enable sorting", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ]
}
{% endschema %}
