<style>
.custom-hero-{{ section.id }} {
  --canvas:#F7F4EF; --surface:#FFFFFF; --contrast:#17150F;
  --text:#1A1815; --text-2:#6B6660; --text-3:#4A4640;
  --border:#E3DDD4; --accent:#E8500F; --accent-2:#FF8A2B; --tint:#FBEDE6; --ink:#2E4A3F;
  --max:1180px;
  background: var(--canvas);
  color: var(--text);
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  font-size: 18px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}
.custom-hero-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
.custom-hero-{{ section.id }} .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
.custom-hero-{{ section.id }} h1, .custom-hero-{{ section.id }} h2, .custom-hero-{{ section.id }} h3 { font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }}; font-weight: 400; letter-spacing: -.025em; line-height: 1.02; }
.custom-hero-{{ section.id }} h1 { font-size: 88px; }
.custom-hero-{{ section.id }} p { color: var(--text-3); max-width: 62ch; }
.custom-hero-{{ section.id }} .btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 60px; padding: 0 36px; background: var(--accent); color: #fff; font-size: 16px; font-weight: 600; text-decoration: none; border: 0; border-radius: 5px; box-shadow: 0 10px 26px -12px rgba(232,80,15,.75); }
.custom-hero-{{ section.id }} .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); box-shadow: none; }
.custom-hero-{{ section.id }} .hero { display: grid; grid-template-columns: 1.06fr .94fr; gap: 56px; align-items: center; padding: 88px 0 96px; }
@media (max-width: 1024px) {
  .custom-hero-{{ section.id }} h1 { font-size: 64px; }
}
@media (max-width: 900px) {
  .custom-hero-{{ section.id }} .hero { grid-template-columns: 1fr; padding: 40px 0; gap: 40px; }
  .custom-hero-{{ section.id }} .hero-media { max-width: 560px; margin: 0 auto; width: 100%; }
  .custom-hero-{{ section.id }} .chip { padding: 12px 16px; }
  .custom-hero-{{ section.id }} .chip b { font-size: 22px; }
  .custom-hero-{{ section.id }} .chip.a { left: -16px; top: 12%; }
  .custom-hero-{{ section.id }} .chip.b { right: -16px; bottom: 10%; }
}
@media (max-width: 600px) {
  .custom-hero-{{ section.id }} { font-size: 16px; }
  .custom-hero-{{ section.id }} h1 { font-size: 46px; margin: 16px 0 20px; }
  .custom-hero-{{ section.id }} .hero .lede { font-size: 18px; margin-bottom: 24px; }
  .custom-hero-{{ section.id }} .hero-cta { flex-direction: column; align-items: stretch; gap: 12px; }
  .custom-hero-{{ section.id }} .btn { width: 100%; }
  .custom-hero-{{ section.id }} .chip.a { left: 8px; top: 8%; }
  .custom-hero-{{ section.id }} .chip.b { right: 8px; bottom: 6%; }
}
.custom-hero-{{ section.id }} .hero h1 { margin: 20px 0 26px; }
.custom-hero-{{ section.id }} .hero h1 em { font-style: italic; color: var(--accent); }
.custom-hero-{{ section.id }} .hero .lede { font-size: 20px; margin-bottom: 34px; }
.custom-hero-{{ section.id }} .rate { display: flex; align-items: center; gap: 14px; margin-bottom: 30px; font-size: 14px; color: var(--text-2); }
.custom-hero-{{ section.id }} .rate .s { color: var(--accent); letter-spacing: .2em; font-size: 15px; }
.custom-hero-{{ section.id }} .rate strong { color: var(--text); font-weight: 600; }
.custom-hero-{{ section.id }} .hero-cta { display: flex; gap: 14px; align-items: center; margin-bottom: 26px; flex-wrap: wrap; }
.custom-hero-{{ section.id }} .microc { display: flex; gap: 24px; font-size: 13px; color: var(--text-2); flex-wrap: wrap; }
.custom-hero-{{ section.id }} .hero-media { position: relative; }
.custom-hero-{{ section.id }} .hero-media::before { content: ""; position: absolute; inset: -8% -10% -4% -6%; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,138,43,.34), rgba(255,138,43,0) 72%); filter: blur(6px); }
.custom-hero-{{ section.id }} .hero-media img { position: relative; width: 100%; aspect-ratio: 1/1.24; object-fit: cover; border-radius: 18px; display: block; }
{% if section.settings.image_height_auto %}
.custom-hero-{{ section.id }} .hero-media img { aspect-ratio: auto; }
{% endif %}
.custom-hero-{{ section.id }} .chip { position: absolute; z-index: 2; background: rgba(255,255,255,.94); backdrop-filter: blur(6px); border: 1px solid rgba(0,0,0,.06); border-radius: 12px; padding: 14px 18px; box-shadow: 0 18px 40px -20px rgba(26,24,21,.5); }
.custom-hero-{{ section.id }} .chip b { display: block; font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }}; font-size: 26px; letter-spacing: -.02em; line-height: 1; color: var(--text); }
.custom-hero-{{ section.id }} .chip span { font-size: 12px; color: var(--text-2); letter-spacing: .04em; }
.custom-hero-{{ section.id }} .chip.a { left: -34px; top: 16%; }
.custom-hero-{{ section.id }} .chip.b { right: -26px; bottom: 12%; }
.custom-hero-{{ section.id }} .instock { display: inline-flex; align-items: center; gap: 8px; background: #EAF6EE; color: #1F6B3D; border: 1px solid #CBE6D5; font-size: 12px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; padding: 8px 14px; border-radius: 100px; }
.custom-hero-{{ section.id }} .instock i { width: 7px; height: 7px; border-radius: 50%; background: #2FA35F; display: block; }
</style>

<div class="custom-hero-{{ section.id }}">
  <div class="wrap">
    <section class="hero">
      <div>
        {% if section.settings.stock_text != blank %}
          <span class="instock"><i></i> {{ section.settings.stock_text }}</span>
        {% endif %}
        
        {% if section.settings.headline != blank %}
          <h1>{{ section.settings.headline }}</h1>
        {% endif %}
        
        {% if section.settings.lede != blank %}
          <p class="lede">{{ section.settings.lede }}</p>
        {% endif %}
        
        {% if section.settings.rating_text != blank %}
          <div class="rate">
            <span class="s">★★★★★</span>
            {{ section.settings.rating_text }}
          </div>
        {% endif %}
        
        <div class="hero-cta">
          {% if section.settings.primary_btn_text != blank %}
            <a class="btn" href="{{ section.settings.primary_btn_link | default: '#' }}">{{ section.settings.primary_btn_text }}</a>
          {% endif %}
          {% if section.settings.secondary_btn_text != blank %}
            <a class="btn btn-ghost" href="{{ section.settings.secondary_btn_link | default: '#' }}">{{ section.settings.secondary_btn_text }}</a>
          {% endif %}
        </div>
        
        {% if section.settings.micro_text != blank %}
          <div class="microc">
            {{ section.settings.micro_text }}
          </div>
        {% endif %}
      </div>
      <div class="hero-media">
        {% if section.settings.chip_1_value != blank or section.settings.chip_1_label != blank %}
          <div class="chip a">
            <b>{{ section.settings.chip_1_value }}</b>
            <span>{{ section.settings.chip_1_label }}</span>
          </div>
        {% endif %}
        
        {% if section.settings.chip_2_value != blank or section.settings.chip_2_label != blank %}
          <div class="chip b">
            <b>{{ section.settings.chip_2_value }}</b>
            <span>{{ section.settings.chip_2_label }}</span>
          </div>
        {% endif %}
        
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy' }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {% endif %}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Custom Hero",
  "settings": [
    {
      "type": "text",
      "id": "stock_text",
      "label": "Stock Status Text",
      "default": "In stock — ships today"
    },
    {
      "type": "richtext",
      "id": "headline",
      "label": "Headline",
      "default": "<p>Hot food.<br>No microwave.<br><em>No queue.</em></p>"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede/Description",
      "default": "Charge it overnight, pack it in the morning, press start before smoko. The Yakka Essential is completely cordless — a proper hot feed anywhere the job takes you."
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "<p><strong>4.8</strong> from 1,200+ verified Aussie tradies</p>"
    },
    {
      "type": "text",
      "id": "primary_btn_text",
      "label": "Primary Button Text",
      "default": "Shop the Lunchbox — $139.99"
    },
    {
      "type": "url",
      "id": "primary_btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_text",
      "label": "Secondary Button Text",
      "default": "See how it works"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "richtext",
      "id": "micro_text",
      "label": "Micro Text List",
      "default": "<p><span>▼ Free express shipping</span><span>▼ 60-day money back</span><span>▼ AU &amp; NZ support</span></p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "checkbox",
      "id": "image_height_auto",
      "label": "Adapt to image",
      "info": "Use original image proportions instead of cropping.",
      "default": false
    },
    {
      "type": "header",
      "content": "Chip 1 (Left)"
    },
    {
      "type": "text",
      "id": "chip_1_value",
      "label": "Value",
      "default": "45 min"
    },
    {
      "type": "text",
      "id": "chip_1_label",
      "label": "Label",
      "default": "Pack to piping hot"
    },
    {
      "type": "header",
      "content": "Chip 2 (Right)"
    },
    {
      "type": "text",
      "id": "chip_2_value",
      "label": "Value",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "chip_2_label",
      "label": "Label",
      "default": "Cordless — no outlet"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero"
    }
  ]
}
{% endschema %}
