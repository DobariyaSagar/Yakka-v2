{%- style -%}
.custom-hero-{{ section.id }} {
  --canvas: #F7F4EF;
  --text: #1A1815;
  --text-2: #6B6660;
  --text-3: #4A4640;
  --border: #E3DDD4;
  --accent: #E8500F;
  --accent-2: #FF8A2B;
  --contrast: #17150F;
  --max: 1180px;

  background: var(--canvas);
  color: var(--text);
  font-family: {{ settings.type_body_font.family }}, system-ui, sans-serif;
  font-style: {{ settings.type_body_font.style }};
  font-weight: {{ settings.type_body_font.weight }};
  font-size: 18px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  padding: 88px 0 96px;
}

.custom-hero-{{ section.id }} * {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.custom-hero-{{ section.id }} .wrap {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 24px;
}

.custom-hero-{{ section.id }} h1 {
  font-family: {{ settings.type_header_font.family }}, Georgia, serif;
  font-style: {{ settings.type_header_font.style }};
  font-weight: {{ settings.type_header_font.weight }};
  font-size: 88px;
  letter-spacing: -.025em;
  line-height: 1.02;
  margin: 20px 0 26px;
}

.custom-hero-{{ section.id }} h1 em {
  font-style: italic;
  color: var(--accent);
}

.custom-hero-{{ section.id }} p.lede {
  color: var(--text-3);
  max-width: 62ch;
  font-size: 20px;
  margin-bottom: 34px;
}

.custom-hero-{{ section.id }} .btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  height: 60px;
  padding: 0 36px;
  background: var(--accent);
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  text-decoration: none;
  border: 0;
  border-radius: 5px;
  box-shadow: 0 10px 26px -12px rgba(232,80,15,.75);
  cursor: pointer;
}

.custom-hero-{{ section.id }} .btn-ghost {
  background: transparent;
  color: var(--text);
  border: 1px solid var(--border);
  box-shadow: none;
}

.custom-hero-{{ section.id }} .hero {
  display: grid;
  grid-template-columns: 1.06fr .94fr;
  gap: 56px;
  align-items: center;
}

.custom-hero-{{ section.id }} .rate {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 30px;
  font-size: 14px;
  color: var(--text-2);
}

.custom-hero-{{ section.id }} .rate .s {
  color: var(--accent);
  letter-spacing: .2em;
  font-size: 15px;
}

.custom-hero-{{ section.id }} .hero-cta {
  display: flex;
  gap: 14px;
  align-items: center;
  margin-bottom: 26px;
}

.custom-hero-{{ section.id }} .microc {
  display: flex;
  gap: 24px;
  font-size: 13px;
  color: var(--text-2);
}

.custom-hero-{{ section.id }} .hero-media {
  position: relative;
}

.custom-hero-{{ section.id }} .hero-media::before {
  content: "";
  position: absolute;
  inset: -8% -10% -4% -6%;
  border-radius: 50%;
  background: radial-gradient(closest-side,rgba(255,138,43,.34),rgba(255,138,43,0) 72%);
  filter: blur(6px);
}

.custom-hero-{{ section.id }} .hero-media img {
  position: relative;
  width: 100%;
  aspect-ratio: 1/1.24;
  object-fit: cover;
  border-radius: 18px;
  display: block;
}

.custom-hero-{{ section.id }} .chip {
  position: absolute;
  z-index: 2;
  background: rgba(255,255,255,.94);
  backdrop-filter: blur(6px);
  border: 1px solid rgba(0,0,0,.06);
  border-radius: 12px;
  padding: 14px 18px;
  box-shadow: 0 18px 40px -20px rgba(26,24,21,.5);
}

.custom-hero-{{ section.id }} .chip b {
  display: block;
  font-family: {{ settings.type_header_font.family }}, Georgia, serif;
  font-style: {{ settings.type_header_font.style }};
  font-weight: {{ settings.type_header_font.weight }};
  font-size: 26px;
  letter-spacing: -.02em;
  line-height: 1;
}

.custom-hero-{{ section.id }} .chip span {
  font-size: 12px;
  color: var(--text-2);
  letter-spacing: .04em;
}

.custom-hero-{{ section.id }} .chip.a {
  left: -34px;
  top: 16%;
}

.custom-hero-{{ section.id }} .chip.b {
  right: -26px;
  bottom: 12%;
}

.custom-hero-{{ section.id }} .instock {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #EAF6EE;
  color: #1F6B3D;
  border: 1px solid #CBE6D5;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 8px 14px;
  border-radius: 100px;
}

.custom-hero-{{ section.id }} .instock i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #2FA35F;
  display: block;
}

@media(max-width:1024px){
  .custom-hero-{{ section.id }} h1 {
    font-size: 56px;
  }
  .custom-hero-{{ section.id }} .hero {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .custom-hero-{{ section.id }} .chip.a {
    left: 10px;
  }
  .custom-hero-{{ section.id }} .chip.b {
    right: 10px;
  }
}

@media(max-width:600px){
  .custom-hero-{{ section.id }} h1 {
    font-size: 40px;
  }
  .custom-hero-{{ section.id }} .hero-cta {
    flex-direction: column;
    align-items: stretch;
  }
}
{%- endstyle -%}

<div class="custom-hero-{{ section.id }}">
  <div class="wrap">
    <section class="hero">
      <div>
        <span class="instock"><i></i> {{ section.settings.badge_text }}</span>
        <h1>{{ section.settings.heading }}</h1>
        <p class="lede">{{ section.settings.subtext }}</p>
        <div class="rate">
          <span class="s">★★★★★</span>
          <b style="color:var(--text);font-weight:600">{{ section.settings.rating }}</b>
          {{ section.settings.rating_text }}
        </div>
        <div class="hero-cta">
          <a class="btn" href="{{ section.settings.btn_1_url }}">{{ section.settings.btn_1_text }}</a>
          <a class="btn btn-ghost" href="{{ section.settings.btn_2_url }}">{{ section.settings.btn_2_text }}</a>
        </div>
        <div class="microc">
          {%- if section.settings.micro_1 != blank -%}<span>◦ {{ section.settings.micro_1 }}</span>{%- endif -%}
          {%- if section.settings.micro_2 != blank -%}<span>◦ {{ section.settings.micro_2 }}</span>{%- endif -%}
          {%- if section.settings.micro_3 != blank -%}<span>◦ {{ section.settings.micro_3 }}</span>{%- endif -%}
        </div>
      </div>
      <div class="hero-media">
        {%- if section.settings.chip_1_title != blank -%}
          <div class="chip a"><b>{{ section.settings.chip_1_title }}</b><span>{{ section.settings.chip_1_sub }}</span></div>
        {%- endif -%}
        {%- if section.settings.chip_2_title != blank -%}
          <div class="chip b"><b>{{ section.settings.chip_2_title }}</b><span>{{ section.settings.chip_2_sub }}</span></div>
        {%- endif -%}
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.heading | escape }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'yakka-hero-1.jpg' | asset_url }}" alt="Yakka Essential Hero" loading="lazy">
        {%- endif -%}
      </div>
    </section>
  </div>
</div>

{% schema %}
{
  "name": "Yakka Hero Banner",
  "tag": "section",
  "class": "section-custom-hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "In stock — ships today"
    },
    {
      "type": "html",
      "id": "heading",
      "label": "Heading",
      "default": "Hot food.<br>No microwave.<br><em>No queue.</em>"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Charge it overnight, pack it in the morning, press start before smoko. The Yakka Essential is completely cordless — a proper hot feed anywhere the job takes you."
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating Score",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Label",
      "default": "from 1,200+ verified Aussie tradies"
    },
    {
      "type": "text",
      "id": "btn_1_text",
      "label": "Primary Button Text",
      "default": "Shop the Lunchbox — $139.99"
    },
    {
      "type": "url",
      "id": "btn_1_url",
      "label": "Primary Button URL"
    },
    {
      "type": "text",
      "id": "btn_2_text",
      "label": "Secondary Button Text",
      "default": "See how it works"
    },
    {
      "type": "url",
      "id": "btn_2_url",
      "label": "Secondary Button URL"
    },
    {
      "type": "text",
      "id": "micro_1",
      "label": "Micro bullet 1",
      "default": "Free express shipping"
    },
    {
      "type": "text",
      "id": "micro_2",
      "label": "Micro bullet 2",
      "default": "60-day money back"
    },
    {
      "type": "text",
      "id": "micro_3",
      "label": "Micro bullet 3",
      "default": "AU & NZ support"
    },
    {
      "type": "header",
      "content": "Image & Badges"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Image"
    },
    {
      "type": "text",
      "id": "chip_1_title",
      "label": "Overlay Chip 1 Title",
      "default": "45 min"
    },
    {
      "type": "text",
      "id": "chip_1_sub",
      "label": "Overlay Chip 1 Subtitle",
      "default": "Pack to piping hot"
    },
    {
      "type": "text",
      "id": "chip_2_title",
      "label": "Overlay Chip 2 Title",
      "default": "100%"
    },
    {
      "type": "text",
      "id": "chip_2_sub",
      "label": "Overlay Chip 2 Subtitle",
      "default": "Cordless — no outlet"
    }
  ],
  "presets": [
    {
      "name": "Custom Hero Banner"
    }
  ]
}
{% endschema %}
