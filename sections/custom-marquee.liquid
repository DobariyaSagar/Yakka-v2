<style>
.custom-marquee-{{ section.id }} {
  --contrast:#17150F;
  --accent-2:#FF8A2B;
  background: var(--contrast);
  color: #EFE9DF;
  padding: 20px 0;
  overflow: hidden;
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  -webkit-font-smoothing: antialiased;
}
.custom-marquee-{{ section.id }} ul {
  display: flex;
  gap: 56px;
  list-style: none;
  justify-content: center;
  font-size: 14px;
  letter-spacing: .06em;
  white-space: nowrap;
  margin: 0;
  padding: 0;
}
.custom-marquee-{{ section.id }} li {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #CFC7BB;
}
.custom-marquee-{{ section.id }} li::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-2);
}
@media (max-width: 900px) {
  .custom-marquee-{{ section.id }} ul {
    justify-content: flex-start;
    animation: marquee-scroll-{{ section.id }} 20s linear infinite;
  }
}
@keyframes marquee-scroll-{{ section.id }} {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}
</style>

<div class="custom-marquee-{{ section.id }}">
  <ul>
    {% for block in section.blocks %}
      <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
    {% endfor %}
    
    {%- comment -%}
      Duplicate items for seamless scrolling on mobile if needed
    {%- endcomment -%}
    <style>
      @media (max-width: 900px) {
        .custom-marquee-{{ section.id }} ul::after {
          content: "";
          display: flex;
          gap: 56px;
        }
      }
    </style>
  </ul>
</div>

{% schema %}
{
  "name": "Custom Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "text",
      "name": "Marquee Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Completely cordless"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee",
      "blocks": [
        { "type": "text", "settings": { "text": "Completely cordless" } },
        { "type": "text", "settings": { "text": "Rugged, leak-proof shell" } },
        { "type": "text", "settings": { "text": "Free insulated carry bag" } },
        { "type": "text", "settings": { "text": "Stainless inner, dishwasher safe" } },
        { "type": "text", "settings": { "text": "Australian owned & supported" } }
      ]
    }
  ]
}
{% endschema %}
