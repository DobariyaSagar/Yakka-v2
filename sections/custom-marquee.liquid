{%- style -%}
.custom-marquee-{{ section.id }} {
  --contrast: #17150F;
  --accent-2: #FF8A2B;

  background: var(--contrast);
  color: #EFE9DF;
  padding: 20px 0;
  overflow: hidden;
  font-family: {{ settings.type_body_font.family }}, system-ui, sans-serif;
  font-style: {{ settings.type_body_font.style }};
  font-weight: {{ settings.type_body_font.weight }};
}

.custom-marquee-{{ section.id }} ul {
  display: flex;
  gap: 56px;
  list-style: none;
  justify-content: center;
  font-size: 14px;
  letter-spacing: .06em;
  white-space: nowrap;
  margin: 0;
  padding: 0;
}

.custom-marquee-{{ section.id }} li {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #CFC7BB;
}

.custom-marquee-{{ section.id }} li::before {
  content: "";
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-2);
}

@media(max-width:600px){
  .custom-marquee-{{ section.id }} {
    padding: 14px 0;
  }
  .custom-marquee-{{ section.id }} ul {
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
}
{%- endstyle -%}

<div class="custom-marquee-{{ section.id }}">
  <ul>
    {%- for block in section.blocks -%}
      {%- if block.settings.text != blank -%}
        <li>{{ block.settings.text }}</li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Yakka Marquee Ticker",
  "tag": "section",
  "class": "section-custom-marquee",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Ticker Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Text Item"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee Ticker",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "text": "Completely cordless"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Rugged, leak-proof shell"
          }
        },
        {
          "type": "item",
          "settings": {
            "text": "Free insulated carry bag"
          }
        },
        {
