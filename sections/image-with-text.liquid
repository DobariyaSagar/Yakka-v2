{%- comment -%}
  Section: image-with-text
  Image beside a content column, with Dawn's layout controls:
    • Layout           image first / text first  ← the reverse behaviour
    • Image width      small · medium · large
    • Image height     adapt to ratio · small · medium · large
    • Content position top · middle · bottom
    • Content align    left · centre · right (separate mobile alignment)
    • Content layout   no overlap · overlap
  Blocks: caption, heading, text, button — reorderable, so the content column
  can be composed in any order.
  Styles: assets/section-image-with-text.css
{%- endcomment -%}

{{ 'section-image-with-text.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{%- liquid
  # image column width → grid template
  case section.settings.desktop_image_width
    when 'small'
      assign grid_columns = '1fr 2fr'
    when 'large'
      assign grid_columns = '2fr 1fr'
    else
      assign grid_columns = '1fr 1fr'
  endcase

  # a text-first layout mirrors the ratio so the image keeps its share
  if section.settings.layout == 'text_first'
    case section.settings.desktop_image_width
      when 'small'
        assign grid_columns = '2fr 1fr'
      when 'large'
        assign grid_columns = '1fr 2fr'
    endcase
  endif

  # fixed heights, or auto so the chosen ratio drives the box
  case section.settings.image_height
    when 'small'
      assign image_height = '320px'
    when 'medium'
      assign image_height = '480px'
    when 'large'
      assign image_height = '640px'
    else
      assign image_height = 'auto'
  endcase

  case section.settings.desktop_content_position
    when 'top'
      assign content_position = 'start'
    when 'bottom'
      assign content_position = 'end'
    else
      assign content_position = 'center'
  endcase

  assign section_class = 'yk-image-text yk-image-text--' | append: section.settings.desktop_content_alignment
  if section.settings.layout == 'text_first'
    assign section_class = section_class | append: ' yk-image-text--text-first'
  endif
  if section.settings.content_layout == 'overlap'
    assign section_class = section_class | append: ' yk-image-text--overlap'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-iwt-cols: {{ grid_columns }};
    --yk-iwt-gap: {{ section.settings.column_gap }}px;
    --yk-iwt-position: {{ content_position }};
    --yk-iwt-height: {{ image_height }};
    --yk-iwt-ratio: {{ section.settings.image_ratio }};
    --yk-iwt-text-align: {{ section.settings.desktop_content_alignment }};
    --yk-iwt-text-align-mobile: {{ section.settings.mobile_content_alignment }};
    --yk-card-bg: {{ section.settings.color_card }};
  }
{% endstyle %}

<div class="yk-section">
  <div class="yk-page-width">
    <div class="{{ section_class }}">

      <div class="yk-image-text__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              class: 'yk-image-text__image',
              widths: '400,600,800,1000,1200,1400',
              sizes: '(max-width: 989px) 92vw, 46vw',
              alt: section.settings.image.alt | default: shop.name,
              loading: 'lazy',
              decoding: 'async'
          }}
        {%- else -%}
          <img
            class="yk-image-text__image"
            src="{{ 'yakka-lifestyle.jpg' | asset_url }}"
            alt=""
            width="1200"
            height="900"
            loading="lazy" decoding="async"
          >
        {%- endif -%}
      </div>

      <div class="yk-image-text__content">
        {%- for block in section.blocks -%}
          {%- case block.type -%}

            {%- when 'caption' -%}
              <span class="yk-image-text__caption" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </span>

            {%- when 'heading' -%}
              <h2
                class="yk-image-text__heading yk-section__heading"
                {{ block.shopify_attributes }}
              >{{ block.settings.heading }}</h2>

            {%- when 'text' -%}
              <div class="yk-image-text__text yk-rte" {{ block.shopify_attributes }}>
                {{ block.settings.text }}
              </div>

            {%- when 'button' -%}
              {%- if block.settings.label != blank -%}
                <div class="yk-image-text__actions" {{ block.shopify_attributes }}>
                  <a
                    class="yk-btn{% if block.settings.style == 'secondary' %} yk-btn--ghost{% endif %}"
                    href="{{ block.settings.link | default: routes.all_products_collection_url }}"
                  >{{ block.settings.label }}</a>
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image with text",
  "tag": "section",
  "class": "yk-section-image-with-text",
  "settings": [
    { "type": "header", "content": "Image" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "image_height", "label": "Image height", "default": "adapt",
      "info": "“Adapt to ratio” lets the ratio below set the height.",
      "options": [
        { "value": "adapt", "label": "Adapt to ratio" },
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4/3",
      "options": [
        { "value": "4/3", "label": "Landscape" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Wide" }
      ] },
    { "type": "select", "id": "desktop_image_width", "label": "Desktop image width", "default": "medium",
      "options": [
        { "value": "small", "label": "Small (one third)" },
        { "value": "medium", "label": "Medium (half)" },
        { "value": "large", "label": "Large (two thirds)" }
      ] },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "layout", "label": "Desktop layout", "default": "image_first",
      "info": "Choose “Text first” to reverse the columns. Mobile always shows the image first.",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first (reversed)" }
      ] },
    { "type": "select", "id": "content_layout", "label": "Content layout", "default": "no_overlap",
      "options": [
        { "value": "no_overlap", "label": "No overlap" },
        { "value": "overlap", "label": "Overlap" }
      ] },
    { "type": "select", "id": "desktop_content_position", "label": "Desktop content position", "default": "middle",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "middle", "label": "Middle" },
        { "value": "bottom", "label": "Bottom" }
      ] },
    { "type": "select", "id": "desktop_content_alignment", "label": "Desktop content alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "select", "id": "mobile_content_alignment", "label": "Mobile content alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 0, "max": 96, "step": 4, "unit": "px", "default": 52 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Overlap card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Caption" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "caption", "name": "Caption", "limit": 1,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Built on site" }
      ] },
    { "type": "heading", "name": "Heading", "limit": 1,
      "settings": [
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Made for the way you actually work." }
      ] },
    { "type": "text", "name": "Text", "limit": 2,
      "settings": [
        { "type": "richtext", "id": "text", "label": "Text",
          "default": "<p>Pair a photo from the job with the detail that matters. Use this section to explain a feature, tell a bit of the story, or answer the question that stops people buying.</p>" }
      ] },
    { "type": "button", "name": "Button", "limit": 1,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Shop the Lunchbox" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "style", "label": "Style", "default": "primary",
          "options": [
            { "value": "primary", "label": "Solid" },
            { "value": "secondary", "label": "Outline" }
          ] }
      ] }
  ],
  "presets": [
    {
      "name": "Image with text",
      "blocks": [
        { "type": "caption" },
        { "type": "heading" },
        { "type": "text" },
        { "type": "button" }
      ]
    }
  ]
}
{% endschema %}
