<style>
.custom-featured-product-{{ section.id }} {
  --text: #1A1815;
  --text-2: #6B6660;
  --text-3: #4A4640;
  --border: #E3DDD4;
  --accent: #E8500F;
  --surface: #FFFFFF;
  --canvas: #F7F4EF;
  --max: 1180px;
  --thumb-desktop: {{ section.settings.thumbs_desktop | default: 6 }};
  --thumb-mobile: {{ section.settings.thumbs_mobile | default: 4 }};
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  -webkit-font-smoothing: antialiased;
  padding: {{ section.settings.padding_y }}px 0;
  background: var(--canvas);
}
.custom-featured-product-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
.custom-featured-product-{{ section.id }} .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

.cfp-grid {
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  gap: 56px;
  align-items: flex-start;
}

/* GALLERY */
.cfp-gallery {
  display: flex;
  flex-direction: column;
  gap: 16px;
  position: relative;
}
.cfp-main-img-wrap {
  border-radius: 20px;
  overflow: hidden;
  background: var(--surface);
  aspect-ratio: 1 / 1;
  display: flex;
}
.cfp-main-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  flex-shrink: 0;
  display: none;
}
.cfp-main-image.active {
  display: block;
}
.cfp-badge {
  position: absolute;
  top: 16px;
  left: 16px;
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  padding: 8px 12px;
  border-radius: 4px;
  z-index: 2;
}

/* THUMBNAILS SLIDER */
.cfp-thumb-slider-wrap {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8px;
}
.cfp-thumb-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  min-width: 32px;
  border-radius: 50%;
  border: 1px solid var(--border);
  background: var(--surface);
  color: var(--text);
  cursor: pointer;
  transition: all .2s ease;
  flex-shrink: 0;
  z-index: 2;
}
.cfp-thumb-arrow:hover {
  background: var(--text);
  color: #fff;
  border-color: var(--text);
}
.cfp-thumb-arrow:disabled {
  opacity: .3;
  cursor: default;
  pointer-events: none;
}
.cfp-thumb-arrow svg {
  width: 14px;
  height: 14px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.cfp-thumbnails {
  display: flex;
  gap: 12px;
  overflow: hidden;
  flex: 1;
}
.cfp-thumbnails.slider-mode {
  scroll-behavior: smooth;
}
.cfp-thumb {
  width: calc((100% - 12px * (var(--thumb-desktop) - 1)) / var(--thumb-desktop));
  min-width: calc((100% - 12px * (var(--thumb-desktop) - 1)) / var(--thumb-desktop));
  aspect-ratio: 1 / 1;
  border-radius: 12px;
  overflow: hidden;
  cursor: pointer;
  border: 2px solid transparent;
  flex-shrink: 0;
  transition: border-color .2s ease, transform .15s ease;
}
.cfp-thumb:hover {
  transform: scale(1.04);
}
.cfp-thumb.active {
  border-color: var(--accent);
}
.cfp-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* INFO */
.cfp-info {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.cfp-eyebrow {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: var(--text-2);
}
.cfp-title {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-weight: 400;
  font-size: 40px;
  color: var(--text);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin: 0 0 4px;
}

.cfp-price-wrap {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}
.cfp-price {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-size: 32px;
  color: var(--text);
}
.cfp-compare {
  font-size: 18px;
  color: var(--text-2);
  text-decoration: line-through;
}
.cfp-save {
  background: var(--accent);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .05em;
  text-transform: uppercase;
  padding: 4px 8px;
  border-radius: 4px;
}
.cfp-installments {
  font-size: 13px;
  color: var(--text-2);
}

/* TABLE */
.cfp-table {
  margin: 12px 0;
}
.cfp-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14px 0;
  border-bottom: 1px solid var(--border);
  font-size: 14px;
}
.cfp-row:first-child {
  border-top: 1px solid var(--border);
}
.cfp-row span:first-child {
  color: var(--text-2);
  flex-shrink: 0;
  padding-right: 16px;
}
.cfp-row span:last-child {
  color: var(--text);
  font-weight: 500;
  text-align: right;
}

/* VARIANTS */
.cfp-variants {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.cfp-opt-name {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .15em;
  text-transform: uppercase;
  color: var(--text-2);
}
.cfp-opt-list {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
}
.cfp-opt-btn {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px 16px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  color: var(--text);
  transition: all .2s;
}
.cfp-opt-btn.active {
  border-color: var(--text);
}
.cfp-opt-btn .dot {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid var(--border);
  display: block;
}

/* ADD TO CART */
.cfp-action {
  display: flex;
  gap: 16px;
  margin-top: 8px;
}
.cfp-qty {
  display: flex;
  align-items: center;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: var(--surface);
  height: 56px;
  padding: 0 16px;
}
.cfp-qty button {
  background: none;
  border: none;
  cursor: pointer;
  font-size: 18px;
  color: var(--text-2);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 24px;
}
.cfp-qty input {
  width: 60px;
  text-align: center;
  border: none;
  background: none;
  font-size: 15px;
  font-weight: 600;
  color: var(--text);
  pointer-events: none;
}
.cfp-add {
  flex-grow: 1;
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 16px;
  font-weight: 600;
  cursor: pointer;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: background .2s;
}
.cfp-add:hover {
  background: #D1450C;
}

/* TRUST */
.cfp-trust {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
  font-size: 12px;
  color: var(--text-2);
  margin-top: 4px;
}
.cfp-trust span {
  display: flex;
  align-items: center;
  gap: 6px;
}
.cfp-trust svg {
  width: 14px;
  height: 14px;
}

@media (max-width: 990px) {
  .cfp-grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .cfp-title {
    font-size: 32px;
  }
  .cfp-price {
    font-size: 28px;
  }
  .cfp-thumb {
    width: calc((100% - 12px * (var(--thumb-mobile) - 1)) / var(--thumb-mobile));
    min-width: calc((100% - 12px * (var(--thumb-mobile) - 1)) / var(--thumb-mobile));
  }
  .cfp-main-img-wrap {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .cfp-main-img-wrap::-webkit-scrollbar { display: none; }
  .cfp-main-image {
    display: block;
    scroll-snap-align: start;
  }
  .cfp-thumb-arrow {
    width: 28px;
    height: 28px;
    min-width: 28px;
  }
  .cfp-thumb-arrow svg {
    width: 12px;
    height: 12px;
  }
}

@media (max-width: 768px) {
  .custom-featured-product-{{ section.id }} {
    padding: calc({{ section.settings.padding_y }}px * 0.7) 0;
  }
  .cfp-title {
    font-size: 28px;
  }
  .cfp-price {
    font-size: 24px;
  }
  .cfp-action {
    flex-direction: column;
  }
  .cfp-qty {
    width: 100%;
    justify-content: space-between;
  }
  .cfp-qty input {
    flex-grow: 1;
  }
}
</style>

{% assign product = section.settings.product %}
{% assign thumbs_desktop = section.settings.thumbs_desktop | default: 6 %}
{% assign thumbs_mobile = section.settings.thumbs_mobile | default: 4 %}
{% assign enable_slider = section.settings.enable_thumb_slider %}

<div class="custom-featured-product-{{ section.id }}">
  <div class="wrap">
    <div class="cfp-grid">
      
      <!-- GALLERY -->
      <div class="cfp-gallery">
        {% if section.settings.badge_text != blank %}
          <div class="cfp-badge">{{ section.settings.badge_text }}</div>
        {% endif %}
        
        <div class="cfp-main-img-wrap" id="cfp-slider-{{ section.id }}">
          {% if product != blank %}
            {% for image in product.images %}
              <img class="cfp-main-image {% if forloop.first %}active{% endif %}" src="{{ image | image_url: width: 1000 }}" alt="{{ image.alt | escape }}">
            {% endfor %}
          {% else %}
            <div class="cfp-main-image active">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
          {% endif %}
        </div>
        
        {% if product != blank and product.images.size > 1 %}
          <div class="cfp-thumb-slider-wrap" id="cfp-thumb-wrap-{{ section.id }}">
            {% if enable_slider %}
              <button type="button" class="cfp-thumb-arrow cfp-thumb-prev" id="cfp-prev-{{ section.id }}" aria-label="Previous thumbnails" disabled>
                <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"></polyline></svg>
              </button>
            {% endif %}

            <div class="cfp-thumbnails {% if enable_slider %}slider-mode{% endif %}" id="cfp-thumbs-{{ section.id }}">
              {% for image in product.images %}
                <div class="cfp-thumb {% if forloop.first %}active{% endif %}" onclick="switchImage_{{ section.id | replace: '-', '_' }}({{ forloop.index0 }}, this)">
                  <img src="{{ image | image_url: width: 150 }}" alt="{{ image.alt | escape }}">
                </div>
              {% endfor %}
            </div>

            {% if enable_slider %}
              <button type="button" class="cfp-thumb-arrow cfp-thumb-next" id="cfp-next-{{ section.id }}" aria-label="Next thumbnails">
                <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"></polyline></svg>
              </button>
            {% endif %}
          </div>
        {% endif %}
      </div>

      <!-- INFO -->
      <div class="cfp-info">
        <div>
          {% if section.settings.eyebrow != blank %}
            <div class="cfp-eyebrow">{{ section.settings.eyebrow }}</div>
          {% endif %}
          <h1 class="cfp-title">{{ product.title | default: 'Yakka Essential Portable Food Warmer' }}</h1>
        </div>

        <div class="cfp-price-wrap">
          {% if product != blank %}
            <span class="cfp-price" id="cfp-price-{{ section.id }}">{{ product.selected_or_first_available_variant.price | money }}</span>
            {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
              <span class="cfp-compare" id="cfp-compare-{{ section.id }}">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
              {% assign save = product.selected_or_first_available_variant.compare_at_price | minus: product.selected_or_first_available_variant.price %}
              <span class="cfp-save" id="cfp-save-{{ section.id }}">SAVE {{ save | money_without_trailing_zeros }}</span>
            {% endif %}
          {% else %}
            <span class="cfp-price">$139.99</span>
            <span class="cfp-compare">$279.99</span>
            <span class="cfp-save">SAVE $140</span>
          {% endif %}
        </div>

        {% if section.settings.installments != blank %}
          <div class="cfp-installments">{{ section.settings.installments }}</div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="cfp-table">
            {% for block in section.blocks %}
              <div class="cfp-row" {{ block.shopify_attributes }}>
                <span>{{ block.settings.label }}</span>
                <span>{{ block.settings.value }}</span>
              </div>
            {% endfor %}
          </div>
        {% endif %}

        {% if product != blank and product.has_only_default_variant == false %}
          <div class="cfp-variants">
            {% for option in product.options_with_values %}
              <div class="cfp-opt-name">{{ option.name }}</div>
              <div class="cfp-opt-list">
                {% for value in option.values %}
                  <div class="cfp-opt-btn {% if option.selected_value == value %}active{% endif %}" data-value="{{ value | escape }}" onclick="selectVariant_{{ section.id | replace: '-', '_' }}(this)">
                    {% if option.name == 'Color' or option.name == 'Colour' or option.name == 'COLOUR' %}
                      {% assign color_down = value | downcase %}
                      <span class="dot" style="background-color: {{ color_down | replace: ' ', '' }};"></span>
                    {% endif %}
                    {{ value }}
                  </div>
                {% endfor %}
              </div>
            {% endfor %}
          </div>
          <script type="application/json" id="cfp-variants-json-{{ section.id }}">
            {{ product.variants | json }}
          </script>
        {% else %}
          <!-- Dummy variants for preview if no product -->
          {% if product == blank %}
            <div class="cfp-variants">
              <div class="cfp-opt-name">COLOUR</div>
              <div class="cfp-opt-list">
                <div class="cfp-opt-btn active"><span class="dot" style="background-color: #1A1815;"></span> Matte Black</div>
                <div class="cfp-opt-btn"><span class="dot" style="background-color: #EFEFEF;"></span> Stone White</div>
              </div>
            </div>
          {% endif %}
        {% endif %}

        <product-form class="product-form" data-section-id="{{ section.id }}">
          <div class="product-form__error-message-wrapper" role="alert" hidden>
            <span class="svg-wrapper">
              {{- 'icon-error.svg' | inline_asset_content -}}
            </span>
            <span class="product-form__error-message"></span>
          </div>

          {%- form 'product', product, id: 'product-form-installment', class: 'installment caption-large', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id | default: '' }}">
            <div class="cfp-action">
              <div class="cfp-qty">
                <button type="button" onclick="changeQty(-1)">-</button>
                <input type="text" name="quantity" id="cfp-qty-val" value="1" min="1">
                <button type="button" onclick="changeQty(1)">+</button>
              </div>
              <button type="submit" name="add" class="cfp-add product-form__submit" {% if product.selected_or_first_available_variant.available == false %}disabled{% endif %}>
                <span>Add to cart — <span id="cfp-btn-price">{{ product.selected_or_first_available_variant.price | default: 13999 | money }}</span></span>
                {%- render 'loading-spinner' -%}
              </button>
            </div>
          {%- endform -%}
        </product-form>

        {% if section.settings.trust_text != blank %}
          <div class="cfp-trust">
            {{ section.settings.trust_text }}
          </div>
        {% endif %}

      </div>
    </div>
  </div>
</div>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

<script>
  function switchImage_{{ section.id | replace: '-', '_' }}(index, el) {
    let images = document.querySelectorAll('#cfp-slider-{{ section.id }} .cfp-main-image');
    images.forEach(img => img.classList.remove('active'));
    if(images[index]) images[index].classList.add('active');

    if(el) {
      let thumbs = el.parentElement.querySelectorAll('.cfp-thumb');
      thumbs.forEach(t => t.classList.remove('active'));
      el.classList.add('active');
    }

    /* auto-scroll slider to keep active thumb visible */
    let thumbSlider = document.getElementById('cfp-thumbs-{{ section.id }}');
    if (thumbSlider) {
      let allThumbs = thumbSlider.querySelectorAll('.cfp-thumb');
      if (allThumbs[index]) {
        let activeThumb = allThumbs[index];
        allThumbs.forEach(t => t.classList.remove('active'));
        activeThumb.classList.add('active');

        /* Scroll into view if needed */
        let sliderRect = thumbSlider.getBoundingClientRect();
        let thumbRect = activeThumb.getBoundingClientRect();
        if (thumbRect.left < sliderRect.left || thumbRect.right > sliderRect.right) {
          thumbSlider.scrollTo({
            left: activeThumb.offsetLeft - thumbSlider.offsetLeft,
            behavior: 'smooth'
          });
        }
      }
    }
  }

  function changeQty(diff) {
    let input = document.getElementById('cfp-qty-val');
    let val = parseInt(input.value) + diff;
    if(val >= 1) input.value = val;
  }

  function selectVariant_{{ section.id | replace: '-', '_' }}(btn) {
    let list = btn.closest('.cfp-opt-list');
    list.querySelectorAll('.cfp-opt-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    let section = btn.closest('.custom-featured-product-{{ section.id }}');
    let optLists = section.querySelectorAll('.cfp-opt-list');
    let selectedOptions = Array.from(optLists).map(l => {
      let activeBtn = l.querySelector('.cfp-opt-btn.active');
      return activeBtn ? activeBtn.getAttribute('data-value') : null;
    });

    let variantsJson = document.getElementById('cfp-variants-json-{{ section.id }}');
    if (!variantsJson) return;
    let variants = JSON.parse(variantsJson.innerHTML);
    
    let matchedVariant = variants.find(v => {
      return v.options.every((opt, i) => opt === selectedOptions[i]);
    });

    if (matchedVariant) {
      let idInput = section.querySelector('input[name="id"]');
      if (idInput) idInput.value = matchedVariant.id;

      window.history.replaceState({ }, '', '?variant=' + matchedVariant.id);

      let formatMoney = (cents) => {
        let dollars = (cents / 100).toFixed(2);
        let shopifyFormat = window.Shopify && Shopify.currency && Shopify.currency.active ? Shopify.currency.active : '$';
        if (shopifyFormat === 'USD' || shopifyFormat === 'AUD' || shopifyFormat === '$') return '$' + dollars;
        return '$' + dollars; // Default fallback
      };
      
      let priceEl = section.querySelector('#cfp-price-{{ section.id }}');
      let btnPriceEl = section.querySelector('#cfp-btn-price');
      if (priceEl) priceEl.innerText = formatMoney(matchedVariant.price);
      if (btnPriceEl) btnPriceEl.innerText = formatMoney(matchedVariant.price);

      let compareEl = section.querySelector('#cfp-compare-{{ section.id }}');
      let saveEl = section.querySelector('#cfp-save-{{ section.id }}');
      if (matchedVariant.compare_at_price > matchedVariant.price) {
        if (compareEl) compareEl.innerText = formatMoney(matchedVariant.compare_at_price);
        if (saveEl) {
          let save = matchedVariant.compare_at_price - matchedVariant.price;
          saveEl.innerText = 'SAVE ' + formatMoney(save).replace('.00', '');
          saveEl.style.display = 'inline-block';
        }
      } else {
        if (compareEl) compareEl.innerText = '';
        if (saveEl) saveEl.style.display = 'none';
      }

      if (matchedVariant.featured_image) {
        let urlToFind = matchedVariant.featured_image.src.split('?')[0].split('.jpg')[0].split('.png')[0];
        let images = document.querySelectorAll('#cfp-slider-{{ section.id }} .cfp-main-image');
        let matchedIndex = 0;
        images.forEach((img, idx) => {
          if(img.src.includes(urlToFind)) matchedIndex = idx;
        });
        
        switchImage_{{ section.id | replace: '-', '_' }}(matchedIndex, null);
        
        let slider = document.getElementById('cfp-slider-{{ section.id }}');
        if(window.innerWidth <= 990 && slider) {
          let slideWidth = slider.clientWidth;
          slider.scrollTo({ left: slideWidth * matchedIndex, behavior: 'smooth' });
        }
      }
    }
  }

  /* ── Thumbnail Slider Logic ── */
  (function() {
    const sectionId = '{{ section.id }}';
    const enableSlider = {{ enable_slider | json }};
    const thumbsDesktop = {{ thumbs_desktop }};
    const thumbsMobile = {{ thumbs_mobile }};

    if (!enableSlider) return;

    const thumbContainer = document.getElementById('cfp-thumbs-' + sectionId);
    const prevBtn = document.getElementById('cfp-prev-' + sectionId);
    const nextBtn = document.getElementById('cfp-next-' + sectionId);

    if (!thumbContainer || !prevBtn || !nextBtn) return;

    const allThumbs = thumbContainer.querySelectorAll('.cfp-thumb');
    const totalThumbs = allThumbs.length;
    let currentPage = 0;

    function getVisibleCount() {
      return window.innerWidth <= 990 ? thumbsMobile : thumbsDesktop;
    }

    function getTotalPages() {
      let visible = getVisibleCount();
      if (totalThumbs <= visible) return 1;
      return Math.ceil(totalThumbs / visible);
    }

    function getScrollAmount() {
      if (allThumbs.length === 0) return 0;
      let thumbWidth = allThumbs[0].offsetWidth;
      let gap = 12;
      let visible = getVisibleCount();
      return (thumbWidth + gap) * visible;
    }

    function updateArrows() {
      let maxScroll = thumbContainer.scrollWidth - thumbContainer.clientWidth;
      prevBtn.disabled = thumbContainer.scrollLeft <= 2;
      nextBtn.disabled = thumbContainer.scrollLeft >= maxScroll - 2;
    }

    function slideNext() {
      let amount = getScrollAmount();
      thumbContainer.scrollBy({ left: amount, behavior: 'smooth' });
    }

    function slidePrev() {
      let amount = getScrollAmount();
      thumbContainer.scrollBy({ left: -amount, behavior: 'smooth' });
    }

    /* Enable overflow-x scroll for slider mode */
    thumbContainer.style.overflowX = 'auto';
    thumbContainer.style.scrollBehavior = 'smooth';
    thumbContainer.style.scrollbarWidth = 'none';

    prevBtn.addEventListener('click', slidePrev);
    nextBtn.addEventListener('click', slideNext);
    thumbContainer.addEventListener('scroll', updateArrows);

    /* Update on resize */
    let resizeTimer;
    window.addEventListener('resize', function() {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(updateArrows, 150);
    });

    /* Initial state */
    setTimeout(updateArrows, 100);
  })();
</script>

{% schema %}
{
  "name": "Custom Featured Product",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
