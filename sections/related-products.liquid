{%- comment -%}
  Section: related-products
  Shopify's Product Recommendations API, fetched after load so it never blocks
  rendering and always reflects the live algorithm.
  Styles: assets/section-collection.css + assets/component-card-product.css
{%- endcomment -%}

{{ 'section-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card-product.css' | asset_url | stylesheet_tag }}
<script src="{{ 'yk-recommendations.js' | asset_url }}" defer="defer"></script>
{%- if section.settings.enable_quick_add -%}
  <script src="{{ 'yk-cart.js' | asset_url }}" defer="defer"></script>
{%- endif -%}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-grid-gap-x: {{ section.settings.grid_gap_horizontal }}px;
    --yk-grid-gap-y: {{ section.settings.grid_gap_vertical }}px;
  }
{% endstyle %}

<div
  class="yk-section"
  data-yk-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  data-yk-section-id="{{ section.id }}"
>
  <div class="yk-page-width">
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="yk-section__heading yk-section__heading--tight">{{ section.settings.heading }}</h2>
      {%- endif -%}

      <ul class="yk-product-grid" role="list">
        {%- for product in recommendations.products -%}
          <li class="yk-product-grid__item">
            {% render 'card-product',
              card_product: product,
              media_ratio: section.settings.image_ratio,
              show_secondary_image: section.settings.show_secondary_image,
              show_vendor: section.settings.show_vendor,
              quick_add: section.settings.enable_quick_add,
              section_id: section.id
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "class": "yk-section-recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You might also like" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related",
      "options": [
        { "value": "related", "label": "Related products" },
        { "value": "complementary", "label": "Complementary products" }
      ] },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 4 },

    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 4, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 2 },
    { "type": "range", "id": "grid_gap_horizontal", "label": "Horizontal gap", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "grid_gap_vertical", "label": "Vertical gap", "min": 4, "max": 60, "step": 2, "unit": "px", "default": 40 },

    { "type": "header", "content": "Product card" },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1/1",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "4/3", "label": "Landscape" }
      ] },
    { "type": "checkbox", "id": "show_secondary_image", "label": "Show second image on hover", "default": true },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "enable_quick_add", "label": "Enable quick add to cart", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 }
  ],
  "presets": [ { "name": "Product recommendations" } ]
}
{% endschema %}
