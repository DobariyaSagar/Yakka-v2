{%- comment -%}
  Section: multicolumn
  Dawn-style column grid with per-breakpoint column counts, image width and
  ratio (including circle), column alignment, optional card background, an
  optional section button, and optional swipe-with-snapping on mobile.
  Styles: assets/section-multicolumn.css
{%- endcomment -%}

{{ 'section-multicolumn.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{%- liquid
  case section.settings.image_width
    when 'half'
      assign image_width = '50%'
    when 'third'
      assign image_width = '33%'
    else
      assign image_width = '100%'
  endcase

  case section.settings.image_ratio
    when 'portrait'
      assign image_ratio = '3/4'
    when 'circle'
      assign image_ratio = '1/1'
    when 'square'
      assign image_ratio = '1/1'
    else
      assign image_ratio = 'auto'
  endcase

  # a centred column centres its image too; a left column keeps it flush left
  if section.settings.column_alignment == 'center'
    assign media_inline = '0 auto'
  else
    assign media_inline = '0 auto 0 0'
  endif

  assign list_class = 'yk-multicolumn__list'
  if section.settings.swipe_on_mobile
    assign list_class = list_class | append: ' yk-multicolumn__list--swipe'
  endif
-%}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-mc-gap: {{ section.settings.grid_gap }}px;
    --yk-mc-top: {{ section.settings.grid_offset }}px;
    --yk-mc-align: {{ section.settings.column_alignment }};
    --yk-mc-image-width: {{ image_width }};
    --yk-mc-media-inline: {{ media_inline }};
    --yk-mc-ratio: {{ image_ratio }};
    --yk-mc-title: {{ section.settings.column_title_size }}px;
    --yk-mc-actions-align: {{ section.settings.content_alignment }};
    --yk-card-bg: {{ section.settings.color_card }};
  }
{% endstyle %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="yk-section__heading yk-section__heading--tight">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="yk-section__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="{{ list_class }}">
        {%- for block in section.blocks -%}
          {%- liquid
            assign item_class = 'yk-multicolumn__item'
            if section.settings.background_style == 'card'
              assign item_class = item_class | append: ' yk-multicolumn__item--card'
            endif

            assign media_class = 'yk-multicolumn__media'
            if section.settings.image_ratio == 'circle'
              assign media_class = media_class | append: ' yk-multicolumn__media--circle'
            elsif section.settings.image_ratio == 'adapt'
              assign media_class = media_class | append: ' yk-multicolumn__media--adapt'
            endif
          -%}

          <div class="{{ item_class }}" {{ block.shopify_attributes }}>
            {%- if section.settings.show_images -%}
              {%- if block.settings.image != blank -%}
                <div class="{{ media_class }}">
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      class: 'yk-multicolumn__image',
                      widths: '200,400,600,800',
                      sizes: '(max-width: 749px) 88vw, (max-width: 989px) 44vw, 30vw',
                      alt: block.settings.image.alt | default: block.settings.title,
                      loading: 'lazy',
                      decoding: 'async'
                  }}
                </div>
              {%- elsif block.settings.placeholder_image != 'none' -%}
                <div class="{{ media_class }}">
                  <img
                    class="yk-multicolumn__image"
                    src="{{ block.settings.placeholder_image | asset_url }}"
                    alt=""
                    width="800"
                    height="800"
                    loading="lazy" decoding="async"
                  >
                </div>
              {%- endif -%}
            {%- endif -%}

            {%- if block.settings.title != blank -%}
              <h3 class="yk-multicolumn__title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <div class="yk-multicolumn__text yk-rte">{{ block.settings.text }}</div>
            {%- endif -%}

            {%- if block.settings.link_label != blank -%}
              <a class="yk-multicolumn__link" href="{{ block.settings.link | default: '#' }}">
                {{ block.settings.link_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="yk-multicolumn__actions">
        <a class="yk-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Multicolumn",
  "tag": "section",
  "class": "yk-section-multicolumn",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Yakka" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built to last the whole job." },
    { "type": "text", "id": "text", "label": "Body" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },

    { "type": "header", "content": "Images" },
    { "type": "checkbox", "id": "show_images", "label": "Show images", "default": true },
    { "type": "select", "id": "image_width", "label": "Image width", "default": "full",
      "options": [
        { "value": "full", "label": "Full width of column" },
        { "value": "half", "label": "Half width of column" },
        { "value": "third", "label": "One third of column" }
      ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "square",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" },
        { "value": "circle", "label": "Circle" }
      ] },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 1, "max": 6, "step": 1, "default": 3 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "checkbox", "id": "swipe_on_mobile", "label": "Swipe on mobile", "default": false,
      "info": "Turns the grid into one scroll-snapping row on phones." },
    { "type": "select", "id": "column_alignment", "label": "Column alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "select", "id": "background_style", "label": "Column background", "default": "card",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "card", "label": "Card" }
      ] },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "grid_offset", "label": "Space above columns", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 48 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_heading", "label": "Headings" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Column links", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },
    { "type": "range", "id": "column_title_size", "label": "Column title size", "min": 16, "max": 34, "step": 1, "unit": "px", "default": 22 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 100 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 52 }
  ],
  "blocks": [
    { "type": "column", "name": "Column",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "select", "id": "placeholder_image", "label": "Placeholder image", "default": "yakka-product.jpg",
          "info": "Used until you pick an image.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "yakka-product.jpg", "label": "Product" },
            { "value": "yakka-hero.jpg", "label": "On site" },
            { "value": "yakka-lifestyle.jpg", "label": "Lifestyle" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Cordless by design" },
        { "type": "richtext", "id": "text", "label": "Text",
          "default": "<p>Runs off its own battery, so it works anywhere the job takes you.</p>" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link", "label": "Link" }
      ] }
  ],
  "presets": [
    {
      "name": "Multicolumn",
      "blocks": [
        { "type": "column", "settings": { "placeholder_image": "yakka-product.jpg", "title": "Cordless by design", "text": "<p>Runs off its own battery, so it works anywhere the job takes you.</p>" } },
        { "type": "column", "settings": { "placeholder_image": "yakka-hero.jpg", "title": "Hot in 45 minutes", "text": "<p>Press start before smoko and sit down to a steaming feed.</p>" } },
        { "type": "column", "settings": { "placeholder_image": "yakka-lifestyle.jpg", "title": "Lives in the toolbox", "text": "<p>Leak-proof seal and an impact-rated shell built for the tray.</p>" } }
      ]
    }
  ]
}
{% endschema %}
