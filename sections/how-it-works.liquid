{%- comment -%}
  Section: how-it-works — numbered step cards (auto-numbered from block order).
  Styles: assets/section-steps.css
{%- endcomment -%}

{{ 'section-steps.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-steps-gap: {{ section.settings.grid_gap }}px;
    --yk-steps-top: {{ section.settings.grid_offset }}px;
    --yk-card-bg: {{ section.settings.color_card }};
  }
{% endstyle %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="yk-section__heading yk-measure-md">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="yk-section__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="yk-steps">
        {%- for block in section.blocks -%}
          <div class="yk-step" {{ block.shopify_attributes }}>
            {%- if section.settings.show_numbers -%}
              <span class="yk-step__number" aria-hidden="true">{{ forloop.index }}</span>
            {%- endif -%}

            {%- if block.settings.tag != blank -%}
              <span class="yk-step__tag">{{ block.settings.tag }}</span>
            {%- endif -%}

            <h3 class="yk-step__title">{{ block.settings.title }}</h3>
            <p class="yk-step__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "How it works",
  "tag": "section",
  "class": "yk-section-steps",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "How it works" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Four steps. No outlet required." },
    { "type": "text", "id": "text", "label": "Body", "default": "If you can charge a phone, you can run this." },
    { "type": "checkbox", "id": "show_numbers", "label": "Show step numbers", "default": true },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "range", "id": "columns_desktop", "label": "Columns", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns (tablet)", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns (mobile)", "min": 1, "max": 2, "step": 1, "default": 1 },
    { "type": "range", "id": "grid_gap", "label": "Grid gap", "min": 8, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "range", "id": "grid_offset", "label": "Space above grid", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Card background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Accent (numbers, hover)", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "step", "name": "Step",
      "settings": [
        { "type": "text", "id": "tag", "label": "Tag", "default": "Night before" },
        { "type": "text", "id": "title", "label": "Title", "default": "Charge it" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Plug it in on the bench with the USB-C cable. Full charge holds two to three heat cycles." }
      ] }
  ],
  "presets": [
    { "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "tag": "Night before", "title": "Charge it", "text": "Plug it in on the bench with the USB-C cable. Full charge holds two to three heat cycles." } },
        { "type": "step", "settings": { "tag": "Morning", "title": "Pack your feed", "text": "Last night's dinner, a curry, a pasta — straight into the stainless container. 1.5L, a proper serve." } },
        { "type": "step", "settings": { "tag": "On site", "title": "Press start", "text": "Hit it 45 minutes out, or set the timer at seven and forget about it until the whistle." } },
        { "type": "step", "settings": { "tag": "Smoko", "title": "Eat properly", "text": "Open it up to a steaming, evenly heated meal. No queue, no servo pie, no cold roll." } }
      ] }
  ]
}
{% endschema %}
