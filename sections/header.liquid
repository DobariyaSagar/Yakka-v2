{%- comment -%}
  Section: header
  ≥990px : nav (left) · logo (centre) · search / account / cart (right)
  ≤989px : burger (left) · logo (centre) · icons (right) + slide-down menu
  Styles: assets/section-header.css   Behaviour: assets/yk-header.js
{%- endcomment -%}

{{ 'section-header.css' | asset_url | stylesheet_tag: preload: true }}
<script src="{{ 'yk-header.js' | asset_url }}" defer="defer"></script>
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-header-height: {{ section.settings.header_height }}px;
    --yk-header-height-mobile: {{ section.settings.header_height_mobile }}px;
    --yk-logo-size: {{ section.settings.logo_size }}px;
    --yk-drawer-width: {{ section.settings.drawer_width }}px;
    --yk-drawer-bg: {{ section.settings.color_drawer_background }};
  }
{% endstyle %}

{%- liquid
  assign header_class = 'yk-header'
  if section.settings.sticky
    assign header_class = header_class | append: ' yk-header--sticky'
  endif

  assign show_account = false
  if section.settings.show_account and shop.customer_accounts_enabled
    assign show_account = true
  endif
-%}

<header class="{{ header_class }}" data-yk-header>
  <div class="yk-page-width">
    <div class="yk-header__inner">

      {%- comment -%} burger (mobile only) {%- endcomment -%}
      <button
        type="button"
        class="yk-header__burger"
        aria-label="{{ 'sections.header.menu' | t }}"
        aria-expanded="false"
        aria-controls="YkMobileNav-{{ section.id }}"
        data-yk-burger
        data-label-open="{{ 'sections.header.menu' | t | escape }}"
        data-label-close="{{ 'sections.header.close_menu' | t | escape }}"
      >
        <span class="yk-header__burger-bar"></span>
        <span class="yk-header__burger-bar"></span>
        <span class="yk-header__burger-bar"></span>
      </button>

      {%- comment -%} primary navigation {%- endcomment -%}
      <nav class="yk-header__nav" aria-label="{{ 'sections.header.primary_navigation' | t }}">
        {%- for link in section.settings.menu.links -%}
          <a
            class="yk-header__nav-link"
            href="{{ link.url }}"
            {% if link.current or link.child_active %}aria-current="page"{% endif %}
          >{{ link.title }}</a>
        {%- endfor -%}
      </nav>

      {%- comment -%} logo {%- endcomment -%}
      <div class="yk-header__logo-wrapper">
        <a class="yk-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            {{
              section.settings.logo
              | image_url: width: 480
              | image_tag:
                class: 'yk-header__logo-image',
                widths: '120,240,360,480',
                alt: shop.name,
                loading: 'eager'
            }}
          {%- else -%}
            {{ section.settings.logo_text | default: shop.name }}
          {%- endif -%}
        </a>
      </div>

      {%- comment -%} search · account · cart {%- endcomment -%}
      <div class="yk-header__actions">
        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="yk-header__action"
            aria-label="{{ 'general.search.search' | t }}"
            aria-expanded="false"
            aria-controls="YkSearch-{{ section.id }}"
            data-yk-search-toggle
          >
            {% render 'icon-search' %}
          </button>
        {%- endif -%}

        {%- if show_account -%}
          <a
            class="yk-header__action"
            href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
            aria-label="{% if customer %}{{ 'customer.account.title' | t }}{% else %}{{ 'customer.login_page.title' | t }}{% endif %}"
          >
            {% render 'icon-user' %}
          </a>
        {%- endif -%}

        <a
          class="yk-header__action"
          href="{{ routes.cart_url }}"
          aria-label="{{ 'sections.header.cart' | t }} ({{ cart.item_count }})"
        >
          {% render 'icon-cart' %}
          {%- if section.settings.show_cart_count -%}
            <span
              class="yk-header__cart-count"
              data-yk-cart-count
              {% if cart.item_count == 0 %}hidden{% endif %}
            >{{ cart.item_count | default: '' }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </div>

  {%- comment -%} search drawer {%- endcomment -%}
  {%- if section.settings.show_search -%}
    <div class="yk-search" id="YkSearch-{{ section.id }}">
      <div class="yk-page-width">
        <form class="yk-search__form" action="{{ routes.search_url }}" method="get" role="search">
          <label class="yk-visually-hidden" for="YkSearchInput-{{ section.id }}">
            {{ 'general.search.search' | t }}
          </label>
          <input
            class="yk-field yk-search__input"
            id="YkSearchInput-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ 'general.search.placeholder' | t }}"
          >
          <input type="hidden" name="options[prefix]" value="last">
          <button type="submit" class="yk-btn yk-btn--sm">{{ 'general.search.submit' | t }}</button>
        </form>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} ── mobile navigation ─────────────────────────────
       Drawer (default) or dropdown, per the "Mobile menu style" setting.
  {%- endcomment -%}
  {%- liquid
    assign nav_class = 'yk-mobile-nav yk-mobile-nav--' | append: section.settings.mobile_menu_style
    if section.settings.mobile_menu_style == 'drawer'
      assign nav_class = nav_class | append: ' yk-mobile-nav--' | append: section.settings.drawer_position
    endif
  -%}

  {%- if section.settings.mobile_menu_style == 'drawer' -%}
    <div class="yk-mobile-nav-overlay" data-yk-nav-overlay hidden></div>
  {%- endif -%}

  <div
    class="{{ nav_class }}"
    id="YkMobileNav-{{ section.id }}"
    role="dialog"
    aria-modal="true"
    aria-label="{{ 'sections.header.primary_navigation' | t }}"
  >
    <div class="yk-mobile-nav__header">
      <span class="yk-mobile-nav__title">{{ section.settings.logo_text | default: shop.name }}</span>
      <button
        type="button"
        class="yk-mobile-nav__close"
        aria-label="{{ 'sections.header.close_menu' | t }}"
        data-yk-nav-close
      >
        {% render 'icon-close' %}
      </button>
    </div>

    <div class="yk-mobile-nav__body">
      <ul class="yk-mobile-nav__list">
        {%- for link in section.settings.menu.links -%}
          <li class="yk-mobile-nav__item">
            <a
              class="yk-mobile-nav__link"
              href="{{ link.url }}"
              {% if link.current %}aria-current="page"{% endif %}
            >{{ link.title }}</a>
          </li>
        {%- endfor -%}

        {%- if show_account -%}
          <li class="yk-mobile-nav__item">
            <a class="yk-mobile-nav__link"
               href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}">
              {%- if customer -%}{{ 'customer.account.title' | t }}{%- else -%}{{ 'customer.login_page.title' | t }}{%- endif -%}
            </a>
          </li>
        {%- endif -%}
      </ul>
    </div>

    {%- if section.settings.drawer_footer_text != blank -%}
      <div class="yk-mobile-nav__footer">
        <div class="yk-mobile-nav__meta">{{ section.settings.drawer_footer_text }}</div>
      </div>
    {%- endif -%}
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "yk-section-header",
  "settings": [
    { "type": "header", "content": "Branding" },
    { "type": "image_picker", "id": "logo", "label": "Logo image" },
    { "type": "text", "id": "logo_text", "label": "Logo text", "default": "Yakka",
      "info": "Used when no logo image is set." },
    { "type": "range", "id": "logo_size", "label": "Logo size", "min": 16, "max": 60, "step": 1, "unit": "px", "default": 25 },

    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },

    { "type": "header", "content": "Icons" },
    { "type": "checkbox", "id": "show_search", "label": "Show search icon", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": true,
      "info": "Only appears when customer accounts are enabled." },
    { "type": "checkbox", "id": "show_cart_count", "label": "Show cart item count", "default": true },

    { "type": "header", "content": "Mobile menu" },
    { "type": "select", "id": "mobile_menu_style", "label": "Style", "default": "drawer",
      "options": [
        { "value": "drawer", "label": "Drawer (slides in)" },
        { "value": "dropdown", "label": "Dropdown (pushes the page)" }
      ] },
    { "type": "select", "id": "drawer_position", "label": "Drawer opens from", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "range", "id": "drawer_width", "label": "Drawer width", "min": 260, "max": 480, "step": 10, "unit": "px", "default": 380 },
    { "type": "text", "id": "drawer_footer_text", "label": "Drawer footer text",
      "default": "Free express shipping · 60-day money back" },

    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "sticky", "label": "Stick to top on scroll", "default": true },
    { "type": "range", "id": "header_height", "label": "Height", "min": 56, "max": 120, "step": 2, "unit": "px", "default": 76 },
    { "type": "range", "id": "header_height_mobile", "label": "Height (mobile)", "min": 48, "max": 96, "step": 2, "unit": "px", "default": 68 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#F7F4EF" },
    { "type": "color", "id": "color_heading", "label": "Logo", "default": "#1A1815" },
    { "type": "color", "id": "color_text", "label": "Links and icons", "default": "#4A4640" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#E8500F" },
    { "type": "color", "id": "color_drawer_background", "label": "Mobile drawer background", "default": "#FFFFFF" }
  ]
}
{% endschema %}
