{%- comment -%}
  Section: comparison-table
  Column 1 is the row label; column 2 is the highlighted "win" column.
  Scrolls inside its card ≤989px rather than breaking the page.
  Styles: assets/section-compare.css
{%- endcomment -%}

{{ 'section-compare.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-compare-top: {{ section.settings.table_offset }}px;
    --yk-card-bg: {{ section.settings.color_card }};
  }
{% endstyle %}

<div class="yk-section yk-align-{{ section.settings.content_alignment }}">
  <div class="yk-page-width">
    {%- if section.settings.eyebrow != blank -%}
      <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="yk-section__heading yk-measure-lg">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <p class="yk-section__text">{{ section.settings.text }}</p>
    {%- endif -%}

    <div class="yk-compare">
      <table class="yk-compare__table">
        <thead>
          <tr>
            <th scope="col">
              <span class="yk-visually-hidden">{{ 'sections.compare.feature' | t }}</span>
            </th>
            <th scope="col" class="yk-compare__col--win">{{ section.settings.col_1 }}</th>
            {%- if section.settings.col_2 != blank -%}
              <th scope="col">{{ section.settings.col_2 }}</th>
            {%- endif -%}
            {%- if section.settings.col_3 != blank -%}
              <th scope="col">{{ section.settings.col_3 }}</th>
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th scope="row" class="yk-compare__label">{{ block.settings.label }}</th>
              <td class="yk-compare__col--win">{{ block.settings.value_1 }}</td>
              {%- if section.settings.col_2 != blank -%}
                <td>{{ block.settings.value_2 }}</td>
              {%- endif -%}
              {%- if section.settings.col_3 != blank -%}
                <td>{{ block.settings.value_3 }}</td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Comparison table",
  "tag": "section",
  "class": "yk-section-compare",
  "max_blocks": 12,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The honest comparison" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Against what you're doing now." },
    { "type": "text", "id": "text", "label": "Body", "default": "Most tradies are choosing between a queue, a servo, or a cold roll." },

    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "col_1", "label": "Column 1 (highlighted)", "default": "Yakka Essential" },
    { "type": "text", "id": "col_2", "label": "Column 2", "default": "Site microwave", "info": "Leave empty to hide the column." },
    { "type": "text", "id": "col_3", "label": "Column 3", "default": "Servo / takeaway", "info": "Leave empty to hide the column." },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "content_alignment", "label": "Heading alignment", "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ] },
    { "type": "range", "id": "table_offset", "label": "Space above table", "min": 16, "max": 96, "step": 4, "unit": "px", "default": 56 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_card", "label": "Table background", "default": "#FFFFFF" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },
    { "type": "color", "id": "color_accent", "label": "Highlight column", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "blocks": [
    { "type": "row", "name": "Row",
      "settings": [
        { "type": "text", "id": "label", "label": "Row label", "default": "Wait time" },
        { "type": "inline_richtext", "id": "value_1", "label": "Column 1 value", "default": "None — it's ready" },
        { "type": "inline_richtext", "id": "value_2", "label": "Column 2 value", "default": "10–20 min queue" },
        { "type": "inline_richtext", "id": "value_3", "label": "Column 3 value", "default": "Drive + queue" }
      ] }
  ],
  "presets": [
    { "name": "Comparison table",
      "blocks": [
        { "type": "row", "settings": { "label": "Wait time", "value_1": "None — it's ready", "value_2": "10–20 min queue", "value_3": "Drive + queue" } },
        { "type": "row", "settings": { "label": "Needs power on site", "value_1": "<strong>No</strong> — fully cordless", "value_2": "Yes", "value_3": "—" } },
        { "type": "row", "settings": { "label": "Cost per week", "value_1": "$0 after purchase", "value_2": "$0", "value_3": "$85–$150" } },
        { "type": "row", "settings": { "label": "Eat your own food", "value_1": "Yes", "value_2": "Yes", "value_3": "No" } },
        { "type": "row", "settings": { "label": "Heats evenly", "value_1": "Yes", "value_2": "Hot edges, cold centre", "value_3": "—" } },
        { "type": "row", "settings": { "label": "Works on a remote site", "value_1": "Yes", "value_2": "No", "value_3": "No" } }
      ] }
  ]
}
{% endschema %}
