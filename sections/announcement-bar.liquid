{%- comment -%}
  Section: announcement-bar
  Dark ticker above the header. One block per message.
  Styles: assets/section-announcement.css
{%- endcomment -%}

{{ 'section-announcement.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{%- if section.blocks.size > 0 -%}
  <div class="yk-announcement" role="region" aria-label="{{ 'sections.announcement.label' | t }}">
    {%- for block in section.blocks -%}
      {%- liquid
        assign item_class = 'yk-announcement__item'
        if block.settings.style == 'live'
          assign item_class = item_class | append: ' yk-announcement__item--live'
        endif
      -%}
      <span class="{{ item_class }}" {{ block.shopify_attributes }}>
        {%- case block.settings.style -%}
          {%- when 'dot' -%}<span class="yk-announcement__dot" aria-hidden="true"></span>
          {%- when 'live' -%}<span aria-hidden="true">●</span>
        {%- endcase -%}

        {%- if block.settings.link != blank -%}
          <a class="yk-announcement__link" href="{{ block.settings.link }}">{{ block.settings.text }}</a>
        {%- else -%}
          {{ block.settings.text }}
        {%- endif -%}
      </span>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "yk-section-announcement",
  "max_blocks": 5,
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Background", "default": "#17150F" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#EDE7DE" },
    { "type": "color", "id": "color_accent", "label": "Marker dot", "default": "#FF8A2B" }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free express shipping AU & NZ" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select", "id": "style", "label": "Marker", "default": "dot",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "dot", "label": "Accent dot" },
            { "value": "live", "label": "Green “in stock” dot" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free express shipping AU & NZ", "style": "dot" } },
        { "type": "message", "settings": { "text": "In stock — ships today", "style": "live" } },
        { "type": "message", "settings": { "text": "60-day money back", "style": "dot" } }
      ]
    }
  ]
}
{% endschema %}
