{%- comment -%}
  Section: contact-form
  Intro copy beside Shopify's native contact form, so submissions reach the
  store inbox with no third-party app.
  Styles: assets/section-contact.css
{%- endcomment -%}

{{ 'section-contact.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-contact-gap: {{ section.settings.column_gap }}px;
  }
{% endstyle %}

{%- assign form_id = 'YkContact-' | append: section.id -%}

<div class="yk-section">
  <div class="yk-page-width">
    <div class="yk-contact">
      <div class="yk-contact__intro">
        {%- if section.settings.eyebrow != blank -%}
          <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="yk-contact__title yk-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="yk-contact__text yk-rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- form 'contact', id: form_id, class: 'yk-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <p class="yk-form-note yk-form-note--success yk-contact__field--full" role="status">
            {{ section.settings.success_text }}
          </p>
        {%- elsif form.errors -%}
          <p class="yk-form-note yk-form-note--error yk-contact__field--full" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {%- endif -%}

        <div>
          <label class="yk-visually-hidden" for="{{ form_id }}-name">{{ 'contact.form.name' | t }}</label>
          <input
            class="yk-field"
            id="{{ form_id }}-name"
            type="text"
            name="contact[name]"
            value="{{ form.name | default: customer.name }}"
            autocomplete="name"
            placeholder="{{ 'contact.form.name' | t }}"
          >
        </div>

        <div>
          <label class="yk-visually-hidden" for="{{ form_id }}-email">{{ 'contact.form.email' | t }}</label>
          <input
            class="yk-field"
            id="{{ form_id }}-email"
            type="email"
            name="contact[email]"
            value="{{ form.email | default: customer.email }}"
            autocomplete="email"
            required
            placeholder="{{ 'contact.form.email' | t }}"
          >
        </div>

        {%- if section.settings.show_phone -%}
          <div class="yk-contact__field--full">
            <label class="yk-visually-hidden" for="{{ form_id }}-phone">{{ 'contact.form.phone' | t }}</label>
            <input
              class="yk-field"
              id="{{ form_id }}-phone"
              type="tel"
              name="contact[phone]"
              value="{{ form.phone }}"
              autocomplete="tel"
              placeholder="{{ section.settings.phone_placeholder }}"
            >
          </div>
        {%- endif -%}

        <div class="yk-contact__field--full">
          <label class="yk-visually-hidden" for="{{ form_id }}-body">{{ 'contact.form.message' | t }}</label>
          <textarea
            class="yk-field"
            id="{{ form_id }}-body"
            name="contact[body]"
            rows="5"
            placeholder="{{ section.settings.message_placeholder }}"
          >{{ form.body }}</textarea>
        </div>

        <div class="yk-contact__field--full">
          <button type="submit" class="yk-btn yk-btn--stack-mobile">{{ section.settings.submit_label }}</button>
        </div>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "yk-section-contact",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions before you buy?" },
    { "type": "richtext", "id": "text", "label": "Body",
      "default": "<p>Our Australian team answers within 24 hours, Monday to Friday, 9:00am – 5:00pm AEST.</p>" },

    { "type": "header", "content": "Form" },
    { "type": "checkbox", "id": "show_phone", "label": "Show phone field", "default": true },
    { "type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "Phone number (optional)" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "How can we help?" },
    { "type": "text", "id": "submit_label", "label": "Submit label", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "Thanks — we'll be in touch within 24 hours." },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 68 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 }
  ],
  "presets": [ { "name": "Contact form" } ]
}
{% endschema %}
