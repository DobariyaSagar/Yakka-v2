<style>
.custom-steps-{{ section.id }} {
  --surface:#FFFFFF;
  --border:#E3DDD4;
  --accent:#E8500F;
  --text:#1A1815;
  --text-2:#6B6660;
  --text-3:#4A4640;
  --max:1180px;
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  -webkit-font-smoothing: antialiased;
  padding: 64px 0;
  background: #F7F4EF;
}
.custom-steps-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
.custom-steps-{{ section.id }} .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

.custom-steps-{{ section.id }} .header {
  position: relative;
  text-align: center;
  margin-bottom: 48px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.custom-steps-{{ section.id }} .eyebrow {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  display: block;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-2);
  margin: 0;
}
.custom-steps-{{ section.id }} h2 {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-weight: 400;
  font-size: 48px;
  color: var(--text);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin: 0;
}

.custom-steps-{{ section.id }} .steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28px;
}
.custom-steps-{{ section.id }} .step {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 32px 28px 30px;
  position: relative;
  overflow: hidden;
  text-align: left;
}
.custom-steps-{{ section.id }} .step .n {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-size: 92px;
  line-height: .78;
  color: var(--accent);
  opacity: .14;
  position: absolute;
  right: 14px;
  top: 6px;
}
.custom-steps-{{ section.id }} .step .tag {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--text-2);
  display: block;
  margin-bottom: 16px;
}
.custom-steps-{{ section.id }} .step h3 {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-size: 28px;
  font-weight: 400;
  color: var(--text);
  margin-bottom: 10px;
  line-height: 1.1;
}
.custom-steps-{{ section.id }} .step p {
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-3);
  margin: 0;
  text-align: left;
}

@media (max-width: 900px) {
  .custom-steps-{{ section.id }} .header {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 36px;
  }
  .custom-steps-{{ section.id }} .eyebrow {
    position: static;
    transform: none;
  }
  .custom-steps-{{ section.id }} h2 {
    font-size: 36px;
    text-align: left;
  }
  .custom-steps-{{ section.id }} .steps {
    grid-template-columns: repeat(2, 1fr);
  }
}
@media (max-width: 600px) {
  .custom-steps-{{ section.id }} .steps {
    grid-template-columns: 1fr;
  }
}
</style>

<div class="custom-steps-{{ section.id }}">
  <div class="wrap">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="header">
        {% if section.settings.subheading != blank %}
          <span class="eyebrow">{{ section.settings.subheading }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
    {% endif %}

    <div class="steps">
      {% for block in section.blocks %}
        <div class="step" {{ block.shopify_attributes }}>
          <span class="n">{{ forloop.index }}</span>
          {% if block.settings.tag != blank %}
            <span class="tag">{{ block.settings.tag }}</span>
          {% endif %}
          {% if block.settings.title != blank %}
            <h3>{{ block.settings.title }}</h3>
          {% endif %}
          {% if block.settings.text != blank %}
            <p>{{ block.settings.text }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Steps",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "4 simple steps to a hot meal."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Prep"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Pack your feed."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Fill the stainless inner with last night's leftovers, soup, or a frozen meal."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Steps",
      "blocks": [
        { "type": "step", "settings": { "tag": "Prep", "title": "Pack your feed.", "text": "Fill the stainless inner with last night's leftovers, soup, or a frozen meal." } },
        { "type": "step", "settings": { "tag": "Go", "title": "Take it anywhere.", "text": "Chuck it in the ute or the toolbox. It's fully sealed, leak-proof, and rugged." } },
        { "type": "step", "settings": { "tag": "Heat", "title": "Press start.", "text": "Hit the button an hour before smoko. No cords, no finding a plug." } },
        { "type": "step", "settings": { "tag": "Eat", "title": "Proper hot food.", "text": "Enjoy a steaming hot meal right where you're working, no queue required." } }
      ]
    }
  ]
}
{% endschema %}
