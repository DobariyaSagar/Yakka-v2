<style>
.custom-image-text-{{ section.id }} {
  --text: #1A1815;
  --text-2: #6B6660;
  --text-3: #4A4640;
  --border: #E3DDD4;
  --max: 1180px;
  font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  -webkit-font-smoothing: antialiased;
  padding: {{ section.settings.padding_y }}px 0;
  background: {{ section.settings.bg_color }};
}
.custom-image-text-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
.custom-image-text-{{ section.id }} .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }

.custom-image-text-{{ section.id }} .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 64px;
  align-items: center;
}
/* Reversing the grid order */
.custom-image-text-{{ section.id }} .grid.reverse .image-col {
  order: -1;
}

.custom-image-text-{{ section.id }} .text-col {
  padding-right: 20px;
}
.custom-image-text-{{ section.id }} .grid.reverse .text-col {
  padding-right: 0;
  padding-left: 20px;
}

.custom-image-text-{{ section.id }} .eyebrow {
  display: block;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: var(--text-2);
  margin-bottom: 12px;
}
.custom-image-text-{{ section.id }} h2 {
  font-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
  font-weight: 400;
  font-size: 44px;
  color: var(--text);
  letter-spacing: -.02em;
  line-height: 1.1;
  margin-bottom: 24px;
}
.custom-image-text-{{ section.id }} .lede {
  font-size: 16px;
  line-height: 1.6;
  color: var(--text-3);
  margin-bottom: 32px;
}

.custom-image-text-{{ section.id }} .list-items {
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}
.custom-image-text-{{ section.id }} .list-item {
  padding: 18px 0;
  font-size: 15px;
  line-height: 1.6;
  color: var(--text-3);
}
.custom-image-text-{{ section.id }} .list-item + .list-item {
  border-top: 1px solid var(--border);
}
.custom-image-text-{{ section.id }} .list-item strong {
  color: var(--text);
  font-weight: 600;
}

.custom-image-text-{{ section.id }} .image-col img {
  width: 100%;
  {% if section.settings.image_height_auto %}
  aspect-ratio: auto;
  height: auto;
  {% else %}
  aspect-ratio: 1 / 0.85;
  {% endif %}
  object-fit: cover;
  border-radius: 16px;
  display: block;
}

@media (max-width: 900px) {
  .custom-image-text-{{ section.id }} .grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .custom-image-text-{{ section.id }} .grid .image-col {
    order: -1; /* Always image on top on mobile */
  }
  .custom-image-text-{{ section.id }} .text-col,
  .custom-image-text-{{ section.id }} .grid.reverse .text-col {
    padding-left: 0;
    padding-right: 0;
  }
  .custom-image-text-{{ section.id }} h2 {
    font-size: 36px;
  }
}
@media (max-width: 600px) {
  .custom-image-text-{{ section.id }} h2 {
    font-size: 32px;
  }
}
</style>

<div class="custom-image-text-{{ section.id }}">
  <div class="wrap">
    <div class="grid {% if section.settings.layout == 'image_left' %}reverse{% endif %}">
      
      <div class="text-col">
        {% if section.settings.eyebrow != blank %}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.lede != blank %}
          <p class="lede">{{ section.settings.lede }}</p>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="list-items">
            {% for block in section.blocks %}
              <div class="list-item" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}
                  <strong>{{ block.settings.title }}</strong>
                {% endif %}
                {% if block.settings.text != blank %}
                  {{ block.settings.text }}
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="image-col">
        {% if section.settings.image != blank %}
          <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="{{ section.settings.image.alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {% else %}
          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Image with Text",
  "settings": [
    {
      "type": "color_background",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F7F4EF"
    },
    {
      "type": "range",
      "id": "padding_y",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Vertical Padding",
      "default": 64
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop Layout",
      "options": [
        {
          "value": "image_right",
          "label": "Image on right"
        },
        {
          "value": "image_left",
          "label": "Image on left"
        }
      ],
      "default": "image_right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FROM THE SHED TO THE SITE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Keep every meal hot."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Text",
      "default": "Yakka Essential was built for the way Australians actually work — long drives, no kitchen, and a lunch break that's over before the queue moves. It's the simplest possible fix: charge it, pack it, eat properly."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "image_height_auto",
      "label": "Adapt to image",
      "info": "Use original image proportions instead of cropping.",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "list_item",
      "name": "List Item",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title (Bold)",
          "default": "Zero waiting."
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Your break is short enough. Skip the queue and eat the moment you sit down."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Image with Text",
      "blocks": [
        {
          "type": "list_item",
          "settings": {
            "title": "Zero waiting.",
            "text": "Your break is short enough. Skip the queue and eat the moment you sit down."
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Completely cordless.",
            "text": "No outlet, no inverter, no gennie. It runs off its own battery."
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Even-heat technology.",
            "text": "No hot centre and burnt edges — just perfectly hot food, every time."
          }
        },
        {
          "type": "list_item",
          "settings": {
            "title": "Built for big appetites.",
            "text": "1.5L capacity designed to hold a proper, energy-packed feed."
          }
        }
      ]
    }
  ]
}
{% endschema %}
