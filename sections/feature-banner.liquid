{%- comment -%}
  Section: feature-banner — gradient card, copy beside an image.
  Styles: assets/section-feature.css
{%- endcomment -%}

{{ 'section-feature.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-feature-bg: linear-gradient({{ section.settings.gradient_angle }}deg,
      {{ section.settings.gradient_start }} 0%,
      {{ section.settings.gradient_mid }} 52%,
      {{ section.settings.gradient_end }} 100%);
    --yk-feature-gap: {{ section.settings.column_gap }}px;
    --yk-feature-pad: {{ section.settings.card_padding }}px;
    --yk-feature-pad-x: {{ section.settings.card_padding_x }}px;
    --yk-feature-ratio: {{ section.settings.image_ratio }};
  }
{% endstyle %}

{%- liquid
  assign feature_class = 'yk-feature'
  if section.settings.media_position == 'left'
    assign feature_class = feature_class | append: ' yk-feature--media-first'
  endif
-%}

<div class="yk-section">
  <div class="yk-page-width">
    <div class="{{ feature_class }}">
      <div class="yk-feature__content">
        {%- if section.settings.eyebrow != blank -%}
          <span class="yk-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="yk-feature__title yk-section__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="yk-feature__text yk-rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank -%}
          <div class="yk-feature__actions">
            <a class="yk-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
              {{ section.settings.cta_label }}
            </a>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            class: 'yk-feature__image',
            widths: '400,600,800,1000',
            sizes: '(max-width: 989px) 88vw, 44vw',
            alt: section.settings.image.alt | default: section.settings.heading,
            loading: 'lazy',
            decoding: 'async'
        }}
      {%- else -%}
        <img class="yk-feature__image" src="{{ 'yakka-product.jpg' | asset_url }}"
             alt="" width="900" height="720" loading="lazy" decoding="async">
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Feature banner",
  "tag": "section",
  "class": "yk-section-feature",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Tuckerbox™" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Say goodbye to cold sandwiches and site microwave queues." },
    { "type": "richtext", "id": "text", "label": "Body",
      "default": "<p>Pack it the night before. Press start an hour out from smoko. Sealed, leak-proof and rugged enough to live in the toolbox — it heats your own food properly, instead of keeping someone else's lukewarm.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "cta_label", "label": "Button label" },
    { "type": "url", "id": "cta_link", "label": "Button link" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "media_position", "label": "Image position", "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "4/3.2",
      "options": [
        { "value": "4/3.2", "label": "Landscape" },
        { "value": "1/1", "label": "Square" },
        { "value": "16/9", "label": "Wide" }
      ] },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 52 },
    { "type": "range", "id": "card_padding", "label": "Card padding (vertical)", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "card_padding_x", "label": "Card padding (horizontal)", "min": 16, "max": 120, "step": 4, "unit": "px", "default": 64 },

    { "type": "header", "content": "Card gradient" },
    { "type": "color", "id": "gradient_start", "label": "Start", "default": "#FCEFE7" },
    { "type": "color", "id": "gradient_mid", "label": "Middle", "default": "#F4E4D6" },
    { "type": "color", "id": "gradient_end", "label": "End", "default": "#EBD9C7" },
    { "type": "range", "id": "gradient_angle", "label": "Angle", "min": 0, "max": 360, "step": 5, "unit": "deg", "default": 150 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Section background" },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_eyebrow", "label": "Eyebrow" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 20, "max": 48, "step": 1, "unit": "px", "default": 32 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 150 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 0 }
  ],
  "presets": [ { "name": "Feature banner" } ]
}
{% endschema %}
