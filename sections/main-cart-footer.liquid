{%- comment -%}
  Section: main-cart-footer
  Order note, discounts, subtotal and checkout. Re-rendered by yk-cart.js
  whenever a line changes.
  Styles: assets/section-cart.css
{%- endcomment -%}

{{ 'section-cart.css' | asset_url | stylesheet_tag }}
{% render 'yk-section-style', section: section %}

<div
  class="yk-section"
  id="YkCartFooter-{{ section.id }}"
  data-yk-cart-footer
  data-yk-section-id="{{ section.id }}"
  {% if cart.item_count == 0 %}hidden{% endif %}
>
  <div class="yk-page-width">
    <div class="yk-cart-footer">
      {%- if section.settings.show_cart_note -%}
        <div class="yk-cart-footer__note">
          <label class="yk-eyebrow" for="YkCartNote">{{ 'cart.general.note' | t }}</label>
          <textarea
            class="yk-field"
            id="YkCartNote"
            name="note"
            form="YkCartNoteForm"
            rows="4"
            placeholder="{{ 'cart.general.note_placeholder' | t }}"
            data-yk-cart-note
          >{{ cart.note }}</textarea>
          <form id="YkCartNoteForm" action="{{ routes.cart_update_url }}" method="post" hidden></form>
        </div>
      {%- endif -%}

      <div class="yk-cart-footer__totals">
        {%- if cart.cart_level_discount_applications.size > 0 -%}
          <ul class="yk-cart-footer__discounts">
            {%- for discount in cart.cart_level_discount_applications -%}
              <li>
                <span>{{ discount.title }}</span>
                <span>−{% render 'yk-price', price: discount.total_allocated_amount %}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="yk-cart-footer__row">
          <span>{{ 'cart.general.subtotal' | t }}</span>
          <span class="yk-cart-footer__subtotal" data-yk-cart-subtotal>
            {% render 'yk-price', price: cart.total_price %}
          </span>
        </div>

        <p class="yk-cart-footer__tax">{{ 'cart.general.taxes_and_shipping' | t }}</p>

        <form action="{{ routes.cart_url }}" method="post" novalidate>
          <button type="submit" name="checkout" class="yk-btn yk-btn--full" {% if cart.item_count == 0 %}disabled{% endif %}>
            {{ 'cart.general.checkout' | t }}
          </button>
        </form>

        {%- if additional_checkout_buttons and section.settings.show_dynamic_checkout -%}
          <div class="yk-cart-footer__express">{{ content_for_additional_checkout_buttons }}</div>
        {%- endif -%}

        <a class="yk-cart-footer__continue" href="{{ routes.all_products_collection_url }}">
          {{ 'cart.general.continue_shopping' | t }}
        </a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Cart footer",
  "tag": "section",
  "class": "yk-section-cart-footer",
  "settings": [
    { "type": "checkbox", "id": "show_cart_note", "label": "Enable order note", "default": true },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show express checkout buttons", "default": true },

    { "type": "header", "content": "Colours" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 56 }
  ]
}
{% endschema %}
