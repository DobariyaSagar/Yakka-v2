{%- comment -%}
  Section: hero-product
  Copy + CTAs beside an image carrying floating stat chips.
  Blocks: chip (max 2), trust (max 4).
  Styles: assets/section-hero.css
{%- endcomment -%}

{{ 'section-hero.css' | asset_url | stylesheet_tag: preload: true }}

{%- comment -%} The hero image is the LCP element on the homepage — preload it. {%- endcomment -%}
{%- if section.settings.image != blank -%}
  {{ section.settings.image | image_url: width: 1200 | preload_tag: as: 'image' }}
{%- endif -%}
{% render 'yk-section-style', section: section %}

{% style %}
  #shopify-section-{{ section.id }}{
    --yk-hero-gap: {{ section.settings.column_gap }}px;
    --yk-hero-lede: {{ section.settings.subheading_size }}px;
    --yk-hero-ratio: {{ section.settings.image_ratio }};
  }
{% endstyle %}

{%- liquid
  assign hero_class = 'yk-hero'
  if section.settings.media_position == 'left'
    assign hero_class = hero_class | append: ' yk-hero--media-first'
  endif

  assign chips = section.blocks | where: 'type', 'chip'
  assign trust_items = section.blocks | where: 'type', 'trust'
-%}

<div class="yk-section">
  <div class="yk-page-width">
    <div class="{{ hero_class }}">

      <div class="yk-hero__content">
        {%- if section.settings.show_stock_badge and section.settings.stock_text != blank -%}
          <span class="yk-badge-stock">
            <span class="yk-badge-stock__dot" aria-hidden="true"></span>
            {{ section.settings.stock_text }}
          </span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="yk-hero__title yk-section__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="yk-hero__lede">{{ section.settings.subheading }}</p>
        {%- endif -%}

        {%- if section.settings.show_rating -%}
          <div class="yk-rating yk-hero__rating">
            <span class="yk-rating__stars" aria-hidden="true">★★★★★</span>
            <b class="yk-rating__score">{{ section.settings.rating_score }}</b>
            <span>{{ section.settings.rating_text }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.cta_label != blank or section.settings.cta2_label != blank -%}
          <div class="yk-hero__actions">
            {%- if section.settings.cta_label != blank -%}
              <a class="yk-btn" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">
                {{ section.settings.cta_label }}
              </a>
            {%- endif -%}
            {%- if section.settings.cta2_label != blank -%}
              <a class="yk-btn yk-btn--ghost" href="{{ section.settings.cta2_link | default: '#' }}">
                {{ section.settings.cta2_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if trust_items.size > 0 -%}
          <div class="yk-hero__trust">
            {%- for block in trust_items -%}
              <span {{ block.shopify_attributes }}>◦ {{ block.settings.text }}</span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="yk-hero__media">
        {%- for block in chips -%}
          <div class="yk-chip yk-chip--{{ block.settings.position }}" {{ block.shopify_attributes }}>
            <b class="yk-chip__value">{{ block.settings.value }}</b>
            <span class="yk-chip__label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}

        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              class: 'yk-hero__image',
              widths: '400,600,800,1000,1200',
              sizes: '(max-width: 989px) 92vw, 46vw',
              alt: section.settings.image.alt | default: section.settings.heading | strip_html,
              loading: 'eager',
              fetchpriority: 'high'
          }}
        {%- else -%}
          <img
            class="yk-hero__image"
            src="{{ 'yakka-hero.jpg' | asset_url }}"
            alt="{{ section.settings.heading | strip_html | escape }}"
            width="1000"
            height="1240"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero — product",
  "tag": "section",
  "class": "yk-section-hero",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading",
      "default": "Hot food.<br>No microwave.<br><em>No queue.</em>",
      "info": "<em> colours a phrase with the accent, <br> breaks the line." },
    { "type": "textarea", "id": "subheading", "label": "Subheading",
      "default": "Charge it overnight, pack it in the morning, press start before smoko. The Yakka Essential is completely cordless — a proper hot feed anywhere the job takes you." },
    { "type": "image_picker", "id": "image", "label": "Image" },

    { "type": "header", "content": "Stock badge" },
    { "type": "checkbox", "id": "show_stock_badge", "label": "Show badge", "default": true },
    { "type": "text", "id": "stock_text", "label": "Badge text", "default": "In stock — ships today" },

    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_rating", "label": "Show rating", "default": true },
    { "type": "text", "id": "rating_score", "label": "Score", "default": "4.8" },
    { "type": "text", "id": "rating_text", "label": "Caption", "default": "from 1,200+ verified Aussie tradies" },

    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "cta_label", "label": "Primary label", "default": "Shop the Lunchbox" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary label", "default": "See how it works" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },

    { "type": "header", "content": "Layout" },
    { "type": "select", "id": "media_position", "label": "Image position", "default": "right",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ] },
    { "type": "select", "id": "image_ratio", "label": "Image ratio", "default": "1/1.24",
      "options": [
        { "value": "1/1.24", "label": "Portrait" },
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" }
      ] },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 96, "step": 4, "unit": "px", "default": 56 },

    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_background", "label": "Background",
      "info": "Leave empty to inherit the page background." },
    { "type": "color", "id": "color_heading", "label": "Heading" },
    { "type": "color", "id": "color_text", "label": "Body text" },
    { "type": "color", "id": "color_accent", "label": "Accent", "default": "#E8500F" },

    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 40, "max": 120, "step": 2, "unit": "px", "default": 88 },
    { "type": "range", "id": "heading_size_mobile", "label": "Heading size (mobile)", "min": 24, "max": 64, "step": 1, "unit": "px", "default": 40 },
    { "type": "range", "id": "subheading_size", "label": "Subheading size", "min": 14, "max": 26, "step": 1, "unit": "px", "default": 20 },

    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 88 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Bottom padding (mobile)", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 48 }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Image chip",
      "limit": 2,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "45 min" },
        { "type": "text", "id": "label", "label": "Label", "default": "Pack to piping hot" },
        { "type": "select", "id": "position", "label": "Position", "default": "top-left",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "bottom-right", "label": "Bottom right" }
          ] }
      ]
    },
    {
      "type": "trust",
      "name": "Trust line",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free express shipping" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — product",
      "blocks": [
        { "type": "chip", "settings": { "value": "45 min", "label": "Pack to piping hot", "position": "top-left" } },
        { "type": "chip", "settings": { "value": "100%", "label": "Cordless — no outlet", "position": "bottom-right" } },
        { "type": "trust", "settings": { "text": "Free express shipping" } },
        { "type": "trust", "settings": { "text": "60-day money back" } },
        { "type": "trust", "settings": { "text": "AU & NZ support" } }
      ]
    }
  ]
}
{% endschema %}
