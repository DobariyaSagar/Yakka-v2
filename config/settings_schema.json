[
  {
    "name": "theme_info",
    "theme_name": "Yakka — Ignition",
    "theme_version": "2.0.0",
    "theme_author": "Yakka",
    "theme_documentation_url": "https://shopify.dev/docs/themes",
    "theme_support_url": "https://help.shopify.com"
  },

  {
    "name": "Colors",
    "settings": [
      {
        "type": "color_scheme_group",
        "id": "color_schemes",
        "definition": [
          { "type": "color", "id": "background", "label": "Background", "default": "#F7F4EF" },
          { "type": "color_background", "id": "background_gradient", "label": "Background gradient",
            "info": "Replaces the background colour where set." },
          { "type": "color", "id": "text", "label": "Text", "default": "#4A4640" },
          { "type": "color", "id": "heading", "label": "Heading", "default": "#1A1815" },
          { "type": "color", "id": "border", "label": "Border", "default": "#E3DDD4" },
          { "type": "color", "id": "card", "label": "Card background", "default": "#FFFFFF" },
          { "type": "color", "id": "button", "label": "Solid button background", "default": "#E8500F" },
          { "type": "color", "id": "button_label", "label": "Solid button label", "default": "#FFFFFF" },
          { "type": "color", "id": "secondary_button_label", "label": "Outline button label", "default": "#1A1815" },
          { "type": "color", "id": "shadow", "label": "Shadow", "default": "#1A1815" }
        ],
        "role": {
          "background": { "solid": "background", "gradient": "background_gradient" },
          "text": "text",
          "shadow": "shadow",
          "border": "border",
          "icons": "heading",
          "primary_button": "button",
          "on_primary_button": "button_label",
          "primary_button_border": "button",
          "secondary_button": "background",
          "secondary_button_border": "secondary_button_label",
          "on_secondary_button": "secondary_button_label"
        }
      }
    ]
  },

  {
    "name": "Typography",
    "settings": [
      { "type": "header", "content": "Headings" },
      { "type": "checkbox", "id": "type_header_use_theme_font", "label": "Use the theme serif (Instrument Serif)", "default": true },
      { "type": "font_picker", "id": "type_header_font", "label": "Font", "default": "assistant_n4",
        "info": "Used when the checkbox above is off." },
      { "type": "range", "id": "heading_scale", "label": "Heading scale", "min": 80, "max": 130, "step": 5, "unit": "%", "default": 100 },

      { "type": "header", "content": "Body" },
      { "type": "checkbox", "id": "type_body_use_theme_font", "label": "Use the theme sans (Inter)", "default": true },
      { "type": "font_picker", "id": "type_body_font", "label": "Font", "default": "assistant_n4",
        "info": "Used when the checkbox above is off." },
      { "type": "range", "id": "body_font_size", "label": "Base font size", "min": 14, "max": 20, "step": 1, "unit": "px", "default": 18 }
    ]
  },

  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1000, "max": 1600, "step": 20, "unit": "px", "default": 1180 },
      { "type": "range", "id": "page_gutter", "label": "Page side padding", "min": 12, "max": 48, "step": 2, "unit": "px", "default": 24 },
      { "type": "range", "id": "spacing_sections", "label": "Space between sections", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0,
        "info": "Added on top of each section's own padding." },
      { "type": "range", "id": "spacing_grid_horizontal", "label": "Horizontal grid spacing", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 28 },
      { "type": "range", "id": "spacing_grid_vertical", "label": "Vertical grid spacing", "min": 4, "max": 48, "step": 2, "unit": "px", "default": 28 }
    ]
  },

  {
    "name": "Animations",
    "settings": [
      { "type": "checkbox", "id": "animations_reveal_on_scroll", "label": "Reveal sections on scroll", "default": false },
      { "type": "select", "id": "animations_hover_elements", "label": "Hover effect", "default": "lift",
        "info": "Cards, buttons and images. Pointer devices only.",
        "options": [
          { "value": "none", "label": "None" },
          { "value": "lift", "label": "Lift" }
        ] }
    ]
  },

  {
    "name": "Buttons",
    "settings": [
      { "type": "range", "id": "buttons_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 5 },
      { "type": "range", "id": "buttons_border_thickness", "label": "Border thickness", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
      { "type": "range", "id": "buttons_shadow_opacity", "label": "Shadow opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 55 },
      { "type": "range", "id": "buttons_height", "label": "Height", "min": 44, "max": 76, "step": 2, "unit": "px", "default": 60 }
    ]
  },

  {
    "name": "Inputs",
    "settings": [
      { "type": "range", "id": "inputs_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 5 },
      { "type": "range", "id": "inputs_border_thickness", "label": "Border thickness", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
      { "type": "range", "id": "inputs_height", "label": "Height", "min": 44, "max": 72, "step": 2, "unit": "px", "default": 58 }
    ]
  },

  {
    "name": "Cards",
    "settings": [
      { "type": "range", "id": "card_corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 14 },
      { "type": "range", "id": "card_border_thickness", "label": "Border thickness", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
      { "type": "range", "id": "card_shadow_opacity", "label": "Shadow opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 }
    ]
  },

  {
    "name": "Badges",
    "settings": [
      { "type": "range", "id": "badge_corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 4 }
    ]
  },

  {
    "name": "Media",
    "settings": [
      { "type": "range", "id": "media_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
      { "type": "range", "id": "media_shadow_opacity", "label": "Shadow opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0 }
    ]
  },

  {
    "name": "Brand information",
    "settings": [
      { "type": "paragraph", "content": "Used by the footer brand block." },
      { "type": "image_picker", "id": "brand_image", "label": "Logo" },
      { "type": "range", "id": "brand_image_width", "label": "Logo width", "min": 40, "max": 240, "step": 10, "unit": "px", "default": 140 },
      { "type": "inline_richtext", "id": "brand_headline", "label": "Headline", "default": "Yakka Essential" },
      { "type": "richtext", "id": "brand_description", "label": "Description",
        "default": "<p>Practical gear for hard-working Australians. Built for work, travel, home and everyday life.</p>" }
    ]
  },

  {
    "name": "Social media",
    "settings": [
      { "type": "paragraph", "content": "Add a “Social links” block to the footer to show these." },
      { "type": "url", "id": "social_instagram_link", "label": "Instagram" },
      { "type": "url", "id": "social_facebook_link", "label": "Facebook" },
      { "type": "url", "id": "social_tiktok_link", "label": "TikTok" },
      { "type": "url", "id": "social_youtube_link", "label": "YouTube" },
      { "type": "url", "id": "social_x_link", "label": "X" },
      { "type": "url", "id": "social_pinterest_link", "label": "Pinterest" },
      { "type": "url", "id": "social_linkedin_link", "label": "LinkedIn" }
    ]
  },

  {
    "name": "Currency format",
    "settings": [
      { "type": "paragraph", "content": "Cart and checkout always show currency codes." },
      { "type": "checkbox", "id": "currency_code_enabled", "label": "Show currency codes in prices", "default": false }
    ]
  },

  {
    "name": "Favicon",
    "settings": [
      { "type": "image_picker", "id": "favicon", "label": "Favicon image", "info": "32 × 32px .png" }
    ]
  }
]
